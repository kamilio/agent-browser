+++ b/packages/safe-js/src/host-constructor.ts
@@ -0,0 +1,71 @@
+import { types as nodeTypes } from "node:util";
+
+import { type HostObject, hostObjectDefinition } from "./host-object.js";
+
+declare const hostConstructorType: unique symbol;
+
+export type HostConstructor = ((...args: readonly unknown[]) => never) & {
+  readonly [hostConstructorType]: true;
+};
+
+type Definition = {
+  readonly name: string;
+  readonly construct: (...args: readonly unknown[]) => HostObject;
+};
+
+const definitions = new WeakMap<object, Definition>();
+const guestConstructors = new WeakSet<object>();
+const promiseThen = Promise.prototype.then;
+
+export function createHostConstructor(
+  name: string,
+  construct: (...args: readonly unknown[]) => HostObject
+): HostConstructor {
+  if (typeof name !== "string" || name.length === 0 || name.length > 1024)
+    throw new TypeError("Host constructor names require 1 to 1024 code units.");
+  if (
+    typeof construct !== "function" ||
+    nodeTypes.isProxy(construct) ||
+    nodeTypes.isAsyncFunction(construct) ||
+    nodeTypes.isGeneratorFunction(construct)
+  )
+    throw new TypeError("Host constructors require a synchronous non-proxy callback.");
+  const capability = ((..._args: readonly unknown[]): never => {
+    throw new TypeError("Host constructors require guest construction in a persistent realm.");
+  }) as HostConstructor;
+  Object.defineProperty(capability, "name", { value: name, configurable: false });
+  definitions.set(
+    capability,
+    Object.freeze({
+      name,
+      construct: (...args: readonly unknown[]) => {
+        const result = Reflect.apply(construct, undefined, args);
+        if (hostObjectDefinition(result) === undefined) {
+          if (nodeTypes.isPromise(result)) {
+            try {
+              Reflect.apply(promiseThen, result, [undefined, () => undefined]);
+            } catch {}
+          }
+          throw new TypeError("Host constructors must synchronously return a live host object.");
+        }
+        return result;
+      }
+    })
+  );
+  return Object.freeze(capability);
+}
+
+export function hostConstructorDefinition(value: unknown): Definition | undefined {
+  return typeof value === "function" ? definitions.get(value) : undefined;
+}
+
+export function registerHostConstructorClosure(value: object): void {
+  guestConstructors.add(value);
+}
+
+export function isHostConstructorCapability(value: unknown): boolean {
+  return (
+    ((typeof value === "object" && value !== null) || typeof value === "function") &&
+    (definitions.has(value) || guestConstructors.has(value))
+  );
+}
