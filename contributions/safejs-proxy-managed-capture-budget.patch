--- /dev/null
+++ b/src/interp/proxy-managed-capture-budget.test.ts
@@ -0,0 +1,30 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import { markDescriptorObject } from "./object-model.js";
+import { reconcileCompiledValues } from "./values.js";
+
+it("rejects hidden data when descriptor capture registers managed accounting", () => {
+	const target = Object.defineProperty({}, "hidden", {
+		value: "x".repeat(101),
+	});
+	Object.defineProperty(target, "visible", {
+		value: undefined,
+		enumerable: true,
+	});
+	const reads: PropertyKey[] = [];
+	const value = new Proxy(target, {
+		getOwnPropertyDescriptor(owner, key) {
+			reads.push(key);
+			if (key === "visible") markDescriptorObject(value);
+			return Reflect.getOwnPropertyDescriptor(owner, key);
+		},
+	});
+	const budget = new Budget({ dataSize: 100 });
+	expect(() => reconcileCompiledValues(budget, [value])).toThrow(
+		expect.objectContaining({ code: "budgetExceeded", budget: "dataSize" }),
+	);
+	expect(reads.filter((key) => typeof key === "string")).toEqual([
+		"hidden",
+		"visible",
+	]);
+});
