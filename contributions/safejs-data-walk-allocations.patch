diff --git a/packages/safe-js/src/interp/indexed-data-walk.test.ts b/packages/safe-js/src/interp/indexed-data-walk.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/indexed-data-walk.test.ts
@@ -0,0 +1,32 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import {
+  createSandboxClosure,
+  measureSandboxData,
+  reconcileCompiledValues,
+} from "./values.js";
+
+it("uses a callback-provided array's iterator when measuring retained data", () => {
+  let reads = 0;
+  const roots = ["decoy"];
+  Object.defineProperty(roots, Symbol.iterator, {
+    get() {
+      reads++;
+      return function* () {
+        yield "x".repeat(101);
+      };
+    },
+  });
+  const closure = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => roots,
+  });
+  expect(measureSandboxData([closure])).toBe(102);
+  expect(reads).toBe(1);
+  expect(() =>
+    reconcileCompiledValues(new Budget({ dataSize: 100 }), [closure]),
+  ).toThrow(
+    expect.objectContaining({ code: "budgetExceeded", budget: "dataSize" }),
+  );
+  expect(reads).toBe(2);
+});
