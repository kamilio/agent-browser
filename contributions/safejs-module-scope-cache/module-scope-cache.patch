--- a/packages/safe-js/src/modules/empty-environment.ts
+++ b/packages/safe-js/src/modules/empty-environment.ts
@@ -1,3 +1,13 @@
 import type { ModuleEnvironment } from "./registry.js";
 
 export const immutableEmptyModuleEnvironments = new WeakSet<ModuleEnvironment>();
+export const ownedModuleNamespaces = new WeakMap<ModuleEnvironment, object>();
+
+export function hasEmptyOwnedModuleEnvironment(environment: ModuleEnvironment): boolean {
+  const namespaces = ownedModuleNamespaces.get(environment);
+  if (namespaces === undefined) return false;
+  if (Object.getOwnPropertyDescriptor(environment, "namespaces")?.value === namespaces &&
+      Object.keys(namespaces).length === 0) return true;
+  ownedModuleNamespaces.delete(environment);
+  return false;
+}
