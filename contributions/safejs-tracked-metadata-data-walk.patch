diff --git a/src/interp/tracked-metadata-data-walk.test.ts b/src/interp/tracked-metadata-data-walk.test.ts
new file mode 100644
--- /dev/null
+++ b/src/interp/tracked-metadata-data-walk.test.ts
@@ -0,0 +1,213 @@
+import { expect, it } from "vitest";
+import { MAX_DATA_DEPTH } from "../graph-depth.js";
+import { Budget } from "./budget.js";
+import { internalSymbols } from "./internal-symbols.js";
+import { createIntrinsicObject, setSandboxPrototype } from "./object-model.js";
+import { addPrivateElement } from "./private-state.js";
+import {
+  createSandboxClosure,
+  measureSandboxData,
+  reconcileCompiledValues,
+  type SandboxValue,
+} from "./values.js";
+
+function chain(depth: number, privateField: boolean): object {
+  let root = createIntrinsicObject();
+  const key = Symbol("next");
+  const name = { description: "next" };
+  for (let index = 0; index < depth; index++) {
+    const parent = createIntrinsicObject();
+    if (privateField)
+      addPrivateElement(parent, name, { kind: "field", value: root });
+    else Object.defineProperty(parent, key, { value: root, enumerable: true });
+    root = parent;
+  }
+  return root;
+}
+
+it.each([false, true])(
+  "measures deep tracked metadata on the default stack (private=%s)",
+  (privateField) => {
+    expect(measureSandboxData([chain(MAX_DATA_DEPTH, privateField)])).toBe(
+      privateField ? MAX_DATA_DEPTH + 18 : MAX_DATA_DEPTH * 2 + 6,
+    );
+  },
+);
+it.each([false, true])(
+  "rejects excessive tracked metadata with dataDepth (private=%s)",
+  (privateField) => {
+    expect(() =>
+      measureSandboxData([chain(MAX_DATA_DEPTH + 1, privateField)]),
+    ).toThrow(
+      expect.objectContaining({
+        code: "budgetExceeded",
+        budget: "dataDepth",
+        current: MAX_DATA_DEPTH + 1,
+      }),
+    );
+  },
+);
+
+function wrap(root: SandboxValue): SandboxValue {
+  for (let index = 0; index < 140; index++)
+    root = createIntrinsicObject({ next: root });
+  return root;
+}
+
+it("keeps primary limits active during held deep metadata reconciliation", () => {
+  const budget = new Budget({ dataSize: 1000 });
+  const release = budget.deferReconciliation();
+  try {
+    expect(() =>
+      reconcileCompiledValues(budget, [chain(MAX_DATA_DEPTH, false)]),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  } finally {
+    release();
+  }
+});
+
+it("resumes prototype and string inspection after metadata callbacks", () => {
+  const events: string[] = [];
+  const first = Symbol("first"),
+    later = Symbol("later");
+  const table = createIntrinsicObject({ text: "a" });
+  table[first] = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      events.push("symbol");
+      table[later] = "longer";
+      table.text = "changed";
+      return [];
+    },
+  });
+  table[later] = "a";
+  const prototype = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      events.push("prototype");
+      table.text = "from prototype";
+      return [];
+    },
+  });
+  setSandboxPrototype(table, prototype);
+  const root = wrap(table);
+  const initial = measureSandboxData([root]);
+  expect(events).toEqual(["symbol", "prototype"]);
+  expect(table.text).toBe("from prototype");
+  expect(measureSandboxData([root])).toBe(initial + 5);
+  expect(events).toEqual(["symbol", "prototype", "symbol", "prototype"]);
+});
+
+it("observes live private iterator insertion before capturing symbols", () => {
+  const table = createIntrinsicObject();
+  const symbol = Symbol("after");
+  let added = false;
+  const events: string[] = [];
+  const inserted = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      events.push("inserted");
+      return [];
+    },
+  });
+  const first = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      events.push("first");
+      if (!added) {
+        addPrivateElement(
+          table,
+          { description: "inserted" },
+          { kind: "field", value: inserted },
+        );
+        added = true;
+      }
+      table[symbol] = "changed";
+      return [];
+    },
+  });
+  addPrivateElement(
+    table,
+    { description: "first" },
+    { kind: "field", value: first },
+  );
+  table[symbol] = "a";
+  const root = wrap(table);
+  const usage = measureSandboxData([root]);
+  expect(events).toEqual(["first", "inserted"]);
+  expect(measureSandboxData([root])).toBe(usage);
+});
+
+it("checks symbol catalogue changes between suspended descendants", () => {
+  const table = createIntrinsicObject();
+  const first = Symbol("first"),
+    later = Symbol("later");
+  table[first] = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      internalSymbols.add(later);
+      return [];
+    },
+  });
+  table[later] = "x".repeat(1000);
+  const root = wrap(table);
+  try {
+    const usage = measureSandboxData([root]);
+    delete table[later];
+    expect(measureSandboxData([root])).toBe(usage);
+  } finally {
+    internalSymbols.delete(later);
+  }
+});
+
+it("closes suspended captures when deep metadata fails", () => {
+  const failure = new Error("metadata failure");
+  const events: string[] = [];
+  const table = createIntrinsicObject();
+  table[Symbol("leaf")] = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      throw failure;
+    },
+  });
+  let root: SandboxValue = table;
+  for (const name of ["inner", "outer"]) {
+    const next = root;
+    root = createSandboxClosure({
+      call: () => undefined,
+      retainedValues: function* () {
+        events.push("open-" + name);
+        try {
+          yield next;
+        } finally {
+          events.push("close-" + name);
+        }
+      },
+    });
+  }
+  expect(() => measureSandboxData([wrap(root)])).toThrow(failure);
+  expect(events).toEqual([
+    "open-outer",
+    "open-inner",
+    "close-inner",
+    "close-outer",
+  ]);
+});
+
+it("continues tracked prototypes off the stack at the depth boundary", () => {
+  let root = createIntrinsicObject();
+  for (let index = 0; index < MAX_DATA_DEPTH; index++) {
+    const parent = createIntrinsicObject();
+    setSandboxPrototype(parent, root);
+    root = parent;
+  }
+  expect(measureSandboxData([root])).toBe(MAX_DATA_DEPTH + 1);
+  const parent = createIntrinsicObject();
+  setSandboxPrototype(parent, root);
+  expect(() => measureSandboxData([parent])).toThrow(
+    expect.objectContaining({
+      budget: "dataDepth",
+      current: MAX_DATA_DEPTH + 1,
+    }),
+  );
+});
