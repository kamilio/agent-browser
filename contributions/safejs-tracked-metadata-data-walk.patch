+  // Only deep SDK-owned tables take this path. Leave shallow/foreign hot paths
+  // unchanged, and suspend live private iterators rather than snapshotting them.
+  function* trackedMetadataValues(value: object): Generator<unknown, void> {
+    const privateSlots = privateElements.get(value);
+    if (privateSlots !== undefined) {
