diff --git a/packages/safe-js/src/interp/tracked-object-string-data.test.ts b/packages/safe-js/src/interp/tracked-object-string-data.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/tracked-object-string-data.test.ts
@@ -0,0 +1,149 @@
+import { expect, it, vi } from "vitest";
+import { Budget } from "./budget.js";
+import { run } from "../run.js";
+import { accessorAdapter } from "./accessors.js";
+import {
+  createIntrinsicObject,
+  markDescriptorObject,
+  materializeFunctionProperties,
+  setSandboxPrototype,
+} from "./object-model.js";
+import { createSandboxClosure, measureSandboxData } from "./values.js";
+
+it("captures string primitive data before descendant callbacks mutate later fields", () => {
+  const root = createIntrinsicObject();
+  root.first = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      root.later = "longer";
+      return [];
+    },
+  });
+  root.later = "a";
+  expect(measureSandboxData([root])).toBe(15);
+  expect(measureSandboxData([root])).toBe(20);
+});
+
+it("deduplicates live symbol descendants without conflating same-description symbols", () => {
+  const first = Symbol("same"),
+    second = Symbol("same");
+  const root = createIntrinsicObject({
+    first,
+    second,
+    shared: first,
+    integer: -123n,
+  });
+  expect(measureSandboxData([root, first])).toBe(42);
+  root.second = first;
+  expect(measureSandboxData([root, first])).toBe(37);
+});
+
+it("keeps descriptor-only visibility changes and accessor captures live without calling getters", () => {
+  const getter = vi.fn();
+  const closure = createSandboxClosure({
+    call: getter,
+    retainedValues: () => ["owned"],
+  });
+  const root = createIntrinsicObject();
+  Object.defineProperty(root, "hidden", {
+    configurable: true,
+    get: accessorAdapter(closure, "get"),
+  });
+  const before = measureSandboxData([root]);
+  markDescriptorObject(root);
+  expect(measureSandboxData([root])).toBe(before + 13);
+  Object.defineProperty(root, "hidden", {
+    value: "replacement",
+    enumerable: true,
+  });
+  expect(measureSandboxData([root])).toBe(19);
+  expect(getter).not.toHaveBeenCalled();
+});
+
+it("observes shared descendant growth and still enforces data limits", () => {
+  const nested = createIntrinsicObject({ text: "a" });
+  const root = createIntrinsicObject({ first: nested, second: nested });
+  const before = measureSandboxData([root]);
+  nested.text = "x".repeat(1000);
+  expect(measureSandboxData([root, nested])).toBe(before + 999);
+  expect(() =>
+    new Budget({ dataSize: 100 }).reconcileDataUsage(
+      measureSandboxData([root]),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("keeps prototype growth visible after an unchanged own-field capture", () => {
+  const root = createIntrinsicObject({ text: "a" });
+  const before = measureSandboxData([root]);
+  const prototype = createIntrinsicObject({ text: "prototype" });
+  setSandboxPrototype(root, prototype);
+  expect(measureSandboxData([root])).toBe(before + 15);
+  prototype.text = "larger prototype";
+  expect(measureSandboxData([root])).toBe(before + 22);
+});
+
+it("reuses guest function property snapshots while remeasuring nested values", () => {
+  const closure = createSandboxClosure({
+    guest: true,
+    name: "example",
+    call: () => undefined,
+  });
+  const properties = materializeFunctionProperties(closure);
+  const nested = createIntrinsicObject({ text: "a" });
+  properties.box = nested;
+  const before = measureSandboxData([closure]);
+  const descriptors = vi.spyOn(Object, "getOwnPropertyDescriptor");
+  try {
+    expect(measureSandboxData([closure])).toBe(before);
+    expect(
+      descriptors.mock.calls.filter(
+        ([owner, key]) => owner === properties && typeof key === "string",
+      ),
+    ).toHaveLength(0);
+  } finally {
+    descriptors.mockRestore();
+  }
+  nested.text = "longer";
+  expect(measureSandboxData([closure])).toBe(before + 5);
+  delete properties.box;
+  expect(measureSandboxData([closure])).toBeLessThan(before);
+});
+
+it("matches conservative accounting for exotic descendants and later payload growth", async () => {
+  const result = await run(`return {
+    array: ["a", "b"], map: new Map([["a", {text: "one"}]]),
+    set: new Set(["shared"]), regex: new RegExp("a", "g"), date: new Date(0),
+    bytes: new Uint8Array([1, 2]), box: Object("a")
+  }`);
+  expect(result.ok, result.ok ? undefined : result.error.message).toBe(true);
+  if (!result.ok) throw new Error("Guest setup failed");
+  const payload = result.returnValue;
+  const fast = createIntrinsicObject({ payload });
+  const conservative = Object.assign(Object.create(null), { payload });
+  const before = measureSandboxData([conservative]);
+  expect(measureSandboxData([fast])).toBe(before);
+  const values = payload as Record<string, unknown>;
+  (values.array as string[]).push("longer");
+  expect(measureSandboxData([fast])).toBe(measureSandboxData([conservative]));
+  expect(measureSandboxData([fast])).toBeGreaterThan(before);
+});
+
+it("preserves private fields and rooted weak payloads through tracked tables", async () => {
+  const result = await run(`
+    class Holder { #text = "private retained text"; }
+    const key = {};
+    return { holder: new Holder(), key,
+      weak: new WeakMap([[key, {text: "weak retained text"}]]) };
+  `);
+  expect(result.ok, result.ok ? undefined : result.error.message).toBe(true);
+  if (!result.ok) throw new Error("Guest setup failed");
+  const payload = result.returnValue as Record<string, unknown>;
+  const fast = createIntrinsicObject({ payload });
+  const conservative = Object.assign(Object.create(null), { payload });
+  const before = measureSandboxData([conservative]);
+  expect(measureSandboxData([fast])).toBe(before);
+  delete payload.key;
+  expect(measureSandboxData([fast])).toBe(measureSandboxData([conservative]));
+  expect(measureSandboxData([fast])).toBeLessThan(before);
+});
