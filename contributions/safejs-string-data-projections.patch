+// Only SDK-owned proxies have exhaustive mutation tracking. Cache their own
+// string fields, never the recursive sizes of their mutable descendants.
+export function trackedObjectStringData(value: object, includeNonEnumerable: boolean): StringDataProjection | undefined {
+  const state = functionPropertyRevisions.get(value);
+  if (state === undefined) return undefined;
+  if (state.measuredStringRevision !== state.revision) {
+    const enumerable: StringDataProjection = { units: 0, references: [] };
+    const all: StringDataProjection = { units: 0, references: [] };
+    for (const key of Object.getOwnPropertyNames(value)) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+      let units = 1 + key.length;
+      let references: unknown[];
+      if ("value" in descriptor) {
+        const item = descriptor.value;
+        if (typeof item === "string") units += item.length;
+        else if (typeof item === "bigint") units += item.toString(16).length;
+        references = ((typeof item === "object" && item !== null) || typeof item === "symbol") ? [item] : [];
+      } else references = retainedAccessorClosures(descriptor);
+      all.units += units;
+      all.references.push(...references);
+      if (descriptor.enumerable) {
+        enumerable.units += units;
+        enumerable.references.push(...references);
+      }
+    }
+    state.enumerableStrings = enumerable;
+    state.allStrings = all;
+    state.measuredStringRevision = state.revision;
+  }
+  return includeNonEnumerable ? state.allStrings : state.enumerableStrings;
+}
