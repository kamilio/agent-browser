index 0000000..4d853bf
--- /dev/null
+++ b/packages/safe-js/src/interp/guest-objects.ts
@@ -0,0 +1,255 @@
+import { liveHostObject, liveHostOwnDescriptor, liveHostOwnKeys } from "../host-object.js";
+import type { Budget } from "./budget.js";
+import type { SandboxClosure, SandboxObject, SandboxValue } from "./values.js";
+
+interface FunctionObjectState {
+  properties: SandboxObject;
+  prototype?: SandboxObject;
+  name: string;
+  length: number;
+}
+
+const functions = new WeakMap<object, FunctionObjectState>();
+const prototypes = new WeakMap<object, SandboxObject | null>();
+const objectPrototypes = new WeakMap<Budget, SandboxObject>();
+const intrinsicPrototypes = new WeakSet<object>();
+const objectConstructors = new WeakMap<object, () => boolean>();
+const prototypeDepths = new WeakMap<object, number>();
+const defaultPrototypes = new WeakSet<object>();
+const maxPrototypeDepth = 256;
+
+export function registerGuestFunction(closure: SandboxClosure, constructible: boolean): void {
+  const properties = Object.create(null) as SandboxObject;
+  const name = closure.name ?? "";
+  const length = closure.length ?? 0;
+  Object.defineProperties(properties, {
+    name: { value: name, configurable: true },
+    length: { value: length, configurable: true },
+  });
+  let prototype: SandboxObject | undefined;
+  if (constructible) {
+    prototype = Object.create(null) as SandboxObject;
+    defaultPrototypes.add(prototype);
+    Object.defineProperty(prototype, "constructor", {
+      value: closure,
+      writable: true,
+      configurable: true,
+    });
+    Object.defineProperty(properties, "prototype", { value: prototype, writable: true });
+  }
+  functions.set(closure, { properties, prototype, name, length });
+}
+
+export function guestFunctionProperties(value: unknown): SandboxObject | undefined {
+  return typeof value === "object" && value !== null ? functions.get(value)?.properties : undefined;
+}
+
+export function guestPrototype(value: unknown, budget?: Budget): SandboxObject | undefined {
+  if (typeof value !== "object" || value === null) return undefined;
+  if (prototypes.has(value)) return prototypes.get(value) ?? undefined;
+  if (budget === undefined || !isOrdinaryGuestObject(value)) return undefined;
+  return objectPrototypes.get(budget);
+}
+
+export function isOrdinaryGuestObject(value: unknown): value is SandboxObject {
+  if (typeof value !== "object" || value === null || Array.isArray(value) || liveHostObject(value))
+    return false;
+  const nativePrototype = Object.getPrototypeOf(value);
+  return (
+    (nativePrototype === null || nativePrototype === Object.prototype) &&
+    Object.getOwnPropertySymbols(value).length === 0
+  );
+}
+
+export function registerObjectPrototype(
+  budget: Budget,
+  prototype: SandboxObject,
+  constructor: SandboxClosure,
+): void {
+  objectPrototypes.set(budget, prototype);
+  intrinsicPrototypes.add(prototype);
+  prototypes.set(prototype, null);
+  const initial = Object.getOwnPropertyDescriptors(prototype);
+  const changed = () => {
+    const names = Object.getOwnPropertyNames(prototype);
+    return (
+      !Object.isExtensible(prototype) ||
+      names.length !== Object.keys(initial).length ||
+      names.some((name) => {
+        const current = Object.getOwnPropertyDescriptor(prototype, name);
+        const previous = Object.hasOwn(initial, name) ? initial[name] : undefined;
+        return (
+          current?.value !== previous?.value ||
+          current?.writable !== previous?.writable ||
+          current?.configurable !== previous?.configurable ||
+          current?.enumerable !== previous?.enumerable
+        );
+      })
+    );
+  };
+  objectConstructors.set(constructor, changed);
+  budget.setRetainedValues(objectPrototypes, function* () {
+    if (changed()) yield prototype;
+  });
+}
+
+export function releaseObjectPrototype(budget: Budget): void {
+  objectPrototypes.delete(budget);
+  budget.setRetainedValues(objectPrototypes, undefined);
+}
+
+export function isObjectConstructor(value: unknown): boolean {
+  return typeof value === "object" && value !== null && objectConstructors.has(value);
+}
+
+export function hasUnsupportedObjectIntrinsicState(value: unknown): boolean {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    (intrinsicPrototypes.has(value) || objectConstructors.get(value)?.() === true)
+  );
+}
+
+export function setGuestPrototype(value: SandboxObject, prototype: SandboxValue): void {
+  if (prototype !== null && !isOrdinaryGuestObject(prototype))
+    throw new TypeError("Prototype must be an ordinary guest object or null.");
+  const depth = prototype === null ? 0 : (prototypeDepths.get(prototype) ?? 0) + 1;
+  if (depth > maxPrototypeDepth)
+    throw new RangeError("Guest prototype chain exceeds the supported depth.");
+  prototypes.set(value, prototype);
+  prototypeDepths.set(value, depth);
+}
+
+export function isGuestDefaultPrototype(value: object): boolean {
+  return defaultPrototypes.has(value);
+}
+
+export function createGuestInstance(closure: SandboxClosure): SandboxObject {
+  const instance = Object.create(null) as SandboxObject;
+  const prototype = guestFunctionProperties(closure)?.prototype;
+  if (typeof prototype === "object" && prototype !== null) {
+    const nativePrototype = Object.getPrototypeOf(prototype);
+    if (
+      liveHostObject(prototype) !== undefined ||
+      (!guestFunctionProperties(prototype) &&
+        !Array.isArray(prototype) &&
+        ((nativePrototype !== null && nativePrototype !== Object.prototype) ||
+          Object.getOwnPropertySymbols(prototype).length > 0))
+    )
+      throw new TypeError("Constructor prototype must be an ordinary guest object.");
+    const depth = (prototypeDepths.get(prototype) ?? 0) + 1;
+    if (depth > maxPrototypeDepth)
+      throw new RangeError("Guest prototype chain exceeds the supported depth.");
+    prototypes.set(instance, prototype as SandboxObject);
+    prototypeDepths.set(instance, depth);
+  }
+  return instance;
+}
+
+export function findGuestProperty(
+  value: object | undefined,
+  key: string,
+  budget?: Budget,
+): { owner: object; descriptor: PropertyDescriptor } | undefined {
+  const visited = new Set<object>();
+  let current = value;
+  while (current !== undefined) {
+    budget?.visitNode();
+    if (visited.has(current)) throw new TypeError("Cyclic guest prototype chain.");
+    visited.add(current);
+    const owner = guestFunctionProperties(current) ?? current;
+    const descriptor = liveHostOwnDescriptor(owner, key);
+    if (descriptor !== undefined) return { owner, descriptor };
+    current = guestPrototype(current, budget);
+  }
+  return undefined;
+}
+
+export function guestInstanceOf(
+  value: SandboxValue,
+  constructor: SandboxClosure,
+  budget: Budget,
+): boolean {
+  if (typeof value !== "object" || value === null) return false;
+  const prototype = isObjectConstructor(constructor)
+    ? constructor.properties?.prototype
+    : guestFunctionProperties(constructor)?.prototype;
+  if (typeof prototype !== "object" || prototype === null)
+    throw new TypeError("Function has non-object prototype in instanceof check.");
+  const visited = new Set<object>();
+  let current = guestPrototype(value, budget);
+  while (current !== undefined) {
+    budget.visitNode();
+    if (current === prototype) return true;
+    if (visited.has(current)) throw new TypeError("Cyclic guest prototype chain.");
+    visited.add(current);
+    current = guestPrototype(current, budget);
+  }
+  return false;
+}
+
+export function guestForInKeys(value: object, budget: Budget): string[] {
+  const keys: string[] = [];
+  const visited = new Set<object>();
+  const seen = new Set<string>();
+  let current: object | undefined = value;
+  while (current !== undefined) {
+    budget.visitNode();
+    if (visited.has(current)) throw new TypeError("Cyclic guest prototype chain.");
+    visited.add(current);
+    const target = guestFunctionProperties(current) ?? current;
+    for (const key of liveHostOwnKeys(target)) {
+      budget.visitNode();
+      if (seen.has(key)) continue;
+      seen.add(key);
+      if (liveHostOwnDescriptor(target, key)?.enumerable) keys.push(key);
+    }
+    current = guestPrototype(current, budget);
+  }
+  return keys;
+}
+
+export function hasExtendedGuestState(value: unknown): boolean {
+  if (typeof value !== "object" || value === null) return false;
+  if (objectConstructors.get(value)?.()) return true;
+  if (prototypes.has(value) || defaultPrototypes.has(value)) return true;
+  const state = functions.get(value);
+  if (state === undefined) return false;
+  const fields = Object.getOwnPropertyNames(state.properties);
+  if (
+    fields.length !== (state.prototype === undefined ? 2 : 3) ||
+    !Object.isExtensible(state.properties)
+  )
+    return true;
+  for (const [name, expected] of [
+    ["name", state.name],
+    ["length", state.length],
+  ] as const) {
+    const descriptor = Object.getOwnPropertyDescriptor(state.properties, name);
+    if (
+      descriptor?.value !== expected ||
+      descriptor.writable ||
+      descriptor.enumerable ||
+      !descriptor.configurable
+    )
+      return true;
+  }
+  if (state.prototype !== undefined) {
+    const descriptor = Object.getOwnPropertyDescriptor(state.properties, "prototype");
+    const constructor = Object.getOwnPropertyDescriptor(state.prototype, "constructor");
+    if (
+      descriptor?.value !== state.prototype ||
+      !descriptor.writable ||
+      descriptor.enumerable ||
+      descriptor.configurable ||
+      Object.getOwnPropertyNames(state.prototype).length !== 1 ||
+      constructor?.value !== value ||
+      !constructor.writable ||
+      !constructor.configurable ||
+      constructor.enumerable ||
+      !Object.isExtensible(state.prototype)
+    )
+      return true;
+  }
+  return false;
+}
