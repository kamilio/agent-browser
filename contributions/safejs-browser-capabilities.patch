+  });
+
+  it("does not cache writable or reconfigurable descriptors prematurely", () => {
+    const record = Object.defineProperties({}, {
+      writable: { value: "a", writable: true, enumerable: true },
+      configurable: { value: "b", configurable: true, enumerable: true },
+    }) as { writable: string; configurable: string };
+    const initial = measureSandboxData([record]);
+    record.writable = "longer";
+    Object.defineProperty(record, "configurable", { value: "changed", enumerable: false });
+    expect(measureSandboxData([record])).toBe(initial + 5 - 14);
+    Object.defineProperty(record, "writable", { writable: false });
+    const final = measureSandboxData([record]);
+    expect(measureSandboxData([record])).toBe(final);
+  });
+
+  it("keeps mutable children of fixed data properties live", () => {
+    const child = { text: "a" };
+    const record = Object.defineProperty({}, "fixed", { value: child, enumerable: true });
+    const initial = measureSandboxData([record]);
+    child.text = "longer";
+    expect(measureSandboxData([record])).toBe(initial + 5);
+  });
+
+  it("charges guest expandos added after a live host object's descriptor cache warms", async () => {
+    let calls = 0;
+    const host = createHostObject({ properties: { fixed: { get: () => { calls++; return 42; } } } });
+    const budget = new Budget({ maxSteps: 100_000, dataSize: 10_000, arrayLength: 10_000 });
+    const realm = createRealm({ bindings: { host }, budget });
+    try {
+      await realm.evaluate("let warm = host;");
+      await expect(realm.evaluate("host.extra = 'x'.repeat(20000);")).rejects.toMatchObject({ budget: "dataSize" });
