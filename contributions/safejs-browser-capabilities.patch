diff --git a/packages/safe-js/src/host-object.ts b/packages/safe-js/src/host-object.ts
new file mode 100644
index 0000000..23468e8
--- /dev/null
+++ b/packages/safe-js/src/host-object.ts
@@ -0,0 +1,225 @@
+import { types as nodeTypes } from "node:util";
+
+import type { SandboxObject, SandboxValue } from "./interp/values.js";
+
+declare const hostObjectType: unique symbol;
+
+export type HostObject = { readonly [hostObjectType]: true };
+export type HostObjectProperty = { get: () => unknown; set?: (value: unknown) => void };
+export type HostObjectIndexed = {
+  maxLength: number;
+  length: () => number;
+  get: (index: number) => unknown;
+};
+export type HostObjectNamed = {
+  maxKeys: number;
+  maxKeyCodeUnits: number;
+  enumerable?: boolean;
+  keys: () => readonly string[];
+  get: (name: string) => unknown;
+};
+export type HostObjectDefinition = {
+  properties?: Record<string, HostObjectProperty>;
+  methods?: Record<string, (...args: readonly unknown[]) => unknown>;
+  indexed?: HostObjectIndexed;
+  named?: HostObjectNamed;
+};
+
+type Definition = {
+  properties: ReadonlyMap<string, Readonly<HostObjectProperty>>;
+  methods: ReadonlyMap<string, (...args: readonly unknown[]) => unknown>;
+  indexed?: Readonly<HostObjectIndexed>;
+  named?: Readonly<HostObjectNamed>;
+};
+
+export type HostObjectRegistry = {
+  objects: WeakMap<HostObject, SandboxObject>;
+  retained: Set<SandboxValue>;
+  references: Map<object, SandboxValue>;
+};
+
+type LiveObject = {
+  capability: HostObject;
+  registry: HostObjectRegistry;
+  assertActive: () => void;
+  indexed?: { length: () => number; get: (index: number) => SandboxValue; keys: () => string[] };
+  named?: { enumerable: boolean; keys: () => string[]; get: (name: string) => SandboxValue };
+};
+
+const definitions = new WeakMap<object, Definition>();
+const liveObjects = new WeakMap<object, LiveObject>();
+
+export function createHostObject(definition: HostObjectDefinition): HostObject {
+  const fields = ownFields(definition);
+  if (
+    [...fields.keys()].some((key) => !["properties", "methods", "indexed", "named"].includes(key))
+  ) {
+    throw new TypeError("Unknown host object definition field.");
+  }
+  const properties = new Map<string, Readonly<HostObjectProperty>>();
+  const methods = new Map<string, (...args: readonly unknown[]) => unknown>();
+  for (const [key, descriptor] of ownFields(fields.get("properties") ?? {})) {
+    assertMemberName(key);
+    const members = ownFields(descriptor);
+    if ([...members.keys()].some((name) => name !== "get" && name !== "set")) {
+      throw new TypeError("Unknown host property descriptor field.");
+    }
+    const get = members.get("get");
+    const set = members.get("set");
+    if (typeof get !== "function" || (set !== undefined && typeof set !== "function")) {
+      throw new TypeError("Host properties require a getter and an optional setter.");
+    }
+    properties.set(
+      key,
+      Object.freeze({
+        get: get as () => unknown,
+        ...(set === undefined ? {} : { set: set as (value: unknown) => void }),
+      }),
+    );
+  }
+  for (const [key, method] of ownFields(fields.get("methods") ?? {})) {
+    assertMemberName(key);
+    if (properties.has(key) || typeof method !== "function") {
+      throw new TypeError("Host methods must be functions with distinct member names.");
+    }
+    methods.set(key, method as (...args: readonly unknown[]) => unknown);
+  }
+  let indexed: Readonly<HostObjectIndexed> | undefined;
+  if (fields.has("indexed")) {
+    const members = ownFields(fields.get("indexed"));
+    const maxLength = members.get("maxLength");
+    const length = members.get("length");
+    const get = members.get("get");
+    if (
+      [...members.keys()].some((key) => !["maxLength", "length", "get"].includes(key)) ||
+      typeof maxLength !== "number" ||
+      !Number.isSafeInteger(maxLength) ||
+      maxLength < 1 ||
+      maxLength > 65_536 ||
+      typeof length !== "function" ||
+      typeof get !== "function"
+    )
+      throw new TypeError(
+        "Indexed host objects require synchronous getters and a maximum length from 1 to 65536.",
+      );
+    for (const name of [...properties.keys(), ...methods.keys()])
+      if (name === "length" || hostObjectIndex(name) !== undefined)
+        throw new TypeError("Indexed host object members cannot shadow length or numeric indices.");
+    indexed = Object.freeze({
+      maxLength,
+      length: length as () => number,
+      get: get as (index: number) => unknown,
+    });
+  }
+  let named: Readonly<HostObjectNamed> | undefined;
+  if (fields.has("named")) {
+    const members = ownFields(fields.get("named"));
+    const maxKeys = members.get("maxKeys");
+    const maxKeyCodeUnits = members.get("maxKeyCodeUnits");
+    const enumerable = members.get("enumerable");
+    const keys = members.get("keys");
+    const get = members.get("get");
+    if ([...members.keys()].some(key => !["maxKeys", "maxKeyCodeUnits", "enumerable", "keys", "get"].includes(key)) ||
+        typeof maxKeys !== "number" || !Number.isSafeInteger(maxKeys) || maxKeys < 1 || maxKeys > 65_536 ||
+        typeof maxKeyCodeUnits !== "number" || !Number.isSafeInteger(maxKeyCodeUnits) || maxKeyCodeUnits < 1 || maxKeyCodeUnits > 1_048_576 ||
+        (enumerable !== undefined && typeof enumerable !== "boolean") || typeof keys !== "function" || typeof get !== "function")
+      throw new TypeError("Named host objects require bounded synchronous key and value providers.");
+    named = Object.freeze({ maxKeys, maxKeyCodeUnits, enumerable: enumerable !== false, keys: keys as () => readonly string[], get: get as (name: string) => unknown });
+  }
+  const capability = Object.freeze(Object.create(null)) as HostObject;
+  definitions.set(capability, { properties, methods, indexed, named });
+  return capability;
+}
+
+export function hostObjectDefinition(value: unknown): Definition | undefined {
+  return typeof value === "object" && value !== null ? definitions.get(value) : undefined;
+}
+
+export function registerLiveHostObject(value: SandboxObject, descriptor: LiveObject): void {
+  liveObjects.set(value, descriptor);
+}
+
+export function liveHostObject(value: unknown): LiveObject | undefined {
+  return typeof value === "object" && value !== null ? liveObjects.get(value) : undefined;
+}
+
+export function hostObjectIndex(name: string): number | undefined {
+  const index = Number(name);
+  return Number.isInteger(index) && index >= 0 && index < 4_294_967_295 && String(index) === name
+    ? index
+    : undefined;
+}
+
+export function liveHostOwnDescriptor(value: object, name: string): PropertyDescriptor | undefined {
+  const live = liveObjects.get(value);
+  if (live === undefined) return Object.getOwnPropertyDescriptor(value, name);
+  live.assertActive();
+  const index = hostObjectIndex(name);
+  if (live.indexed !== undefined && index !== undefined)
+    return index < live.indexed.length()
+      ? { configurable: true, enumerable: true, get: () => live.indexed!.get(index) }
+      : undefined;
+  const fixed = Object.getOwnPropertyDescriptor(value, name);
+  if (fixed !== undefined) return fixed;
+  const named = live.named;
+  return named?.keys().includes(name)
+    ? { configurable: true, enumerable: named.enumerable, get: () => named.get(name) }
+    : undefined;
+}
+
+export function liveHostOwnKeys(value: object): string[] {
+  const live = liveObjects.get(value);
+  live?.assertActive();
+  const indices = live?.indexed?.keys() ?? [];
+  const fixed = Object.getOwnPropertyNames(value);
+  const names = (live?.named?.keys() ?? []).filter(name => live?.indexed === undefined || hostObjectIndex(name) === undefined);
+  return [...new Set([...indices, ...fixed, ...names])];
+}
+
+export function setLiveHostProperty(value: object, name: string, entry: SandboxValue): boolean {
+  const live = liveObjects.get(value);
+  live?.assertActive();
+  if (live?.indexed !== undefined && hostObjectIndex(name) !== undefined)
+    throw new TypeError("Indexed host object properties are read only.");
+  if (live?.named !== undefined && !Object.hasOwn(value, name))
+    throw new TypeError("Named host object properties are read only.");
+  return Reflect.set(value, name, entry);
+}
+
+export function unwrapLiveHostObject(
+  value: SandboxObject,
+  registry?: HostObjectRegistry,
+): HostObject {
+  const live = liveObjects.get(value);
+  if (live === undefined || live.registry !== registry) {
+    throw new TypeError("A live host object cannot cross this capability boundary.");
+  }
+  live.assertActive();
+  return live.capability;
+}
+
+function ownFields(value: unknown): Map<string, unknown> {
+  if (typeof value !== "object" || value === null || nodeTypes.isProxy(value)) {
+    throw new TypeError("Host object definitions require plain records.");
+  }
+  const prototype = Object.getPrototypeOf(value);
+  if (
+    (prototype !== null && prototype !== Object.prototype) ||
+    Object.getOwnPropertySymbols(value).length > 0
+  ) {
+    throw new TypeError("Host object definitions require plain string-keyed records.");
+  }
+  const fields = new Map<string, unknown>();
+  for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(value))) {
+    if (!("value" in descriptor))
+      throw new TypeError("Host object definitions cannot contain accessors.");
+    fields.set(key, descriptor.value);
+  }
+  return fields;
+}
+
+function assertMemberName(name: string): void {
+  if (name === "constructor" || name === "prototype" || name === "__proto__") {
+    throw new TypeError("Host object prototype capabilities are not supported.");
+  }
+}
