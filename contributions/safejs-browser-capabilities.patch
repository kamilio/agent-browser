+import { describe, expect, it } from "vitest";
+import { Budget, createHostObject, createRealm, deepCopyFromSandbox } from "../core.js";
+import { encodeReplayData } from "../snapshot/replay-data.js";
+import { serialize, type RuntimeSnapshotValue } from "../snapshot/serialize.js";
+import type { SandboxValue } from "./values.js";
+
+async function evaluate(source: string) {
+  const realm = createRealm();
+  try {
+    await realm.evaluate(source);
+    return deepCopyFromSandbox((await realm.evaluate("result")).returnValue);
+  } finally {
+    await realm.close();
+  }
+}
+
+describe("guest function objects and ordinary constructor prototypes", () => {
+  it("stores, updates, aliases and deletes function own properties", async () => {
+    expect(
+      await evaluate(`function Library() {}
+Library.fn = Library.prototype = { value: 42 };
+Library.count = 1; Library.count++; Library.count += 2;
+let same = Library.fn === Library.prototype;
+delete Library.count;
+let result = [same, Library.fn.value, Library.count, Object.keys(Library)];`)
+    ).toEqual([true, 42, undefined, ["fn"]]);
+  });
+
+  it("creates distinct default prototypes with guest-only constructor links", async () => {
+    expect(
+      await evaluate(`function First() {} function Second() {}
+let result = [First.prototype === First.prototype, First.prototype !== Second.prototype,
+First.prototype.constructor === First, typeof First.constructor, typeof First.call,
+Object.keys(First.prototype), Object.hasOwn(First, "prototype"), Object.hasOwn(First, "call")];`)
+    ).toEqual([true, true, true, "undefined", "function", [], true, false]);
+  });
+
+  it("constructs instances with inherited guest methods and live prototype mutations", async () => {
+    expect(
+      await evaluate(`function Counter(value) { this.value = value; }
+Counter.prototype.read = function() { return this.value; };
+let counter = new Counter(7);
+Counter.prototype.bonus = 2;
+let result = [counter.read(), counter.bonus, counter.constructor === Counter, counter instanceof Counter,
+Object.keys(counter), Object.hasOwn(counter, "read")];`)
+    ).toEqual([7, 2, true, true, ["value"], false]);
+  });
+
+  it("preserves earlier instance prototype identity when the constructor prototype is replaced", async () => {
+    expect(
+      await evaluate(`function Item() {} Item.prototype.label = "old";
+let old = new Item(); Item.prototype = { label: "new" }; let fresh = new Item();
+let result = [old.label, fresh.label, old instanceof Item, fresh instanceof Item];`)
+    ).toEqual(["old", "new", false, true]);
+  });
+
+  it("walks multi-level guest inheritance for reads, in and instanceof", async () => {
+    expect(
+      await evaluate(`function Base() {} Base.prototype.answer = 42;
+function Child() {} Child.prototype = new Base(); Child.prototype.own = "child";
+let instance = new Child();
+let result = [instance.answer, instance.own, instance instanceof Child, instance instanceof Base,
+"answer" in instance, "absent" in instance, Object.hasOwn(instance, "answer")];`)
+    ).toEqual([42, "child", true, true, true, false, false]);
+  });
+
+  it("shadows writable inherited data instead of mutating the prototype", async () => {
+    expect(
+      await evaluate(`function Counter() {} Counter.prototype.value = 1;
+let counter = new Counter(); counter.value++; let own = Object.hasOwn(counter, "value");
+delete counter.value;
+let result = [own, counter.value, Counter.prototype.value];`)
+    ).toEqual([true, 1, 1]);
+  });
+
+  it("keeps explicit constructor object returns and primitive-return fallback", async () => {
+    expect(
+      await evaluate(`function ObjectResult() { return { value: 3 }; }
+function PrimitiveResult() { this.value = 4; return 99; }
+let first = new ObjectResult(); let second = new PrimitiveResult();
+let result = [first.value, first instanceof ObjectResult, second.value, second instanceof PrimitiveResult];`)
+    ).toEqual([3, false, 4, true]);
+  });
+
+  it("allows function properties on arrows and async functions without making them constructors", async () => {
+    expect(
+      await evaluate(`let arrow = () => 1; let asyncFunction = async () => 2;
+arrow.answer = 3; asyncFunction.answer = 4; arrow.prototype = {};
+let rejected = false; try { new arrow(); } catch (error) { rejected = true; }
+let result = [arrow.answer, asyncFunction.answer, Object.hasOwn(asyncFunction, "prototype"), rejected];`)
+    ).toEqual([3, 4, false, true]);
+  });
+
+  it("uses bound constructor targets while keeping bound functions' own properties separate", async () => {
+    expect(
+      await evaluate(`function Counter(value) { this.value = value; }
+let Bound = Counter.bind(null, 7); Bound.marker = "bound";
+let counter = new Bound();
+let result = [counter.value, counter instanceof Bound, counter instanceof Counter,
+Bound.marker, Counter.marker, Object.hasOwn(Bound, "prototype")];`)
+    ).toEqual([7, true, true, "bound", undefined, false]);
+  });
+
+  it("enumerates and assigns only the guest-visible own properties of a function", async () => {
+    expect(
+      await evaluate(`function Library() {} Object.assign(Library, { first: 1, second: 2 });
+let keys = []; for (let key in Library) keys.push(key);
+let result = [Object.keys(Library), Object.values(Library), Object.entries(Library), keys,
+Object.hasOwn(Library, "kind"), Object.hasOwn(Library, "length"), Library.length, Library.name];`)
+    ).toEqual([
+      ["first", "second"],
+      [1, 2],
+      [
+        ["first", 1],
+        ["second", 2]
+      ],
+      ["first", "second"],
+      false,
+      true,
+      0,
+      "Library"
+    ]);
+  });
+
+  it("freezes guest function properties without freezing unrelated functions", async () => {
+    expect(
+      await evaluate(`function First() {} function Second() {}
+let before = Object.isFrozen(First); First.answer = 1; Object.freeze(First);
+let refused = false; try { First.answer = 2; } catch (error) { refused = true; }
+Second.answer = 3; let result = [before, Object.isFrozen(First), refused, First.answer, Second.answer];`)
+    ).toEqual([false, true, true, 1, 3]);
+  });
+
+  it("rejects writes shadowing non-writable inherited properties", async () => {
+    expect(
+      await evaluate(`function Frozen() {} Frozen.prototype.value = 1; Object.freeze(Frozen.prototype);
+let instance = new Frozen(); let refused = false;
+try { instance.value = 2; } catch (error) { refused = true; }
+let result = [refused, instance.value, Object.hasOwn(instance, "value")];`)
+    ).toEqual([true, 1, false]);
+  });
+
+  it("implements instanceof errors without following native host prototypes", async () => {
+    expect(
+      await evaluate(`function Broken() {} Broken.prototype = 3;
+let invalidPrototype = false; let invalidRight = false;
+try { ({}) instanceof Broken; } catch (error) { invalidPrototype = true; }
+try { ({}) instanceof 3; } catch (error) { invalidRight = true; }
+let instance = new Broken();
+let result = [invalidPrototype, invalidRight, 3 instanceof Broken, instance.constructor === Object];`)
+    ).toEqual([true, true, false, true]);
+  });
+
+  it("never makes native bindings or intrinsic callable state writable", async () => {
+    const realm = createRealm({ bindings: { native: () => 42 } });
+    try {
+      await realm.evaluate(`let blocked = 0;
+try { native.extra = 1; } catch (error) { blocked++; }
+try { Number.extra = 1; } catch (error) { blocked++; }
+function Guest() {} Guest.call = function() { return 7; }; Guest.__proto__ = { marker: 1 };
+let result = [blocked, native(), Guest.call(), Guest.__proto__.marker,
+typeof native.constructor, typeof Guest.prototype.constructor.constructor, ({}).marker];`);
+      expect(deepCopyFromSandbox((await realm.evaluate("result")).returnValue)).toEqual([
+        2,
+        42,
+        7,
+        1,
+        "undefined",
+        "undefined",
+        undefined
+      ]);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("charges retained function properties against data limits", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 10000, dataSize: 3000 }) });
+    try {
+      await expect(
+        realm.evaluate(
+          'function Store() {} Store.values = []; for (let index = 0; index < 40; index++) Store.values.push("x".repeat(100));'
+        )
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("allows generator function properties without changing generator invocation", async () => {
+    expect(
+      await evaluate(`function* generate() { yield 7; }
+generate.label = "generator"; let iterator = generate();
+let result = [generate.label, iterator.next().value];`)
+    ).toEqual(["generator", 7]);
+  });
+
+  it.each(["function", "instance", "prototype"])(
+    "rejects lossy %s snapshot/replay conversion explicitly",
+    async (kind) => {
+      const realm = createRealm();
+      try {
+        await realm.evaluate("function Value() {} Value.extra = 42; let instance = new Value();");
+        const source =
+          kind === "function" ? "Value" : kind === "instance" ? "instance" : "Value.prototype";
+        const value = (await realm.evaluate(source)).returnValue as SandboxValue;
+        expect(() =>
+          encodeReplayData(value, {
+            identifyCapability: () => "value",
+            captureCapabilityProperties: true
+          })
+        ).toThrow("Guest function/prototype state");
+        expect(() =>
+          serialize({
+            source: "fixture",
+            currentAstNodeId: 1,
+            scopeChain: [{ id: 1, bindings: { value: value as RuntimeSnapshotValue } }],
+            callStack: [],
+            pendingPromises: [],
+            moduleBindings: {}
+          })
+        ).toThrow("Guest function/prototype state");
+      } finally {
+        await realm.close();
+      }
+    }
+  );
+
+  it("does not turn a live host grant into an inherited prototype", async () => {
+    let reads = 0;
+    const grant = createHostObject({
+      properties: {
+        value: {
+          get: () => {
+            reads++;
+            return 42;
+          }
+        }
+      }
+    });
+    const realm = createRealm({ bindings: { grant } });
+    try {
+      await realm.evaluate(
+        "function Invalid() {} Invalid.prototype = grant; let result = false; try { new Invalid(); } catch (error) { result = true; }"
+      );
+      expect((await realm.evaluate("result")).returnValue).toBe(true);
+      expect(reads).toBe(0);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("bounds guest prototype depth before allocating an unbounded inheritance chain", async () => {
+    expect(
+      await evaluate(`function Chain() {} let count = 0; let stopped = false;
+try { for (let index = 0; index < 300; index++) { Chain.prototype = new Chain(); count++; } }
+catch (error) { stopped = true; }
+let result = [stopped, count];`)
+    ).toEqual([true, 256]);
+  });
+});
diff --git a/packages/safe-js/src/interp/guest-objects.ts b/packages/safe-js/src/interp/guest-objects.ts
