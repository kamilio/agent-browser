+    expect(measureSandboxData([first, second])).toBe(expected + 11);
+    expect(calls).toBe(2);
+    expect(measureSandboxData([first, second], { ignoreClosureCaptures: true })).toBe(2);
+    expect(calls).toBe(2);
+  });
+
+  it("handles recursive closures sharing a capture identity without skipping later roots", () => {
+    const owner = {};
+    let calls = 0;
+    let captured: SandboxValue[] = [];
+    const retainedValues = () => { calls++; return captured; };
+    const first = createSandboxClosure({ call: () => undefined, retainedValues, retainedValuesIdentity: owner });
+    const second = createSandboxClosure({ call: () => undefined, retainedValues, retainedValuesIdentity: owner });
+    const later = { text: "later" };
+    captured = [first, second, "shared", later];
+    expect(measureSandboxData([first])).toBe(2 + 12 + measureSandboxData([later]));
+    expect(calls).toBe(1);
+  });
+
+  it("does not merge independent or unlabelled capture providers", () => {
+    let calls = 0;
+    const retainedValues = () => { calls++; return ["abc"]; };
