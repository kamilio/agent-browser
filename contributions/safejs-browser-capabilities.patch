+import { AsyncLocalStorage } from "node:async_hooks";
+
+import { parseExecutableModule } from "./parse/parser.js";
+import type { ParseResult } from "./parse.js";
+import { Budget, SandboxError } from "./interp/budget.js";
+import { CompileScope } from "./interp/regex/compile-guard.js";
+import { interpret, Scope, type InterpreterStats } from "./interp/interpreter.js";
+import { wrapCallerInjectedBindings, type CallerInjectedBinding } from "./interp/host-bridge.js";
+import { wrapCancelableBindings, withCancellationSignal } from "./interp/cancel.js";
+import { CallbackRuntime } from "./callback.js";
+import { SandboxJobQueue } from "./interp/jobs.js";
+import { runResources, type RunResources } from "./interp/resources.js";
+import {
+  createSandboxPromiseRejectionTracker,
+  withSandboxPromiseRejectionTracker
+} from "./interp/promise-tracker.js";
+import { createConsoleJsonGlobals, type ConsoleSink } from "./interp/globals/console-json.js";
+import { createCollectionGlobals } from "./interp/globals/collections.js";
+import { createFloat32ArrayGlobal } from "./interp/globals/float32array.js";
+import { createErrorGlobals } from "./interp/globals/error.js";
+import { createMathGlobals } from "./interp/globals/math.js";
+import { createObjectArrayGlobals } from "./interp/globals/object-array.js";
+import { releaseObjectPrototype } from "./interp/guest-objects.js";
+import { createMiscGlobals } from "./interp/globals/misc.js";
+import { createPromiseGlobals } from "./interp/promise.js";
+import { createRegexGlobals } from "./interp/globals/regex.js";
+import type { SandboxValue } from "./interp/values.js";
+import { UnhandledRejectionError } from "./run.js";
+import type { HostObjectRegistry } from "./host-object.js";
+import { createDateGlobals } from "./interp/globals/date.js";
+import { releaseDateGlobals } from "./interp/date-value.js";
+import { createCooperativeCheckpoint } from "./interp/cooperate.js";
+
+export type RealmOptions = {
+  now?: () => number;
+  bindings?: Record<string, CallerInjectedBinding>;
+  budget?: Budget;
+  maxSourceLength?: number;
+  maxEvaluations?: number;
+  signal?: AbortSignal;
+  sink?: ConsoleSink;
+};
+
+export type RealmResult = {
+  returnValue?: SandboxValue;
+  stats: InterpreterStats;
+};
+
+export type Realm = {
+  readonly closed: boolean;
+  evaluate(
+    source: string,
+    options?: { filename?: string; signal?: AbortSignal }
+  ): Promise<RealmResult>;
+  close(): Promise<void>;
+};
+
+export function createRealm(options: RealmOptions = {}): Realm {
+  const maxSourceLength = options.maxSourceLength ?? 1_048_576;
+  const maxEvaluations = options.maxEvaluations ?? 128;
+  for (const limit of [maxSourceLength, maxEvaluations]) {
+    if (!Number.isSafeInteger(limit) || limit < 1)
+      throw new TypeError("Realm limits must be positive safe integers.");
+  }
+  const budget =
+    options.budget ??
+    new Budget({
+      maxSteps: 1_000_000,
+      maxCallDepth: 64,
+      stringLength: 262_144,
+      arrayLength: 16_384,
+      dataSize: 4_194_304
+    });
+  const operation = budget.acquireCompileOwner(true);
+  const compilation = new CompileScope(operation.owner);
+  const controller = new AbortController();
+  const cooperate = createCooperativeCheckpoint(controller.signal);
+  const tracker = createSandboxPromiseRejectionTracker();
+  const hostObjects: HostObjectRegistry = { objects: new WeakMap(), retained: new Set(), references: new Map() };
+  budget.setRetainedValues(hostObjects, function* () {
+    yield* hostObjects.retained;
+    yield* hostObjects.references.values();
+  });
+  budget.setRetainedValues(tracker, () => tracker.retainedValues());
+  const cleanups = new Set<() => Promise<void>>();
+  const sourceOwner = {};
+  const resources: RunResources = {
+    signal: controller.signal,
+    add(close) {
+      if (controller.signal.aborted) throw new SandboxError("aborted");
+      cleanups.add(close);
+    }
+  };
+  const lifecycle = { hostCallbackDepth: 0, hostCallbackContext: new AsyncLocalStorage<true>() };
+  let scope: Scope | undefined;
+  let active: Promise<RealmResult> | undefined;
+  let cleanup: Promise<void> | undefined;
+  let sourceLength = 0;
+  let evaluations = 0;
+  const cancel = () => controller.abort(new SandboxError("aborted"));
+  const jobs = new SandboxJobQueue();
+  const callbackRuntime = new CallbackRuntime({
+    budget,
+    jobs,
+    compilation,
+    signal: controller.signal,
+    canStart: () => active === undefined || lifecycle.hostCallbackContext.getStore() === true,
+    nested: () => lifecycle.hostCallbackContext.getStore() === true,
+    run: (execute) =>
+      runResources.run(resources, () =>
+        withSandboxPromiseRejectionTracker(tracker, () =>
+          withCancellationSignal(controller.signal, execute)
+        )
+      ),
+    fatal: () => abort()
+  });
+  budget.setRetainedValues(callbackRuntime, () => callbackRuntime.retained);
+  const abort = () => {
+    cancel();
+    if (active === undefined) void finish().catch(() => undefined);
+  };
+  const finish = (): Promise<void> => {
+    cleanup ??= Promise.resolve().then(async () => {
+      options.signal?.removeEventListener("abort", abort);
+      await Promise.allSettled([...callbackRuntime.pending]);
+      callbackRuntime.retained.clear();
+      callbackRuntime.wrappers = new WeakMap();
+      budget.setRetainedValues(callbackRuntime, undefined);
+      const outcomes = await Promise.allSettled(
+        [...cleanups].map((close) => Promise.resolve().then(close))
+      );
+      cleanups.clear();
+      tracker.clear();
+      hostObjects.retained.clear();
+      hostObjects.references.clear();
+      hostObjects.objects = new WeakMap();
+      budget.setRetainedValues(hostObjects, undefined);
+      budget.setRetainedValues(tracker, undefined);
+      scope = undefined;
+      releaseObjectPrototype(budget);
+      releaseDateGlobals(budget);
+      compilation.dispose();
+      budget.setRetainedDataUsage(sourceOwner, 0);
+      operation.release();
+      const failures = outcomes.flatMap((outcome) =>
+        outcome.status === "rejected" ? [outcome.reason] : []
+      );
+      if (failures.length > 0) throw new AggregateError(failures, "SafeJS realm cleanup failed.");
+    });
+    return cleanup;
+  };
+  options.signal?.addEventListener("abort", abort, { once: true });
+  if (options.signal?.aborted) cancel();
+  try {
+    if (controller.signal.aborted) throw new SandboxError("aborted");
+    const builtins = {
+      ...createConsoleJsonGlobals({ budget, compileOwner: operation.owner, sink: options.sink }),
+      ...createCollectionGlobals({ budget }),
+      Float32Array: createFloat32ArrayGlobal(budget),
+      ...createErrorGlobals({ budget }),
+      ...createMathGlobals({ random: Math.random }),
+      ...createObjectArrayGlobals({ budget }),
+      ...createDateGlobals(budget, options.now),
+      ...createMiscGlobals({ budget }),
+      ...createPromiseGlobals({ budget }),
+      ...createRegexGlobals(operation.owner)
+    };
+    const bindings = wrapCallerInjectedBindings(options.bindings ?? {}, {
+      budget,
+      compileOwner: operation.owner,
+      signal: controller.signal,
+      lifecycle,
+      callbackRuntime,
+      hostObjects
+    });
+    const globals = new Scope(builtins, undefined, undefined, { chargeData: false });
+    scope = new Scope(
+      {},
+      globals.child(wrapCancelableBindings(bindings, controller.signal)),
+      undefined,
+      { functionBoundary: true }
+    );
+  } catch (error) {
+    cancel();
+    options.signal?.removeEventListener("abort", abort);
+    compilation.dispose();
+    budget.setRetainedValues(tracker, undefined);
+    tracker.clear();
+    budget.setRetainedValues(hostObjects, undefined);
+    budget.setRetainedValues(callbackRuntime, undefined);
+    callbackRuntime.retained.clear();
+    hostObjects.retained.clear();
+    hostObjects.references.clear();
+    releaseObjectPrototype(budget);
+    releaseDateGlobals(budget);
+    operation.release();
+    throw error;
+  }
+
+  return {
+    get closed() {
+      return controller.signal.aborted;
+    },
+    async evaluate(source, evaluationOptions = {}) {
+      if (controller.signal.aborted) throw new SandboxError("aborted");
+      if (
+        active !== undefined ||
+        lifecycle.hostCallbackContext.getStore() === true ||
+        callbackRuntime.prefixes > 0
+      )
+        throw new SandboxError("reentry");
+      const signal = evaluationOptions.signal;
+      signal?.addEventListener("abort", cancel, { once: true });
+      if (signal?.aborted) cancel();
+      const execute = async (): Promise<RealmResult> => {
+        if (controller.signal.aborted) throw new SandboxError("aborted");
+        if (typeof source !== "string") throw new TypeError("Realm source must be a string.");
+        sourceLength += source.length;
+        if (sourceLength > maxSourceLength)
+          throw new SandboxError({
+            budget: "stringLength",
+            current: sourceLength,
+            limit: maxSourceLength
+          });
+        evaluations += 1;
+        if (evaluations > maxEvaluations)
+          throw new SandboxError({ budget: "steps", current: evaluations, limit: maxEvaluations });
+        budget.setRetainedDataUsage(sourceOwner, sourceLength);
+        const module = parseExecutableModule(source, evaluationOptions.filename, operation.owner);
+        if (
+          module.body.some(
+            (statement) =>
+              statement.type === "ImportDeclaration" ||
+              statement.type === "ExportNamedDeclaration" ||
+              statement.type === "ExportDefaultDeclaration"
+          )
+        ) {
+          throw new TypeError("Persistent realms evaluate scripts, not modules.");
+        }
+        const statement = module.body.length === 1 ? module.body[0] : undefined;
+        const executable: ParseResult =
+          statement?.type === "ExpressionStatement"
+            ? statement.expression
+            : { type: "BlockStatement", body: module.body, span: module.span };
+        const result = await interpret(executable, {
+          cooperate,
+          jobs,
+          budget,
+          compilation,
+          scope,
+          useScopeDirectly: true,
+          signal: controller.signal,
+          surfaceUnhandledThrows: true
+        });
+        if (!result.ok) throw result.error;
+        const unhandled = await tracker.findUnhandledRejection();
+        if (unhandled !== undefined)
+          throw new UnhandledRejectionError(unhandled.reason, unhandled.span);
+        if (controller.signal.aborted) throw new SandboxError("aborted");
+        return { returnValue: result.returnValue, stats: result.stats };
+      };
+      active = Promise.resolve().then(() =>
+        runResources.run(resources, () => withSandboxPromiseRejectionTracker(tracker, execute))
+      );
+      let failed = false;
+      try {
+        return await active;
+      } catch (error) {
+        failed = true;
+        const failure = controller.signal.aborted ? controller.signal.reason : error;
+        cancel();
+        throw failure;
+      } finally {
+        active = undefined;
+        signal?.removeEventListener("abort", cancel);
+        if (controller.signal.aborted) {
+          if (failed) await finish().catch(() => undefined);
+          else await finish();
+        }
+      }
+    },
+    async close() {
+      cancel();
+      await active?.catch(() => undefined);
+      await finish();
+    }
+  };
+}
