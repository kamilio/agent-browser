index 0000000..36c3fe3
--- /dev/null
+++ b/packages/safe-js/src/guest-reference.ts
@@ -0,0 +1,45 @@
+import type { HostObjectRegistry } from "./host-object.js";
+import type { SandboxValue } from "./interp/values.js";
+
+type HostOperation = { invoke(...args: readonly unknown[]): unknown }["invoke"];
+
+const argumentStarts = new WeakMap<object, number>();
+const references = new WeakMap<object, HostObjectRegistry>();
+
+export function retainGuestArguments<Operation extends HostOperation>(
+  operation: Operation,
+  from: number
+): Operation {
+  if (typeof operation !== "function" || !Number.isSafeInteger(from) || from < 0 || from > 65536)
+    throw new TypeError(
+      "Guest argument retention requires a function and a bounded argument index."
+    );
+  argumentStarts.set(operation, from);
+  return operation;
+}
+
+export function guestArgumentsFrom(operation: object): number | undefined {
+  return argumentStarts.get(operation);
+}
+
+export function captureGuestReference(value: SandboxValue, registry: HostObjectRegistry): object {
+  const reference = Object.freeze(Object.create(null)) as object;
+  references.set(reference, registry);
+  registry.references.set(reference, value);
+  return reference;
+}
+
+export function isGuestReference(value: unknown): value is object {
+  return typeof value === "object" && value !== null && references.has(value);
+}
+
+export function restoreGuestReference(value: object, registry?: HostObjectRegistry): SandboxValue {
+  const owner = references.get(value);
+  if (owner === undefined || owner !== registry || !owner.references.has(value))
+    throw new TypeError("Guest reference is released or belongs to another realm.");
+  return owner.references.get(value);
+}
+
+export function releaseGuestReference(value: unknown): boolean {
+  return isGuestReference(value) ? references.get(value)!.references.delete(value) : false;
+}
