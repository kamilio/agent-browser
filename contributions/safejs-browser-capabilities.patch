+  });
+
+  it("handles frozen arrays, holes, cycles and shared mutable elements exactly", () => {
+    const child: { value: string; parent?: unknown } = { value: "a" };
+    const array = Object.freeze([child, , child]);
+    child.parent = array;
+    const initial = measureSandboxData([array]);
+    child.value = "expanded";
+    expect(measureSandboxData([array, child])).toBe(initial + 7);
+  });
+
+  it("does not cache mutable collection contents when their wrappers are frozen", () => {
+    const map = createSandboxMap([]);
+    const set = createSandboxSet([]);
+    Object.freeze(map);
+    Object.freeze(set);
+    const initial = measureSandboxData([map, set]);
+    map.entries.set("name", "value");
+    set.values.add("entry");
+    expect(measureSandboxData([map, set])).toBe(initial + 16);
+  });
+
+  it("keeps closure captures live and respects per-call ignore options", () => {
+    let values: SandboxValue[] = ["a"];
+    const closure = createSandboxClosure({ call: () => undefined, properties: { fixed: "yes" }, retainedValues: () => values });
+    const initial = measureSandboxData([closure]);
+    values = ["longer"];
+    expect(measureSandboxData([closure])).toBe(initial + 5);
+    expect(measureSandboxData([closure], { ignoreClosures: true })).toBe(1);
+    expect(measureSandboxData([closure], { ignoreClosureCaptures: true })).toBe(initial - 1);
+    expect(measureSandboxData([closure])).toBe(initial + 5);
+  });
+
+  it("scans a shared capture source once per measurement while preserving repeated primitive charges", () => {
+    const owner = {};
+    const child = { text: "x" };
+    let calls = 0;
+    let captured: SandboxValue[] = [child, "abc"];
+    const retainedValues = () => { calls++; return captured; };
+    const first = createSandboxClosure({ call: () => undefined, retainedValues, retainedValuesIdentity: owner });
+    const second = createSandboxClosure({ call: () => undefined, retainedValues, retainedValuesIdentity: owner });
+    const expected = 2 + measureSandboxData([child]) + 6;
