+import { describe, expect, it, vi } from "vitest";
+import { createHostObject, createRealm, Budget } from "../core.js";
+import { guestFunctionProperties, registerGuestFunction, setGuestPrototype } from "./guest-objects.js";
+import { createSandboxClosure, createSandboxMap, createSandboxSet, measureSandboxData, type SandboxValue } from "./values.js";
+
+describe("exact immutable retained shapes", () => {
+  it("does not repeatedly reflect an unchanged frozen record", () => {
+    const record = Object.freeze({ text: "fixed", child: Object.freeze({ count: 3 }) });
+    const expected = measureSandboxData([record]);
+    const descriptors = vi.spyOn(Object, "getOwnPropertyDescriptors");
+    const descriptor = vi.spyOn(Object, "getOwnPropertyDescriptor");
+    const names = vi.spyOn(Object, "getOwnPropertyNames");
+    try {
+      expect(measureSandboxData([record])).toBe(expected);
+      expect(measureSandboxData([record])).toBe(expected);
+      const scans = [...descriptors.mock.calls, ...descriptor.mock.calls, ...names.mock.calls].filter(args => args[0] === record || args[0] === record.child);
+      expect(scans).toHaveLength(0);
+    } finally { descriptors.mockRestore(); descriptor.mockRestore(); names.mockRestore(); }
+  });
+
+  it("continues measuring mutable descendants and shared aliases beneath frozen parents", () => {
+    const child = { text: "a" };
+    const parent = Object.freeze({ child, alias: child });
+    const initial = measureSandboxData([parent, child]);
+    child.text = "longer";
+    expect(measureSandboxData([parent])).toBe(initial + 5);
+    expect(measureSandboxData([parent, parent, child])).toBe(initial + 5);
+  });
+
+  it("reuses immutable descriptors without hiding mutable fields or new expandos", () => {
+    let getterCalls = 0;
+    const record = Object.defineProperties({ changing: "a" }, {
+      fixed: { enumerable: true, get() { getterCalls++; return "not read"; } },
+    }) as { changing: string; extra?: string };
+    const initial = measureSandboxData([record]);
+    const descriptor = vi.spyOn(Object, "getOwnPropertyDescriptor");
+    try {
+      record.changing = "longer";
+      record.extra = "new";
+      expect(measureSandboxData([record])).toBe(initial + 14);
+      delete record.extra;
+      expect(measureSandboxData([record])).toBe(initial + 5);
+      expect(descriptor.mock.calls.filter(args => args[0] === record && args[1] === "fixed")).toHaveLength(0);
+      expect(getterCalls).toBe(0);
+    } finally { descriptor.mockRestore(); }
+  });
+
+  it("rechecks guest prototypes even when native properties are frozen", () => {
+    const record = Object.freeze({ value: 1 });
+    const initial = measureSandboxData([record]);
+    const prototype = { text: "prototype" };
+    setGuestPrototype(record, prototype);
+    expect(measureSandboxData([record])).toBe(initial + measureSandboxData([prototype]));
+    prototype.text += " changed";
+    expect(measureSandboxData([record])).toBe(initial + measureSandboxData([prototype]));
+    setGuestPrototype(record, null);
+    expect(measureSandboxData([record])).toBe(initial);
+  });
+
+  it("never invokes frozen accessors or changes hidden-property accounting", () => {
+    let calls = 0;
+    const record = Object.freeze(Object.defineProperties({}, {
+      visible: { enumerable: true, get() { calls++; return "not retained"; } },
+      hidden: { value: "hidden" },
+    }));
+    expect(measureSandboxData([record])).toBe(9);
+    expect(measureSandboxData([record])).toBe(9);
