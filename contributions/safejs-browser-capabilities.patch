+import { describe, expect, it } from "vitest";
+
+import { Budget, createHostObject, createRealm, startCallback } from "./core.js";
+
+describe("host callback phases", () => {
+  it("keeps callback identity stable across separate host calls", async () => {
+    const values: unknown[] = [];
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          values.push(value);
+        }
+      }
+    });
+    try {
+      await realm.evaluate("const listener = () => 1; save(listener);");
+      await realm.evaluate("save(listener);");
+      expect(values[0]).toBe(values[1]);
+    } finally {
+      await realm.close();
+    }
+  });
+  it("accounts for captured values retained only by registered host callbacks", async () => {
+    const retained: unknown[] = [];
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 100_000, dataSize: 3000 }),
+      bindings: {
+        save: (value) => {
+          retained.push(value);
+        }
+      }
+    });
+    try {
+      await expect(
+        realm.evaluate(
+          'function make(value) { const data = "x".repeat(400); save(() => data + value); } for (let index = 0; index < 12; index++) make(index);'
+        )
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally {
+      await realm.close();
+    }
+  });
+  it("finishes a synchronous guest body before signaling its synchronous phase", async () => {
+    let callback: unknown;
+    const trace: unknown[] = [];
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        record: (value) => {
+          trace.push(value);
+        }
+      }
+    });
+    try {
+      await realm.evaluate('save(() => { record("body"); return 42; });');
+      const invocation = startCallback(callback);
+      await invocation.synchronous;
+      expect(trace).toEqual(["body"]);
+      expect(await invocation.result).toBe(42);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not wait for an async listener's pending continuation", async () => {
+    let callback: unknown;
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const trace: unknown[] = [];
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        record: (value) => {
+          trace.push(value);
+        },
+        wait: () => pending
+      }
+    });
+    try {
+      await realm.evaluate(
+        'save(async () => { record("before"); await wait(); record("after"); return "complete"; });'
+      );
+      const invocation = startCallback(callback);
+      await invocation.synchronous;
+      trace.push("default action");
+      expect(trace).toEqual(["before", "default action"]);
+      release();
+      expect(await invocation.result).toBe("complete");
+      expect(trace).toEqual(["before", "default action", "after"]);
+    } finally {
+      release();
+      await realm.close();
+    }
+  });
+
+  it("does not await a promise returned by a non-async function's body", async () => {
+    let callback: unknown;
+    let release!: (value: number) => void;
+    const pending = new Promise<number>((resolve) => {
+      release = resolve;
+    });
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        wait: () => pending
+      }
+    });
+    try {
+      await realm.evaluate("save(() => wait());");
+      const invocation = startCallback(callback);
+      await invocation.synchronous;
+      release(7);
+      expect(await invocation.result).toBe(7);
+    } finally {
+      release(0);
+      await realm.close();
+    }
+  });
+
+  it("distinguishes a synchronous throw from an async function rejection", async () => {
+    for (const asynchronous of [false, true]) {
+      let callback: unknown;
+      const realm = createRealm({
+        bindings: {
+          save: (value) => {
+            callback = value;
+          }
+        }
+      });
+      try {
+        await realm.evaluate(
+          `save(${asynchronous ? "async " : ""}() => { throw new Error("listener failed"); });`
+        );
+        const invocation = startCallback(callback);
+        if (asynchronous) await expect(invocation.synchronous).resolves.toBeUndefined();
+        else await expect(invocation.synchronous).rejects.toBeDefined();
+        await expect(invocation.result).rejects.toMatchObject({ message: "listener failed" });
+      } finally {
+        await realm.close();
+      }
+    }
+  });
+
+  it("converts an explicit capability receiver and arguments without losing identity", async () => {
+    let callback: unknown;
+    const node = createHostObject({ properties: { id: { get: () => "receiver" } } });
+    const realm = createRealm({
+      bindings: {
+        node,
+        save: (value) => {
+          callback = value;
+        }
+      }
+    });
+    try {
+      await realm.evaluate(
+        "save(function (argument) { return this === node && argument === node; });"
+      );
+      const invocation = startCallback(callback, [node], { thisValue: node });
+      await invocation.synchronous;
+      expect(await invocation.result).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("allows another invocation after a previous async body suspends", async () => {
+    let callback: unknown;
+    const releases: ((value: number) => void)[] = [];
+    const budget = new Budget({ maxSteps: 100_000, maxCallDepth: 16 });
+    const realm = createRealm({
+      budget,
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        wait: () =>
+          new Promise<number>((resolve) => {
+            releases.push(resolve);
+          })
+      }
+    });
+    try {
+      await realm.evaluate("save(async () => await wait());");
+      const invocations = [];
+      for (let index = 0; index < 12; index += 1) {
+        const invocation = startCallback(callback);
+        await invocation.synchronous;
+        invocations.push(invocation);
+        expect(budget.currentCallDepth).toBe(index + 1);
+      }
+      expect(releases).toHaveLength(12);
+      releases.forEach((release, index) => release(index));
+      expect(await Promise.all(invocations.map((invocation) => invocation.result))).toEqual(
+        Array.from({ length: 12 }, (_, index) => index)
+      );
+    } finally {
+      releases.forEach((release) => release(0));
+      await realm.close();
+    }
+  });
+
+  it("rejects overlapping external prefixes and source evaluation", async () => {
+    let callback: unknown;
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        }
+      }
+    });
+    try {
+      await realm.evaluate(
+        "save(() => { let count = 0; for (let index = 0; index < 20; index++) count++; return count; });"
+      );
+      const invocation = startCallback(callback);
+      expect(() => startCallback(callback)).toThrow();
+      await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "reentry" });
+      await invocation.synchronous;
+      expect(await invocation.result).toBe(20);
+      expect((await realm.evaluate("2")).returnValue).toBe(2);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("cancels pending returned promises and revokes callbacks on realm close", async () => {
+    let callback: unknown;
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        }
+      }
+    });
+    await realm.evaluate("save(() => new Promise(() => {}));");
+    const invocation = startCallback(callback);
+    await invocation.synchronous;
+    const rejection = expect(invocation.result).rejects.toBeDefined();
+    await realm.close();
+    await rejection;
+    expect(() => startCallback(callback)).toThrow();
+  });
+
+  it("closes a realm on a fatal callback budget failure", async () => {
+    let callback: unknown;
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 100 }),
+      bindings: {
+        save: (value) => {
+          callback = value;
+        }
+      }
+    });
+    await realm.evaluate("save(() => { try { while (true) {} } catch (error) {} });");
+    const invocation = startCallback(callback);
+    await expect(invocation.synchronous).rejects.toMatchObject({ code: "budgetExceeded" });
+    await expect(invocation.result).rejects.toMatchObject({ code: "budgetExceeded" });
+    await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "aborted" });
+    await realm.close();
+  });
+
+  it("rejects unregistered host functions instead of treating them as guest callbacks", () => {
+    expect(() => startCallback(() => 1)).toThrow(TypeError);
+    expect(() => startCallback({})).toThrow(TypeError);
+  });
+
+  it("serializes resumed async bodies instead of interleaving interpreter steps", async () => {
+    let callback: unknown;
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const values: unknown[] = [];
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        wait: () => pending,
+        record: (value) => {
+          values.push(value);
+        }
+      }
+    });
+    try {
+      await realm.evaluate(
+        "let total = 0; save(async () => { await wait(); const previous = total; total = previous + 1; record(total); });"
+      );
+      const first = startCallback(callback);
+      await first.synchronous;
+      const second = startCallback(callback);
+      await second.synchronous;
+      release();
+      await Promise.all([first.result, second.result]);
+      expect(values).toEqual([1, 2]);
+      expect((await realm.evaluate("total")).returnValue).toBe(2);
+    } finally {
+      release();
+      await realm.close();
+    }
+  });
+
+  it("permits later source evaluation while a callback waits asynchronously", async () => {
+    let callback: unknown;
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const realm = createRealm({
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        wait: () => pending
+      }
+    });
+    try {
+      await realm.evaluate("let value = 1; save(async () => { await wait(); return value; });");
+      const invocation = startCallback(callback);
+      await invocation.synchronous;
+      await realm.evaluate("value = 2;");
+      release();
+      expect(await invocation.result).toBe(2);
+    } finally {
+      release();
+      await realm.close();
+    }
+  });
+
+  it("releases callback compilation and depth leases before close resolves", async () => {
+    let callback: unknown;
+    const budget = new Budget({ maxSteps: 10_000 });
+    const realm = createRealm({
+      budget,
+      bindings: {
+        save: (value) => {
+          callback = value;
+        },
+        wait: () => new Promise(() => undefined)
+      }
+    });
+    await realm.evaluate("save(async () => { await wait(); });");
+    const invocation = startCallback(callback);
+    await invocation.synchronous;
+    const rejected = expect(invocation.result).rejects.toBeDefined();
+    await realm.close();
+    await rejected;
+    expect(budget.currentCallDepth).toBe(0);
+    const next = createRealm({ budget });
+    expect((await next.evaluate("1")).returnValue).toBe(1);
+    await next.close();
+  });
+});
diff --git a/packages/safe-js/src/callback.ts b/packages/safe-js/src/callback.ts
new file mode 100644
index 0000000..cf558d7
--- /dev/null
+++ b/packages/safe-js/src/callback.ts
@@ -0,0 +1,113 @@
+import { Budget, SandboxError } from "./interp/budget.js";
+import { SandboxJobQueue } from "./interp/jobs.js";
+import type { CompileScope } from "./interp/regex/compile-guard.js";
+import type { SandboxClosure, SandboxValue } from "./interp/values.js";
+
+export type CallbackInvocation = {
+  synchronous: Promise<void>;
+  result: Promise<unknown>;
+};
+
+export type CallbackOptions = { thisValue?: unknown };
+export type CallbackControl = CallbackOptions & { synchronous(): void };
+
+type CallbackStart = (args: readonly unknown[], options: CallbackOptions) => CallbackInvocation;
+const callbacks = new WeakMap<object, CallbackStart>();
+
+export function startCallback(
+  callback: unknown,
+  args: readonly unknown[] = [],
+  options: CallbackOptions = {}
+): CallbackInvocation {
+  const start = typeof callback === "function" ? callbacks.get(callback) : undefined;
+  if (start === undefined) throw new TypeError("Expected a registered persistent-realm callback.");
+  if (!Array.isArray(args)) throw new TypeError("Callback arguments must be an array.");
+  return start(args, options);
+}
+
+export function registerHostCallback(callback: object, start: CallbackStart): void {
+  callbacks.set(callback, start);
+}
+
+export class CallbackRuntime {
+  readonly pending = new Set<Promise<unknown>>();
+  readonly retained = new Set<SandboxValue>();
+  wrappers = new WeakMap<SandboxClosure, (...args: readonly unknown[]) => Promise<unknown>>();
+  prefixes = 0;
+
+  constructor(
+    readonly options: {
+      budget: Budget;
+      jobs: SandboxJobQueue;
+      compilation: CompileScope;
+      signal: AbortSignal;
+      canStart(): boolean;
+      nested(): boolean;
+      run<Result>(execute: () => Result): Result;
+      fatal(error: SandboxError): void;
+    }
+  ) {}
+
+  start(
+    execute: (control: CallbackControl) => Promise<unknown>,
+    options: CallbackOptions
+  ): CallbackInvocation {
+    if (this.options.signal.aborted) throw new SandboxError("aborted");
+    if (!this.options.canStart() || (this.prefixes > 0 && !this.options.nested()))
+      throw new SandboxError("reentry");
+    this.options.budget.allocateArrayLength(this.pending.size + 1);
+    this.prefixes += 1;
+    let resolveSynchronous!: () => void;
+    let rejectSynchronous!: (error: unknown) => void;
+    let resolveResult!: (value: unknown) => void;
+    let rejectResult!: (error: unknown) => void;
+    let prefixDone = false;
+    const synchronous = new Promise<void>((resolve, reject) => {
+      resolveSynchronous = resolve;
+      rejectSynchronous = reject;
+    });
+    const result = new Promise<unknown>((resolve, reject) => {
+      resolveResult = resolve;
+      rejectResult = reject;
+    });
+    const completePrefix = () => {
+      if (prefixDone) return;
+      prefixDone = true;
+      this.prefixes -= 1;
+      resolveSynchronous();
+    };
+    const fail = (error: unknown) => {
+      if (!prefixDone) {
+        prefixDone = true;
+        this.prefixes -= 1;
+        rejectSynchronous(error);
+      }
+      rejectResult(error);
+      if (
+        error instanceof SandboxError &&
+        (error.code === "budgetExceeded" || error.code === "reentry")
+      )
+        this.options.fatal(error);
+    };
+    this.pending.add(result);
+    void synchronous.catch(() => undefined);
+    void result.then(
+      () => this.pending.delete(result),
+      () => this.pending.delete(result)
+    );
+    void this.options.jobs
+      .run(async () => {
+        if (this.options.signal.aborted) throw new SandboxError("aborted");
+        const completion = this.options.run(() =>
+          execute({ ...options, synchronous: completePrefix })
+        );
+        void completion.then((value) => {
+          completePrefix();
+          resolveResult(value);
+        }, fail);
+        await synchronous.catch(() => undefined);
+      })
+      .catch(fail);
+    return Object.freeze({ synchronous, result });
+  }
+}
