index 0000000..e1ec28a
--- /dev/null
+++ b/packages/safe-js/src/interp/cooperate.ts
@@ -0,0 +1,27 @@
+import { SandboxError } from "./budget.js";
+
+export type CooperativeCheckpoint = () => Promise<void> | undefined;
+
+export function createCooperativeCheckpoint(signal: AbortSignal): CooperativeCheckpoint {
+  let remaining = 256;
+  return () => {
+    if (signal.aborted) throw new SandboxError("aborted");
+    remaining -= 1;
+    if (remaining > 0) return undefined;
+    remaining = 256;
+    return new Promise<void>((resolve, reject) => {
+      const abort = () => {
+        clearTimeout(timer);
+        signal.removeEventListener("abort", abort);
+        reject(new SandboxError("aborted"));
+      };
+      const timer = setTimeout(() => {
+        signal.removeEventListener("abort", abort);
+        if (signal.aborted) reject(new SandboxError("aborted"));
+        else resolve();
+      }, 0);
+      signal.addEventListener("abort", abort, { once: true });
+      if (signal.aborted) abort();
+    });
+  };
+}
