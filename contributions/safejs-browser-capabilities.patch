+import { describe, expect, it, vi } from "vitest";
+import { Budget, createRealm, deepCopyFromSandbox } from "../core.js";
+import { run } from "../run.js";
+import { dump } from "../dump.js";
+import { encodeReplayData } from "../snapshot/replay-data.js";
+import { deepCopyToSandbox } from "./values.js";
+import { restore, type SafeJSSnapshot } from "../restore.js";
+import { serializeSafeJSSnapshot } from "../snapshot/dump-format.js";
+
+async function evaluate(source: string, now = () => 1700000000123) {
+  const realm = createRealm({ now });
+  try {
+    await realm.evaluate(source);
+    return deepCopyFromSandbox((await realm.evaluate("result")).returnValue);
+  } finally {
+    await realm.close();
+  }
