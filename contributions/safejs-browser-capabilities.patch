+import { afterEach, describe, expect, it, vi } from "vitest";
+import { parse } from "../parse.js";
+import { Budget } from "./budget.js";
+import { createCooperativeCheckpoint } from "./cooperate.js";
+import { interpret } from "./interpreter.js";
+
+describe("bounded host checkpoints", () => {
+  afterEach(() => vi.useRealTimers());
+
+  it("does no timer work for a short slice and yields at the exact node quota", async () => {
+    vi.useFakeTimers();
+    const checkpoint = createCooperativeCheckpoint(new AbortController().signal);
+    for (let index = 0; index < 255; index++) expect(checkpoint()).toBeUndefined();
+    expect(vi.getTimerCount()).toBe(0);
+    const pending = checkpoint();
+    expect(pending).toBeInstanceOf(Promise);
+    expect(vi.getTimerCount()).toBe(1);
+    await vi.advanceTimersByTimeAsync(0);
+    await pending;
+    expect(vi.getTimerCount()).toBe(0);
+    for (let index = 0; index < 255; index++) expect(checkpoint()).toBeUndefined();
+    const next = checkpoint();
+    await vi.advanceTimersByTimeAsync(0);
+    await next;
+  });
+
+  it("cancels and clears a pending host timer without waiting for its deadline", async () => {
+    vi.useFakeTimers();
+    const controller = new AbortController();
+    const add = vi.spyOn(controller.signal, "addEventListener");
+    const remove = vi.spyOn(controller.signal, "removeEventListener");
+    const checkpoint = createCooperativeCheckpoint(controller.signal);
+    for (let index = 0; index < 255; index++) checkpoint();
+    const pending = checkpoint();
+    const rejected = expect(pending).rejects.toMatchObject({ code: "aborted" });
+    controller.abort();
+    await rejected;
+    expect(vi.getTimerCount()).toBe(0);
+    expect(add).toHaveBeenCalledTimes(1);
+    expect(remove).toHaveBeenCalledWith("abort", add.mock.calls[0][1]);
+    expect(() => checkpoint()).toThrow("aborted");
+  });
+
+  it("removes the abort listener after a completed pause", async () => {
+    vi.useFakeTimers();
+    const controller = new AbortController();
+    const add = vi.spyOn(controller.signal, "addEventListener");
+    const remove = vi.spyOn(controller.signal, "removeEventListener");
+    const checkpoint = createCooperativeCheckpoint(controller.signal);
+    for (let index = 0; index < 255; index++) checkpoint();
+    const pending = checkpoint();
+    await vi.advanceTimersByTimeAsync(0);
+    await pending;
+    expect(remove).toHaveBeenCalledWith("abort", add.mock.calls[0][1]);
+    controller.abort();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("rejects pre-aborted work without creating a timer", () => {
+    vi.useFakeTimers();
+    const checkpoint = createCooperativeCheckpoint(AbortSignal.abort());
+    expect(() => checkpoint()).toThrow("aborted");
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("preserves interpreted results and exact guest step/data accounting", async () => {
+    const program = parse(`(() => { let total = 0; for (let index = 0; index < 80; index++) total += index; return total; })()`);
+    const baselineBudget = new Budget();
+    const baseline = await interpret(program, { budget: baselineBudget });
+    const budget = new Budget();
+    const cooperative = await interpret(program, {
+      budget,
+      cooperate: createCooperativeCheckpoint(new AbortController().signal),
+    });
+    expect(cooperative).toMatchObject({ ok: true, returnValue: 3160 });
+    expect(cooperative.stats).toEqual(baseline.stats);
+    expect(budget.stepsUsed).toBe(baselineBudget.stepsUsed);
+    expect(budget.currentDataSize).toBe(baselineBudget.currentDataSize);
+    expect(budget.peakDataSize).toBe(baselineBudget.peakDataSize);
+  });
+});
