+import { describe, expect, it } from "vitest";
+import { Budget, createRealm, startCallback } from "./core.js";
+
+describe("persistent realm host cooperation", () => {
+  it("allows a host timer to progress before a CPU-only script completes", async () => {
+    let hostProgress = false;
+    let observed = false;
+    const timer = setTimeout(() => { hostProgress = true; }, 0);
+    const realm = createRealm({ bindings: { observe: () => { observed = hostProgress; } } });
+    try {
+      await realm.evaluate(`let total = 0; for (let index = 0; index < 1000; index++) total += index; observe();`);
+      expect(observed).toBe(true);
+      expect((await realm.evaluate("total")).returnValue).toBe(499500);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("interrupts CPU-only code on host cancellation before exhausting its step budget", async () => {
+    const controller = new AbortController();
+    const effects: unknown[] = [];
+    const budget = new Budget({ maxSteps: 20000 });
+    const realm = createRealm({ budget, bindings: { record: value => { effects.push(value); } } });
+    const timer = setTimeout(() => controller.abort(), 0);
+    try {
+      await expect(realm.evaluate(`try { while (true) {} } catch (error) { record("catch"); } finally { record("finally"); }`, {
+        signal: controller.signal,
+      })).rejects.toMatchObject({ code: "aborted" });
+      expect(budget.stepsUsed).toBeLessThan(20000);
+      expect(effects).toEqual([]);
+      expect(realm.closed).toBe(true);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("does not run queued guest timer or promise callbacks inside synchronous page code", async () => {
+    const trace: unknown[] = [];
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let completed!: () => void;
+    let failed!: (error: unknown) => void;
+    const finished = new Promise<void>((resolve, reject) => { completed = resolve; failed = reject; });
+    void finished.catch(() => undefined);
+    const realm = createRealm({ bindings: {
+      later: callback => {
+        timer = setTimeout(() => {
+          trace.push("host timer");
+          try { void startCallback(callback).result.then(() => completed(), failed); }
+          catch (error) { failed(error); }
+        }, 0);
+      },
+      record: value => { trace.push(value); },
+    } });
+    try {
+      await realm.evaluate(`later(() => record("guest timer")); Promise.resolve().then(() => record("guest promise"));
+for (let index = 0; index < 1000; index++) {} record("script done");`);
+      await finished;
+      expect(trace).toEqual(["host timer", "script done", "guest promise", "guest timer"]);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("rejects external reentry during a host pause without killing the active script", async () => {
+    let reentry: unknown;
+    let attempted = false;
+    const realm = createRealm();
+    const timer = setTimeout(() => {
+      attempted = true;
+      void realm.evaluate("throw 1").catch(error => { reentry = error; });
+    }, 0);
+    try {
+      await realm.evaluate(`let total = 0; for (let index = 0; index < 1000; index++) total += index;`);
+      expect(attempted).toBe(true);
+      expect(reentry).toMatchObject({ code: "reentry" });
+      expect(realm.closed).toBe(false);
+      expect((await realm.evaluate("total")).returnValue).toBe(499500);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("preserves fatal step and retained-data limits", async () => {
+    const steps = createRealm({ budget: new Budget({ maxSteps: 300 }) });
+    const data = createRealm({ budget: new Budget({ dataSize: 2500 }) });
+    try {
+      await expect(steps.evaluate("while (true) {}"))
+        .rejects.toMatchObject({ code: "budgetExceeded", budget: "steps" });
+      await expect(data.evaluate(`let values = []; for (let index = 0; index < 50; index++) values.push("x".repeat(100));`))
+        .rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally { await steps.close(); await data.close(); }
+  });
+
+  it("lets lifetime close interrupt CPU-only code and revoke the realm", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 20000 }) });
+    let closing: Promise<void> | undefined;
+    const timer = setTimeout(() => { closing = realm.close(); }, 0);
+    try {
+      await expect(realm.evaluate("while (true) {}"))
+        .rejects.toMatchObject({ code: "aborted" });
+      await closing;
+      await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "aborted" });
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("also interrupts a host-retained CPU-only callback outside an active evaluation", async () => {
+    let callback: unknown;
+    const realm = createRealm({ budget: new Budget({ maxSteps: 20000 }), bindings: {
+      save: value => { callback = value; },
+    } });
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let closing: Promise<void> | undefined;
+    try {
+      await realm.evaluate("save(() => { while (true) {} });");
+      const invocation = startCallback(callback);
+      const rejected = expect(invocation.result).rejects.toBeDefined();
+      timer = setTimeout(() => { closing = realm.close(); }, 0);
+      await rejected;
+      await closing;
+      expect(realm.closed).toBe(true);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("does not execute a callback queued by a host timer when that timer cancels the realm", async () => {
+    const controller = new AbortController();
+    const effects: unknown[] = [];
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let callbackResult: Promise<unknown> | undefined;
+    const realm = createRealm({ budget: new Budget({ maxSteps: 20000 }), bindings: {
+      later: callback => {
+        timer = setTimeout(() => {
+          callbackResult = startCallback(callback).result;
+          void callbackResult.catch(() => undefined);
+          controller.abort();
+        }, 0);
+      },
+      record: value => { effects.push(value); },
+    } });
+    try {
+      await expect(realm.evaluate('later(() => record("late")); while (true) {}', { signal: controller.signal }))
+        .rejects.toMatchObject({ code: "aborted" });
+      await expect(callbackResult).rejects.toMatchObject({ code: "aborted" });
+      expect(effects).toEqual([]);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+
+  it("cancels CPU-only guest promise work while draining the realm job queue", async () => {
+    const controller = new AbortController();
+    const realm = createRealm({ budget: new Budget({ maxSteps: 20000 }) });
+    const timer = setTimeout(() => controller.abort(), 0);
+    try {
+      await expect(realm.evaluate("Promise.resolve().then(() => { while (true) {} });", {
+        signal: controller.signal,
+      })).rejects.toMatchObject({ code: "aborted" });
+      expect(realm.closed).toBe(true);
+    } finally { clearTimeout(timer); await realm.close(); }
+  });
+});
