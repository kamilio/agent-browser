+  type SandboxClosure,
+  type SandboxObject,
+  type SandboxValue,
+} from "../values.js";
+
+export function createObjectConstructor(properties: SandboxObject, budget: Budget): SandboxClosure {
+  const prototype = Object.create(null) as SandboxObject;
+  const construct = ([value]: readonly SandboxValue[]): SandboxValue => {
+    if (value === null || value === undefined)
+      return allocateProducedSandboxValue(Object.create(null), budget);
+    if (typeof value !== "object") throw new TypeError("Primitive object boxing is unsupported.");
+    return value;
+  };
+  const constructor = createSandboxClosure({
+    sandbox: true,
+    name: "Object",
+    length: 1,
+    call: construct,
+    construct,
+    properties: {
+      ...properties,
+      prototype,
+      create: createSandboxClosure({
+        sandbox: true,
+        name: "create",
+        length: 2,
+        call: ([parent, descriptors]) => {
+          if (descriptors !== undefined)
+            throw new TypeError("Object.create property descriptors are unsupported.");
+          const value = Object.create(null) as SandboxObject;
+          setGuestPrototype(value, parent);
+          return allocateProducedSandboxValue(value, budget);
+        },
+      }),
+      getPrototypeOf: createSandboxClosure({
+        sandbox: true,
+        name: "getPrototypeOf",
+        length: 1,
+        call: ([value]) => {
+          if (!isOrdinaryGuestObject(value))
+            throw new TypeError("Prototype reflection requires an ordinary guest object.");
+          return guestPrototype(value, budget) ?? null;
+        },
+      }),
+    },
+  });
+  const methods: SandboxObject = {
+    constructor,
+    toString: createSandboxClosure({
+      sandbox: true,
+      name: "toString",
+      length: 0,
+      call: (_args, context) => budget.allocateString(objectTag(context?.thisValue)),
+    }),
+    valueOf: createSandboxClosure({
+      sandbox: true,
+      name: "valueOf",
+      length: 0,
+      call: (_args, context) => {
+        const value = context?.thisValue;
+        if (typeof value !== "object" || value === null)
+          throw new TypeError(
+            "Object valueOf requires a guest object; primitive boxing is unsupported.",
+          );
+        return value;
+      },
+    }),
+    hasOwnProperty: createSandboxClosure({
+      sandbox: true,
+      name: "hasOwnProperty",
+      length: 1,
+      call: ([key], context) => inspectOwnProperty(context?.thisValue, key, budget, context, false),
+    }),
+    propertyIsEnumerable: createSandboxClosure({
+      sandbox: true,
+      name: "propertyIsEnumerable",
+      length: 1,
+      call: ([key], context) => inspectOwnProperty(context?.thisValue, key, budget, context, true),
+    }),
+    isPrototypeOf: createSandboxClosure({
+      sandbox: true,
+      name: "isPrototypeOf",
+      length: 1,
+      call: ([value], context) => {
+        if (typeof value !== "object" || value === null) return false;
+        if (context?.thisValue === null || context?.thisValue === undefined)
+          throw new TypeError("Prototype inspection requires a non-nullish receiver.");
+        const seen = new Set<object>();
+        let current = guestPrototype(value, budget);
+        while (current !== undefined) {
+          budget.visitNode();
+          if (seen.has(current)) throw new TypeError("Cyclic guest prototype chain.");
+          if (current === context.thisValue) return true;
+          seen.add(current);
+          current = guestPrototype(current, budget);
+        }
+        return false;
+      },
+    }),
+    toLocaleString: createSandboxClosure({
+      sandbox: true,
+      name: "toLocaleString",
+      length: 0,
+      call: (_args, context) => {
+        const value = context?.thisValue;
+        if (typeof value !== "object" || value === null)
+          throw new TypeError("Object locale conversion requires a guest object.");
+        const descriptor = findGuestProperty(value, "toString", budget)?.descriptor;
+        if (descriptor !== undefined && !("value" in descriptor))
+          throw new TypeError("Guest accessor conversion is unsupported.");
+        const method = descriptor?.value;
+        if (!isSandboxClosure(method) || context?.invokeClosure === undefined)
+          throw new TypeError("Object locale conversion requires a callable guest toString.");
+        return context.invokeClosure(method, [], value);
+      },
+    }),
+  };
+  for (const [name, value] of Object.entries(methods))
+    Object.defineProperty(prototype, name, { value, writable: true, configurable: true });
+  registerObjectPrototype(budget, prototype, constructor);
+  return constructor;
+}
+
+export function inspectOwnProperty(
+  value: SandboxValue,
+  key: SandboxValue,
+  budget: Budget,
+  context: SandboxCallContext | undefined,
+  enumerable: boolean,
+): boolean | Promise<boolean> {
+  const name = sandboxString(key, budget, context);
+  if (typeof name !== "string")
+    return name.then((property) => inspectOwnPropertyName(value, property, budget, enumerable));
+  return inspectOwnPropertyName(value, name, budget, enumerable);
+}
+
+function inspectOwnPropertyName(
+  value: SandboxValue,
+  name: string,
+  budget: Budget,
+  enumerable: boolean,
+): boolean {
+  if (value === null || value === undefined)
+    throw new TypeError("Own-property inspection requires a non-nullish receiver.");
+  budget.visitNode();
+  let descriptor: PropertyDescriptor | undefined;
+  const guest = guestFunctionProperties(value);
+  if (guest !== undefined) descriptor = Object.getOwnPropertyDescriptor(guest, name);
+  else if (isSandboxClosure(value)) {
+    if (name === "name" || name === "length") descriptor = { enumerable: false };
+    else if (value.properties !== undefined && Object.hasOwn(value.properties, name))
+      descriptor = { enumerable: false };
+  } else if (isSandboxRegex(value)) {
+    if (name === "lastIndex") descriptor = { enumerable: false };
+  } else if (
+    isSandboxMap(value) ||
+    isSandboxSet(value) ||
+    isSandboxPromise(value) ||
+    isSandboxGenerator(value)
+  ) {
+    descriptor = undefined;
+  } else descriptor = typeof value === "object"
+    ? liveHostOwnDescriptor(value, name) : Object.getOwnPropertyDescriptor(value, name);
+  return descriptor !== undefined && (!enumerable || descriptor.enumerable === true);
+}
+
+function objectTag(value: SandboxValue): string {
+  if (value === undefined) return "[object Undefined]";
+  if (value === null) return "[object Null]";
+  if (typeof value === "boolean") return "[object Boolean]";
+  if (typeof value === "number") return "[object Number]";
+  if (typeof value === "string") return "[object String]";
+  if (Array.isArray(value)) return "[object Array]";
+  if (isSandboxArguments(value)) return "[object Arguments]";
+  if (isSandboxClosure(value)) return value.async ? "[object AsyncFunction]" : "[object Function]";
+  if (isSandboxRegex(value)) return "[object RegExp]";
+  if (isSandboxDate(value)) return "[object Date]";
+  if (sandboxErrorTypes.has(value)) return "[object Error]";
+  if (isSandboxMap(value)) return "[object Map]";
+  if (isSandboxSet(value)) return "[object Set]";
+  if (isSandboxPromise(value)) return "[object Promise]";
+  if (isSandboxGenerator(value)) return "[object Generator]";
+  if (isFloat32Array(value)) return "[object Float32Array]";
+  return "[object Object]";
+}
