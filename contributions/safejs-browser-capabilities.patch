+import { describe, expect, it, vi } from "vitest";
+import {
+  Budget,
+  createHostObject,
+  createRealm,
+  deepCopyFromSandbox,
+  releaseGuestReference,
+  retainGuestArguments,
+  run,
+  startCallback
+} from "./core.js";
+
+describe("explicit retained guest arguments", () => {
+  it("preserves object identity and later mutations through a deferred callback", async () => {
+    let callback: unknown;
+    let argument: unknown;
+    const save = retainGuestArguments((fn, value) => {
+      callback = fn;
+      argument = value;
+    }, 1);
+    const realm = createRealm({ bindings: { save } });
+    try {
+      await realm.evaluate(
+        "let value = { count: 1 }; let same = false; save(function(item) { same = item === value; item.count++; }, value); value.count = 4;"
+      );
+      expect(Object.getPrototypeOf(argument)).toBeNull();
+      expect(Object.isFrozen(argument)).toBe(true);
+      expect(Object.keys(argument as object)).toEqual([]);
+      await startCallback(callback, [argument]).result;
+      expect(
+        deepCopyFromSandbox((await realm.evaluate("[same, value.count]")).returnValue)
+      ).toEqual([true, 5]);
+      expect(releaseGuestReference(argument)).toBe(true);
+      expect(releaseGuestReference(argument)).toBe(false);
+      await expect(startCallback(callback, [argument]).result).rejects.toBeDefined();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("preserves cycles, closures and primitive values without copying or invoking getters", async () => {
+    const saved: unknown[] = [];
+    const save = retainGuestArguments((...values) => {
+      saved.push(...values);
+    }, 0);
+    const realm = createRealm({
+      bindings: { save, first: () => saved[0], second: () => saved[1], third: () => saved[2] }
+    });
+    try {
+      await realm.evaluate(
+        "let value = {}; value.self = value; let callable = () => 42; save(value, callable, undefined);"
+      );
+      expect(
+        deepCopyFromSandbox(
+          (
+            await realm.evaluate(
+              "[first() === value, first().self === value, second() === callable, second()(), third() === undefined]"
+            )
+          ).returnValue
+        )
+      ).toEqual([true, true, true, 42, true]);
+    } finally {
+      saved.forEach(releaseGuestReference);
+      await realm.close();
+    }
+  });
+
+  it("works on live host methods while retaining ordinary leading arguments", async () => {
+    let saved: unknown;
+    const record = vi.fn((label, value) => {
+      saved = value;
+      return label;
+    });
+    const node = createHostObject({
+      methods: { save: retainGuestArguments(record, 1), read: () => saved }
+    });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      await realm.evaluate('let value = []; node.save("label", value)');
+      expect((await realm.evaluate("node.read() === value")).returnValue).toBe(true);
+      expect(record.mock.calls[0][0]).toBe("label");
+    } finally {
+      releaseGuestReference(saved);
+      await realm.close();
+    }
+  });
+
+  it("rejects cross-realm restoration and stale handles after close", async () => {
+    let saved: unknown;
+    const first = createRealm({
+      bindings: {
+        save: retainGuestArguments((value) => {
+          saved = value;
+        }, 0)
+      }
+    });
+    await first.evaluate("save({ secret: 1 })");
+    const second = createRealm({ bindings: { read: () => saved } });
+    await expect(second.evaluate("read()")).rejects.toBeDefined();
+    await second.close();
+    await first.close();
+    expect(releaseGuestReference(saved)).toBe(false);
+    const third = createRealm({ bindings: { read: () => saved } });
+    await expect(third.evaluate("read()")).rejects.toBeDefined();
+    await third.close();
+  });
+
+  it("rejects stale references passed back to their owning realm", async () => {
+    let saved: unknown;
+    const realm = createRealm({
+      bindings: {
+        save: retainGuestArguments((value) => {
+          saved = value;
+        }, 0),
+        read: () => saved
+      }
+    });
+    try {
+      await realm.evaluate("save({ value: 1 })");
+      releaseGuestReference(saved);
+      await expect(realm.evaluate("read()")).rejects.toBeDefined();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("bounds retained handles using the realm's collection budget", async () => {
+    const held: unknown[] = [];
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 1000, arrayLength: 2 }),
+      bindings: {
+        save: retainGuestArguments((value) => {
+          held.push(value);
+        }, 0)
+      }
+    });
+    try {
+      await realm.evaluate("save(1); save(2)");
+      await expect(realm.evaluate("save(3)")).rejects.toMatchObject({
+        code: "budgetExceeded",
+        budget: "arrayLength"
+      });
+      expect(held).toHaveLength(2);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("keeps captured data budgeted after guest scopes stop referencing it", async () => {
+    const budget = new Budget({ maxSteps: 10000, dataSize: 2000 });
+    const held: unknown[] = [];
+    const realm = createRealm({
+      budget,
+      bindings: {
+        save: retainGuestArguments((value) => {
+          held.push(value);
+        }, 0)
+      }
+    });
+    try {
+      await expect(
+        realm.evaluate(
+          'for (let index = 0; index < 30; index++) { save({ text: "x".repeat(100) }); }'
+        )
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+      expect(held.length).toBeGreaterThan(0);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("refuses ordinary run mode rather than silently copying retained arguments", async () => {
+    const save = vi.fn();
+    await expect(
+      run("save({ value: 1 })", { bindings: { save: retainGuestArguments(save, 0) } })
+    ).rejects.toBeDefined();
+    expect(save).not.toHaveBeenCalled();
+  });
+
+  it("validates explicit argument boundaries and ignores unrelated values on release", () => {
+    for (const from of [-1, 1.5, NaN, Infinity, 65537])
+      expect(() => retainGuestArguments(() => undefined, from)).toThrow();
+    expect(releaseGuestReference({})).toBe(false);
+    expect(releaseGuestReference(undefined)).toBe(false);
+  });
+
+  it("releases new handles when the native operation throws, even if the guest catches it", async () => {
+    let saved: unknown;
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 1000, arrayLength: 1 }),
+      bindings: {
+        reject: retainGuestArguments((value) => {
+          saved = value;
+          throw new Error("refused");
+        }, 0)
+      }
+    });
+    try {
+      await realm.evaluate(
+        "for (let index = 0; index < 5; index++) { try { reject({}); } catch (error) {} }"
+      );
+      expect(releaseGuestReference(saved)).toBe(false);
+      expect(realm.closed).toBe(false);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("can release one of two handles for the same value without revoking the other", async () => {
+    const saved: unknown[] = [];
+    const realm = createRealm({
+      bindings: {
+        save: retainGuestArguments((...values) => {
+          saved.push(...values);
+        }, 0),
+        read: () => saved[1]
+      }
+    });
+    try {
+      await realm.evaluate("let value = { same: true }; save(value, value)");
+      expect(saved[0]).not.toBe(saved[1]);
+      releaseGuestReference(saved[0]);
+      expect((await realm.evaluate("read() === value")).returnValue).toBe(true);
+    } finally {
+      saved.forEach(releaseGuestReference);
+      await realm.close();
+    }
+  });
+});
diff --git a/packages/safe-js/src/guest-reference.ts b/packages/safe-js/src/guest-reference.ts
