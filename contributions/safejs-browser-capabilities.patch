+import { describe, expect, it } from "vitest";
+import { Budget, createHostObject, createRealm, deepCopyFromSandbox } from "../core.js";
+import { encodeReplayData } from "../snapshot/replay-data.js";
+import { run } from "../run.js";
+import { dump } from "../dump.js";
+import type { SandboxValue } from "./values.js";
+
+async function evaluate(source: string) {
+  const realm = createRealm();
+  try {
+    await realm.evaluate(source);
+    return deepCopyFromSandbox((await realm.evaluate("result")).returnValue);
+  } finally {
+    await realm.close();
+  }
+}
+
+describe("sandbox-owned Object prototype", () => {
+  it.each([
+    { source: "undefined", value: undefined },
+    { source: "null", value: null },
+    { source: "true", value: true },
+    { source: "3", value: 3 },
+    { source: '"text"', value: "text" },
+    { source: "[]", value: [] },
+    { source: "{}", value: {} },
+    { source: "function() {}", value: function example() {} },
+    { source: "/x/", value: /x/ },
+    { source: 'new Error("test")', value: new Error("test") },
+    { source: "new Map()", value: new Map() },
+    { source: "new Set()", value: new Set() },
+    { source: "new Float32Array(2)", value: new Float32Array(2) },
+    { source: "Object.create(null)", value: Object.create(null) },
+  ])("matches native type inspection for $source", async ({ source, value }) => {
+    const expected = Reflect.apply(Object.prototype.toString, value, []);
+    expect(await evaluate(`let result = Object.prototype.toString.call(${source});`)).toBe(
+      expected,
+    );
+  });
+
+  it("supports cached type inspection without exposing native constructors", async () => {
+    expect(
+      await evaluate(`let inspect = ({}).toString;
+let result = [inspect === Object.prototype.toString,
+inspect.call(undefined), inspect.call(null), inspect.call(true), inspect.call(3),
+inspect.call("text"), inspect.call([]), inspect.call({}), inspect.call(function() {}),
+inspect.call(/x/), inspect.call(new Error("test")), inspect.call(new Map()),
+inspect.call(new Set()), inspect.call(Promise.resolve(1)), typeof inspect.constructor];`),
+    ).toEqual([
+      true,
+      "[object Undefined]",
+      "[object Null]",
+      "[object Boolean]",
+      "[object Number]",
+      "[object String]",
+      "[object Array]",
+      "[object Object]",
+      "[object Function]",
+      "[object RegExp]",
+      "[object Error]",
+      "[object Map]",
+      "[object Set]",
+      "[object Promise]",
+      "undefined",
+    ]);
+  });
+
+  it("identifies guest arguments and ignores spoofed internal fields", async () => {
+    expect(
+      await evaluate(`let inspect = Object.prototype.toString;
+function inspectArguments() { return inspect.call(arguments); }
+let result = [inspectArguments(), inspect.call({ kind: "fn", name: "Error" }),
+inspect.call(new Float32Array(2)), inspect.call((function*() {})())];`),
+    ).toEqual([
+      "[object Arguments]",
+      "[object Object]",
+      "[object Float32Array]",
+      "[object Generator]",
+    ]);
+  });
+
+  it("does not report interpreter implementation fields as guest own properties", async () => {
+    expect(
+      await evaluate(`let own = Object.prototype.hasOwnProperty;
+let enumerable = Object.prototype.propertyIsEnumerable;
+let result = [own.call(/x/, "kind"), own.call(/x/, "lastIndex"), enumerable.call(/x/, "lastIndex"),
+own.call(new Map(), "entries"), own.call(new Set(), "values"),
+own.call(Promise.resolve(1), "promise"), own.call((function*() {})(), "channel"),
+Object.hasOwn(/x/, "source")];`),
+    ).toEqual([false, true, false, false, false, false, false, false]);
+  });
+
+  it("distinguishes literal null/custom prototypes from an own computed __proto__ field", async () => {
+    expect(
+      await evaluate(`let parent = { inherited: 42 };
+let empty = { __proto__: null }; let child = { __proto__: parent };
+let computed = { ["__proto__"]: 3 };
+let result = [Object.getPrototypeOf(empty), empty.toString, child.inherited,
+Object.getPrototypeOf(child) === parent, computed["__proto__"],
+Object.getPrototypeOf(computed) === Object.prototype];`),
+    ).toEqual([null, undefined, 42, true, 3, true]);
+  });
+
+  it("gives ordinary objects a stable sandbox constructor and prototype", async () => {
+    expect(
+      await evaluate(`let original = { value: 3 }; let created = new Object();
+let result = [typeof Object, ({}).constructor === Object, Object(original) === original,
+Object.getPrototypeOf(original) === Object.prototype, Object.getPrototypeOf(Object.prototype),
+original instanceof Object, created instanceof Object, Object.keys(Object.prototype)];`),
+    ).toEqual(["function", true, true, true, null, true, true, []]);
+  });
+
+  it("supports null and custom prototypes without native prototype mutation", async () => {
+    expect(
+      await evaluate(`let empty = Object.create(null); empty.answer = 1;
+let parent = { answer: 42 }; let child = Object.create(parent); child.own = 2;
+let result = [Object.getPrototypeOf(empty), empty.toString, "toString" in empty,
+Object.getPrototypeOf(child) === parent, child.answer, "toString" in child,
+parent.isPrototypeOf(child), Object.prototype.isPrototypeOf(child),
+Object.keys(child), child.hasOwnProperty("answer"), child.hasOwnProperty("own")];`),
+    ).toEqual([null, undefined, false, true, 42, true, true, true, ["own"], false, true]);
+  });
+
+  it("keeps own-property inspection generic, non-enumerable aware and private-field safe", async () => {
+    expect(
+      await evaluate(`function Example(value) {} Example.visible = 1;
+let hasOwn = ({}).hasOwnProperty; let enumerable = ({}).propertyIsEnumerable;
+let result = [hasOwn.call(Example, "length"), hasOwn.call(Example, "kind"),
+hasOwn.call(Object.keys, "call"), hasOwn.call("abc", 1), enumerable.call("abc", 1),
+enumerable.call(Example, "length"), enumerable.call(Example, "visible"),
+enumerable.call([], "length"), Object.hasOwn(Example, "kind")];`),
+    ).toEqual([true, false, false, true, true, false, true, false, false]);
+  });
+
+  it("does not enumerate native intrinsic property tables as guest properties", async () => {
+    expect(
+      await evaluate(`let enumerable = Object.prototype.propertyIsEnumerable;
+let result = [enumerable.call(Object, "prototype"), enumerable.call(Object, "keys"),
+Object.hasOwn(Object, "prototype"), Object.hasOwn(Object, "keys")];`),
+    ).toEqual([false, false, true, true]);
+  });
+
+  it("uses guest key conversion and rejects nullish inspection receivers", async () => {
+    expect(
+      await evaluate(`let count = 0;
+let key = { toString() { count++; return "value"; } };
+let target = { value: 1 }; let first = target.hasOwnProperty(key);
+let second = Object.hasOwn(target, key); let rejected = 0;
+try { Object.prototype.hasOwnProperty.call(null, "value"); } catch (error) { rejected++; }
+try { Object.prototype.propertyIsEnumerable.call(undefined, "value"); } catch (error) { rejected++; }
+let result = [first, second, count, rejected];`),
+    ).toEqual([true, true, 2, 2]);
+  });
+
+  it("keeps static and prototype own-property receiver/key conversion order distinct", async () => {
+    expect(
+      await evaluate(`let calls = 0;
+let key = { toString() { calls++; return "value"; } };
+try { Object.hasOwn(null, key); } catch (error) {}
+let staticCalls = calls;
+try { Object.prototype.hasOwnProperty.call(null, key); } catch (error) {}
+let result = [staticCalls, calls];`),
+    ).toEqual([0, 1]);
+  });
+
+  it("preserves valueOf identity and dynamically calls guest toString for locale conversion", async () => {
+    expect(
+      await evaluate(`let value = { count: 0, toString() { this.count++; return "custom"; } };
+let result = [value.valueOf() === value, value.toLocaleString(), value.count,
+({}).toLocaleString(), Object.prototype.valueOf.call(function() {}) instanceof Object];`),
+    ).toEqual([true, "custom", 1, "[object Object]", false]);
+  });
+
+  it("propagates prototype mutations within one realm without polluting another or native objects", async () => {
+    const first = createRealm();
+    const second = createRealm();
+    try {
+      await first.evaluate("Object.prototype.inheritedMarker = 42;");
+      expect((await first.evaluate("({}).inheritedMarker")).returnValue).toBe(42);
+      expect((await second.evaluate("({}).inheritedMarker")).returnValue).toBeUndefined();
+      expect(Object.hasOwn(Object.prototype, "inheritedMarker")).toBe(false);
+      await first.evaluate("delete Object.prototype.inheritedMarker;");
+      expect((await first.evaluate("({}).inheritedMarker")).returnValue).toBeUndefined();
+    } finally {
+      await first.close();
+      await second.close();
+    }
+  });
+
+  it("shadows inherited methods and respects prototype enumeration and freezing", async () => {
+    expect(
+      await evaluate(`Object.prototype.inherited = 1;
+let target = {}; target.toString = function() { return "own"; };
+let keys = []; for (let key in target) keys.push(key);
+let value = target.toString(); delete target.toString;
+Object.freeze(Object.prototype); let rejected = false;
+try { target.inherited = 2; } catch (error) { rejected = true; }
+let result = [value, target.toString(), keys, rejected, target.inherited];`),
+    ).toEqual(["own", "[object Object]", ["toString", "inherited"], true, 1]);
+  });
+
+  it("rejects unsupported boxing, descriptors and exotic prototype reflection explicitly", async () => {
+    expect(
+      await evaluate(`let rejected = 0;
+try { Object(1); } catch (error) { rejected++; }
+try { Object.create({}, { answer: { value: 42 } }); } catch (error) { rejected++; }
+try { Object.getPrototypeOf([]); } catch (error) { rejected++; }
+try { Object.prototype.valueOf.call(1); } catch (error) { rejected++; }
+let result = rejected;`),
+    ).toBe(4);
+  });
+
+  it("does not invoke or expose a live host grant through prototype reflection", async () => {
+    let reads = 0;
+    const realm = createRealm({
+      bindings: {
+        host: createHostObject({
+          properties: {
+            value: {
+              get: () => {
+                reads++;
+                return 1;
+              },
+            },
+          },
+        }),
+      },
+    });
+    try {
+      expect((await realm.evaluate("Object.prototype.toString.call(host)")).returnValue).toBe(
+        "[object Object]",
+      );
+      expect(reads).toBe(0);
+      await expect(realm.evaluate("Object.getPrototypeOf(host)")).rejects.toThrow();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("charges prototype-retained values even when no guest variable holds the prototype", async () => {
+    const realm = createRealm({ budget: new Budget({ dataSize: 16_384, arrayLength: 16_384 }) });
+    try {
+      await expect(
+        realm.evaluate(
+          "for (let index = 0; index < 4; index++) Object.prototype['payload' + index] = new Array(6000).fill(42);",
+        ),
+      ).rejects.toMatchObject({ code: "budgetExceeded" });
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("refuses replay copies that would discard intrinsic or explicit null prototype state", async () => {
+    const realm = createRealm();
+    try {
+      for (const source of ["Object.prototype", "Object.create(null)"]) {
+        const value = (await realm.evaluate(source)).returnValue as SandboxValue;
+        expect(() => encodeReplayData(value)).toThrow(/prototype/);
+      }
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not silently omit changed intrinsic state from a public run dump", async () => {
+    const result = await run("Object.prototype.marker = 42; return ({}).marker;");
+    expect(result).toMatchObject({ ok: true, returnValue: 42 });
+    await expect(dump(result)).rejects.toThrow(/prototype/);
+  });
+
+  it("releases intrinsic retention and isolates sequential realms sharing a budget", async () => {
+    const budget = new Budget();
+    const first = createRealm({ budget });
+    await first.evaluate("Object.prototype.marker = [42];");
+    await first.close();
+    expect([...budget.retainedValues()]).toEqual([]);
+    const second = createRealm({ budget });
