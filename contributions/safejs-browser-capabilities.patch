+import { describe, expect, it, vi } from "vitest";
+
+import { createHostObject, createRealm } from "./core.js";
+import { Budget } from "./interp/budget.js";
+import { deepCopyFromSandbox } from "./interp/values.js";
+import { run } from "./run.js";
+import { serialize } from "./snapshot/serialize.js";
+
+describe("explicit live host objects", () => {
+  it("does not invoke an ordinary then accessor during promise detection", async () => {
+    const getter = vi.fn(() => undefined);
+    const ordinary = Object.defineProperty({}, "then", { get: getter, enumerable: true });
+    const node = createHostObject({ properties: { value: { get: () => ordinary } } });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      await expect(realm.evaluate("node.value")).rejects.toBeDefined();
+      expect(getter).not.toHaveBeenCalled();
+    } finally {
+      await realm.close();
+    }
+  });
+  it("reads and writes live properties across evaluations", async () => {
+    let text = "before";
+    const node = createHostObject({
+      properties: {
+        textContent: {
+          get: () => text,
+          set: (value) => {
+            text = String(value);
+          }
+        }
+      }
+    });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      expect((await realm.evaluate("node.textContent")).returnValue).toBe("before");
+      await realm.evaluate('node.textContent = "after";');
+      expect(text).toBe("after");
+      text = "host change";
+      expect((await realm.evaluate("node.textContent")).returnValue).toBe("host change");
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("preserves identity across nested lookups, methods, cycles and host round trips", async () => {
+    let child: ReturnType<typeof createHostObject>;
+    const parent = createHostObject({
+      properties: { firstChild: { get: () => child } },
+      methods: { query: () => child, accepts: (value) => value === child }
+    });
+    child = createHostObject({ properties: { parentNode: { get: () => parent } } });
+    const realm = createRealm({ bindings: { parent } });
+    try {
+      await realm.evaluate("const child = parent.query();");
+      expect(
+        deepCopyFromSandbox(
+          (
+            await realm.evaluate(
+              "[child === parent.query(), child === parent.firstChild, child.parentNode === parent, parent.accepts(child)]"
+            )
+          ).returnValue
+        )
+      ).toEqual([true, true, true, true]);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("passes original capabilities to setters and nested method arguments", async () => {
+    const target = createHostObject({});
+    const setter = vi.fn();
+    const accept = vi.fn();
+    const root = createHostObject({
+      properties: { selected: { get: () => target, set: setter } },
+      methods: { accept }
+    });
+    const realm = createRealm({ bindings: { root } });
+    try {
+      await realm.evaluate(
+        "root.selected = root.selected; root.accept({ nested: [root.selected] });"
+      );
+      expect(setter).toHaveBeenCalledExactlyOnceWith(target);
+      expect(accept.mock.calls[0][0].nested[0]).toBe(target);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("supports property updates, Object.assign and guest expandos", async () => {
+    let count = 1;
+    const counter = createHostObject({
+      properties: {
+        value: {
+          get: () => count,
+          set: (value) => {
+            count = Number(value);
+          }
+        }
+      }
+    });
+    const realm = createRealm({ bindings: { counter } });
+    try {
+      await realm.evaluate(
+        "counter.value++; counter.value += 2; Object.assign(counter, { value: 9 }); counter.note = 'local';"
+      );
+      expect(count).toBe(9);
+      expect((await realm.evaluate("counter.note")).returnValue).toBe("local");
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("enumerates keys without invoking getters and spreads explicit values", async () => {
+    const getter = vi.fn(() => "text");
+    const node = createHostObject({ properties: { text: { get: getter } } });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      expect(deepCopyFromSandbox((await realm.evaluate("Object.keys(node)")).returnValue)).toEqual([
+        "text"
+      ]);
+      expect(getter).not.toHaveBeenCalled();
+      expect(deepCopyFromSandbox((await realm.evaluate("({ ...node })")).returnValue)).toEqual({
+        text: "text"
+      });
+      expect(getter).toHaveBeenCalledTimes(1);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("keeps protected members read-only and rejects detached method receivers", async () => {
+    const node = createHostObject({
+      properties: { id: { get: () => "fixed" } },
+      methods: { read: () => "read" }
+    });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      expect(
+        (
+          await realm.evaluate(
+            'let errors = 0; try { node.id = "changed"; } catch (error) { errors += 1; } try { const detached = node.read; detached(); } catch (error) { errors += 1; }'
+          )
+        ).returnValue
+      ).toBeUndefined();
+      expect((await realm.evaluate("errors")).returnValue).toBe(2);
+      expect((await realm.evaluate("node.read()")).returnValue).toBe("read");
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("returns live capabilities from asynchronous methods", async () => {
+    const child = createHostObject({ properties: { text: { get: () => "ready" } } });
+    const root = createHostObject({ methods: { child: async () => child } });
+    const realm = createRealm({ bindings: { root } });
+    try {
+      await realm.evaluate("const child = await root.child();");
+      expect((await realm.evaluate("child === await root.child()")).returnValue).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("crosses callback arguments and return values by capability identity", async () => {
+    const node = createHostObject({ properties: { id: { get: () => "node" } } });
+    const root = createHostObject({
+      methods: {
+        visit: async (callback: unknown) => (callback as (value: unknown) => Promise<unknown>)(node)
+      }
+    });
+    const realm = createRealm({ bindings: { root, node } });
+    try {
+      expect(
+        (
+          await realm.evaluate(
+            "await root.visit((value) => value === node ? value : null) === node"
+          )
+        ).returnValue
+      ).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not deep-copy or snapshot live capabilities, even empty ones", async () => {
+    const getter = vi.fn(() => "private");
+    const node = createHostObject({ properties: { text: { get: getter } } });
+    const empty = createHostObject({});
+    const realm = createRealm({ bindings: { node, empty } });
+    try {
+      const value = (await realm.evaluate("node")).returnValue as { text: string };
+      expect(() => deepCopyFromSandbox(value)).toThrow(/live host object/i);
+      const emptyValue = (await realm.evaluate("empty")).returnValue;
+      expect(() => deepCopyFromSandbox(emptyValue)).toThrow(/live host object/i);
+      expect(() =>
+        serialize({
+          source: "node",
+          currentAstNodeId: 1,
+          scopeChain: [{ id: 1, bindings: { node: value } }],
+          callStack: [],
+          pendingPromises: [],
+          moduleBindings: {}
+        })
+      ).toThrow(/live host object/i);
+      expect(getter).not.toHaveBeenCalled();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not enable ordinary host accessors or lookalike declarations", async () => {
+    const getter = vi.fn(() => "secret");
+    const ordinary = Object.defineProperty({}, "secret", { enumerable: true, get: getter });
+    expect(() => createRealm({ bindings: { ordinary } })).toThrow(/accessor/);
+    expect(getter).not.toHaveBeenCalled();
+    const lookalike = { properties: { secret: { get: () => "not automatically invoked" } } };
+    const realm = createRealm({ bindings: { lookalike } });
+    try {
+      expect((await realm.evaluate("lookalike.secret")).returnValue).toBeUndefined();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("requires explicit realm support rather than silently copying in run", async () => {
+    const node = createHostObject({});
+    await expect(run("node", { bindings: { node } })).rejects.toThrow(/persistent realm/i);
+  });
+
+  it("revokes getters, setters and methods on close", async () => {
+    const get = vi.fn(() => "value");
+    const set = vi.fn();
+    const method = vi.fn();
+    const node = createHostObject({ properties: { value: { get, set } }, methods: { method } });
+    const realm = createRealm({ bindings: { node } });
+    const value = (await realm.evaluate("node")).returnValue as Record<string, unknown>;
+    await realm.close();
+    expect(() => value.value).toThrow();
+    expect(() => {
+      value.value = "new";
+    }).toThrow();
+    expect(get).not.toHaveBeenCalled();
+    expect(set).not.toHaveBeenCalled();
+    expect(method).not.toHaveBeenCalled();
+  });
+
+  it("budgets a stream of distinct live wrappers", async () => {
+    const root = createHostObject({
+      methods: { next: () => createHostObject({ properties: { value: { get: () => 1 } } }) }
+    });
+    const realm = createRealm({
+      bindings: { root },
+      budget: new Budget({ maxSteps: 100_000, dataSize: 2000 })
+    });
+    try {
+      await expect(
+        realm.evaluate("for (let index = 0; index < 500; index += 1) { root.next(); }")
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("rejects accessor and proxy definitions without invoking traps", () => {
+    const getter = vi.fn();
+    expect(() =>
+      createHostObject(Object.defineProperty({}, "properties", { get: getter }))
+    ).toThrow(/accessor/);
+    expect(getter).not.toHaveBeenCalled();
+    const trap = vi.fn();
+    expect(() => createHostObject(new Proxy({}, { get: trap }))).toThrow(/plain/);
+    expect(trap).not.toHaveBeenCalled();
+    for (const name of ["constructor", "prototype", "__proto__"]) {
+      expect(() => createHostObject({ properties: { [name]: { get: () => undefined } } })).toThrow(
+        /prototype/
+      );
+    }
+  });
+
+  it("does not invoke ordinary accessors returned by a granted getter", async () => {
+    const getter = vi.fn(() => "secret");
+    const ordinary = Object.defineProperty({}, "secret", { get: getter, enumerable: true });
+    const node = createHostObject({ properties: { child: { get: () => ordinary } } });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      await expect(realm.evaluate("node.child")).rejects.toBeDefined();
+      expect(getter).not.toHaveBeenCalled();
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("rejects implicit copying and protects members from deletion or replacement", async () => {
+    const getter = vi.fn(() => "id");
+    const node = createHostObject({
+      properties: { id: { get: getter } },
+      methods: { read: () => "read" }
+    });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      await realm.evaluate(
+        'let errors = 0; try { structuredClone(node); } catch (error) { errors++; } try { delete node.id; } catch (error) { errors++; } try { node.read = () => "fake"; } catch (error) { errors++; }'
+      );
+      expect((await realm.evaluate("errors")).returnValue).toBe(3);
+      expect(getter).not.toHaveBeenCalled();
+      expect((await realm.evaluate("node.read()")).returnValue).toBe("read");
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("projects getter failures and keeps fatal budgets uncatchable", async () => {
+    const failure = new Error("read failed");
+    const node = createHostObject({
+      properties: {
+        value: {
+          get: () => {
+            throw failure;
+          }
+        }
+      }
+    });
+    const realm = createRealm({ bindings: { node } });
+    try {
+      await realm.evaluate(
+        'let message = ""; try { node.value; } catch (error) { message = error.message; }'
+      );
+      expect((await realm.evaluate("message")).returnValue).toBe("read failed");
+    } finally {
+      await realm.close();
+    }
+    const large = createHostObject({ properties: { value: { get: () => "x".repeat(1000) } } });
+    const limited = createRealm({ bindings: { large }, budget: new Budget({ stringLength: 100 }) });
+    try {
+      await expect(
+        limited.evaluate("try { large.value; } catch (error) {} ")
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "stringLength" });
+    } finally {
+      await limited.close();
+    }
+  });
+
+  it("keeps guest expandos isolated between realms granting the same capability", async () => {
+    const node = createHostObject({});
+    const first = createRealm({ bindings: { node } });
+    const second = createRealm({ bindings: { node } });
+    try {
+      await first.evaluate("node.privateValue = 1;");
+      expect((await second.evaluate("node.privateValue")).returnValue).toBeUndefined();
+    } finally {
+      await Promise.all([first.close(), second.close()]);
+    }
