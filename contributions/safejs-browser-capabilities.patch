+import { describe, expect, it } from "vitest";
+
+import { createRealm } from "../core.js";
+import { parseModule } from "./parser.js";
+
+describe("single-statement terminators", () => {
+  it.each([
+    "do count++; while (count < 2);",
+    "do var count = 1; while (false);",
+    "do break; while (true);",
+    "do continue; while (false);",
+    "do throw 'stop'; while (false);",
+    "function select() { do return 1; while (false); }",
+    "function select() { do if (ready) return 1; while (false); }",
+    "do if (ready) count++; else count--; while (false);",
+    "do while (false) count++; while (false);",
+    "do for (;;) break; while (false);",
+    "do do count++; while (false); while (false);",
+    "do ; while (false);",
+    "do {} while (false);",
+    "if (ready); else count++;"
+  ])("consumes a body's own terminator: %s", (source) => {
+    expect(() => parseModule(source)).not.toThrow();
+  });
+
+  it.each([
+    "do count++;; while (false);",
+    "do ;; while (false);",
+    "do {}; while (false);",
+    "if (ready);; else count++;",
+    "if (ready) count++;; else count++;"
+  ])("does not consume an unrelated empty statement: %s", (source) => {
+    expect(() => parseModule(source)).toThrow();
+  });
+
+  it("executes nested unbraced do/if bodies without losing their boundaries", async () => {
+    const realm = createRealm();
+    try {
+      await realm.evaluate(
+        "let count = 0; do if (count < 2) count++; else break; while (true); function select() { do if (count === 2) return 7; while (false); return 0; }"
+      );
+      expect((await realm.evaluate("count + select()")).returnValue).toBe(9);
+    } finally {
+      await realm.close();
+    }
+  });
+});
