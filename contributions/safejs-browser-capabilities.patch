+    const second = createSandboxClosure({ call: () => undefined, retainedValues });
+    expect(measureSandboxData([first, second])).toBe(8);
+    expect(calls).toBe(2);
+  });
+
+  it("sees guest function properties registered or changed after shape warming", () => {
+    const closure = createSandboxClosure({ call: () => undefined });
+    expect(measureSandboxData([closure])).toBe(1);
+    registerGuestFunction(closure, true);
+    const properties = guestFunctionProperties(closure);
+    if (!properties) throw new Error("Missing function properties");
+    const initial = measureSandboxData([closure]);
+    properties.extra = "retained";
+    expect(measureSandboxData([closure])).toBe(initial + 14);
+    delete properties.extra;
+    expect(measureSandboxData([closure])).toBe(initial);
+  });
+
+  it("does not undercount a mutable guest value retained by an unchanged host wrapper", async () => {
+    const host = createHostObject({ methods: { touch: () => undefined } });
+    const budget = new Budget({ maxSteps: 100_000, dataSize: 10_000, arrayLength: 10_000 });
+    const realm = createRealm({ bindings: { host }, budget });
+    try {
+      await realm.evaluate("let child = { text: 'small' }; let parent = Object.freeze({ child });");
