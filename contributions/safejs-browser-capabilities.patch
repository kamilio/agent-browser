+import { describe, expect, it } from "vitest";
+import { Budget, createHostObject, createRealm, deepCopyFromSandbox } from "./core.js";
+import { liveHostOwnDescriptor } from "./host-object.js";
+
+describe("bounded named host properties", () => {
+  it("reads dynamic names without replacing the capability and preserves value identity", async () => {
+    const child = createHostObject({ properties: { value: { get: () => 42 } } });
+    const values = new Map<string, unknown>([["first", child]]);
+    const named = createHostObject({ named: { maxKeys: 4, maxKeyCodeUnits: 40, keys: () => [...values.keys()], get: name => values.get(name) } });
+    const realm = createRealm({ bindings: { named, child } });
+    try {
+      expect((await realm.evaluate("named.first === child && !('next' in named)")).returnValue).toBe(true);
+      values.set("next", child);
+      values.delete("first");
+      expect((await realm.evaluate("named.next === child && named.first === undefined && Object.hasOwn(named, 'next')")).returnValue).toBe(true);
+    } finally { await realm.close(); }
+  });
+
+  it("combines indexed and unenumerable named keys without overriding fixed members", async () => {
+    let reads = 0;
+    const named = createHostObject({
+      properties: { fixed: { get: () => 9 } },
+      indexed: { maxLength: 2, length: () => 1, get: () => 10 },
+      named: { maxKeys: 4, maxKeyCodeUnits: 40, enumerable: false, keys: () => ["entry", "fixed", "0", "length"], get: () => { reads++; return 20; } },
+    });
+    const realm = createRealm({ bindings: { named } });
+    try {
+      expect(deepCopyFromSandbox((await realm.evaluate("Object.keys(named)")).returnValue)).toEqual(["0", "fixed"]);
+      expect(reads).toBe(0);
+      expect((await realm.evaluate("named.entry === 20 && named.fixed === 9 && named[0] === 10 && named.length === 1")).returnValue).toBe(true);
+      expect(reads).toBe(1);
+    } finally { await realm.close(); }
+  });
+
+  it("supports enumerable names in values, spread and for-in while observing removal", async () => {
+    const values = new Map([["first", 1], ["second", 2]]);
+    const named = createHostObject({ named: { maxKeys: 4, maxKeyCodeUnits: 40, keys: () => [...values.keys()], get: name => { if (name === "first") values.delete("second"); return values.get(name); } } });
+    const realm = createRealm({ bindings: { named } });
+    try {
+      await realm.evaluate("let copied = { ...named }; let names = []; for (const name in named) names.push(name);");
+      expect(deepCopyFromSandbox((await realm.evaluate("[Object.keys(copied), Object.values(named), names]")).returnValue)).toEqual([["first"], [1], ["first"]]);
+    } finally { await realm.close(); }
+  });
+
+  it("rejects named writes, deletion, assignment and freezing", async () => {
+    const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 10, keys: () => ["entry"], get: () => 10 } });
+    const realm = createRealm({ bindings: { named } });
+    try {
+      await realm.evaluate("let rejected = 0; try { named.entry = 3; } catch (error) { rejected++; } try { delete named.entry; } catch (error) { rejected++; } try { Object.assign(named, { entry: 3 }); } catch (error) { rejected++; } try { Object.freeze(named); } catch (error) { rejected++; }");
+      expect((await realm.evaluate("rejected === 4 && named.entry === 10")).returnValue).toBe(true);
+    } finally { await realm.close(); }
+  });
+
+  it.each([[], ["same", "same"], ["toolongname"], [1], ["constructor"], ["__proto__"], ["prototype"]].map(keys => ({ keys })))("validates live name lists $keys", async ({ keys }) => {
+    const named = createHostObject({ named: { maxKeys: 2, maxKeyCodeUnits: 5, keys: () => keys as string[], get: () => 1 } });
+    const realm = createRealm({ bindings: { named } });
+    try {
+      if (keys.length === 0) expect(deepCopyFromSandbox((await realm.evaluate("Object.keys(named)")).returnValue)).toEqual([]);
+      else await expect(realm.evaluate("Object.keys(named)")).rejects.toThrow();
+    } finally { await realm.close(); }
+  });
+
+  it("checks list and realm bounds before reading named values", async () => {
+    let reads = 0;
+    const named = createHostObject({ named: { maxKeys: 4, maxKeyCodeUnits: 40, keys: () => ["one", "two", "three"], get: () => { reads++; return 1; } } });
+    const realm = createRealm({ bindings: { named }, budget: new Budget({ arrayLength: 2 }) });
+    try {
+      await expect(realm.evaluate("named.one")).rejects.toMatchObject({ code: "budgetExceeded", budget: "arrayLength" });
+      expect(reads).toBe(0);
+    } finally { await realm.close(); }
+  });
+
+  it("rejects asynchronous values and asynchronous name providers", async () => {
+    for (const asynchronousKeys of [false, true]) {
+      const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 10, keys: (() => asynchronousKeys ? Promise.resolve(["entry"]) : ["entry"]) as () => string[], get: () => Promise.resolve(1) } });
+      const realm = createRealm({ bindings: { named } });
+      try { await expect(realm.evaluate("named.entry")).rejects.toThrow(); }
+      finally { await realm.close(); }
+    }
+  });
+
+  it("validates definitions without invoking declaration getters", () => {
+    let calls = 0;
+    expect(() => createHostObject({ named: { get maxKeys() { calls++; return 1; }, maxKeyCodeUnits: 10, keys: () => [], get: () => 1 } })).toThrow();
+    for (const maxKeys of [0, -1, 1.5, Infinity, 65537])
+      expect(() => createHostObject({ named: { maxKeys, maxKeyCodeUnits: 10, keys: () => [], get: () => 1 } })).toThrow();
+    expect(calls).toBe(0);
+  });
+
+  it("rejects forbidden names independently of the aggregate key length limit", async () => {
+    for (const name of ["constructor", "prototype", "__proto__"]) {
+      const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 100, keys: () => [name], get: () => 1 } });
+      const realm = createRealm({ bindings: { named } });
+      try { await expect(realm.evaluate("Object.keys(named)")).rejects.toThrow(/forbidden/); }
+      finally { await realm.close(); }
+    }
+  });
+
+  it("rejects sparse, accessor and proxy key arrays without invoking accessors", async () => {
+    let calls = 0;
+    const accessor = ["entry"];
+    Object.defineProperty(accessor, "0", { get() { calls++; return "entry"; } });
+    const proxy = new Proxy(["entry"], { get(target, key) { calls++; return Reflect.get(target, key); } });
+    for (const keys of [accessor, proxy, Array(1)]) {
+      const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 100, keys: () => keys, get: () => 1 } });
+      const realm = createRealm({ bindings: { named } });
+      try { await expect(realm.evaluate("Object.keys(named)")).rejects.toThrow(); }
+      finally { await realm.close(); }
+    }
+    expect(calls).toBe(0);
+  });
+
+  it("checks declared key count and combined code units", async () => {
+    for (const limits of [{ maxKeys: 1, maxKeyCodeUnits: 100 }, { maxKeys: 4, maxKeyCodeUnits: 5 }]) {
+      const named = createHostObject({ named: { ...limits, keys: () => ["one", "two"], get: () => 1 } });
+      const realm = createRealm({ bindings: { named } });
+      try { await expect(realm.evaluate("Object.keys(named)")).rejects.toThrow(); }
+      finally { await realm.close(); }
+    }
+  });
+
+  it("keeps named capabilities uncopyable and revokes saved virtual getters", async () => {
+    const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 10, keys: () => ["entry"], get: () => 1 } });
+    const realm = createRealm({ bindings: { named } });
+    const value = (await realm.evaluate("named")).returnValue;
+    expect(() => deepCopyFromSandbox(value)).toThrow(/live host object/);
+    const getter = liveHostOwnDescriptor(value as object, "entry")?.get;
+    expect(getter).toBeTypeOf("function");
+    await realm.close();
+    expect(() => getter?.call(value)).toThrow();
+  });
+
+  it("consumes rejected asynchronous key results without an unhandled rejection", async () => {
+    const named = createHostObject({ named: { maxKeys: 1, maxKeyCodeUnits: 10, keys: (() => Promise.reject(new Error("rejected keys"))) as unknown as () => string[], get: () => 1 } });
+    const realm = createRealm({ bindings: { named } });
+    try { await expect(realm.evaluate("named.entry")).rejects.toThrow(); }
+    finally { await realm.close(); }
+    await new Promise(resolve => setTimeout(resolve, 0));
+  });
+});
