+import type { Budget } from "../budget.js";
+import { createDateValue, dateValue, isSandboxDate, registerDateIntrinsic, setDateValue } from "../date-value.js";
+import { findGuestProperty, guestFunctionProperties, guestPrototype, registerGuestFunction, setGuestPrototype } from "../guest-objects.js";
+import { sandboxString } from "../string-coercion.js";
+import { allocateProducedSandboxValue, createSandboxClosure, isSandboxClosure, type SandboxCallContext, type SandboxClosure, type SandboxObject, type SandboxValue } from "../values.js";
+
+const NativeDate = Date;
+const nativeNow = Date.now;
+const nativeParse = Date.parse;
+const nativeUTC = Date.UTC;
+const getters = {
+  getDate: Date.prototype.getDate,
+  getDay: Date.prototype.getDay,
+  getFullYear: Date.prototype.getFullYear,
+  getHours: Date.prototype.getHours,
+  getMilliseconds: Date.prototype.getMilliseconds,
+  getMinutes: Date.prototype.getMinutes,
+  getMonth: Date.prototype.getMonth,
+  getSeconds: Date.prototype.getSeconds,
+  getTime: Date.prototype.getTime,
+  getTimezoneOffset: Date.prototype.getTimezoneOffset,
+  getUTCDate: Date.prototype.getUTCDate,
+  getUTCDay: Date.prototype.getUTCDay,
+  getUTCFullYear: Date.prototype.getUTCFullYear,
+  getUTCHours: Date.prototype.getUTCHours,
+  getUTCMilliseconds: Date.prototype.getUTCMilliseconds,
+  getUTCMinutes: Date.prototype.getUTCMinutes,
+  getUTCMonth: Date.prototype.getUTCMonth,
+  getUTCSeconds: Date.prototype.getUTCSeconds,
+  valueOf: Date.prototype.valueOf,
+};
+const formatters = {
+  toDateString: Date.prototype.toDateString,
+  toISOString: Date.prototype.toISOString,
+  toString: Date.prototype.toString,
+  toTimeString: Date.prototype.toTimeString,
+  toUTCString: Date.prototype.toUTCString,
+};
+const setters = {
+  setDate: Date.prototype.setDate,
+  setFullYear: Date.prototype.setFullYear,
+  setHours: Date.prototype.setHours,
+  setMilliseconds: Date.prototype.setMilliseconds,
+  setMinutes: Date.prototype.setMinutes,
+  setMonth: Date.prototype.setMonth,
+  setSeconds: Date.prototype.setSeconds,
+  setTime: Date.prototype.setTime,
+  setUTCDate: Date.prototype.setUTCDate,
+  setUTCFullYear: Date.prototype.setUTCFullYear,
+  setUTCHours: Date.prototype.setUTCHours,
+  setUTCMilliseconds: Date.prototype.setUTCMilliseconds,
+  setUTCMinutes: Date.prototype.setUTCMinutes,
+  setUTCMonth: Date.prototype.setUTCMonth,
+  setUTCSeconds: Date.prototype.setUTCSeconds,
+};
+
+export function createDateGlobals(budget: Budget, now: (() => number) | SandboxClosure = nativeNow): { Date: SandboxClosure } {
+  const prototype = Object.create(null) as SandboxObject;
+  const ordinaryPrototype = guestPrototype(prototype, budget);
+  if (ordinaryPrototype !== undefined) setGuestPrototype(prototype, ordinaryPrototype);
+  const currentTime = (context?: SandboxCallContext): number => {
+    budget.visitNode();
+    const value: unknown = typeof now === "function" ? now() : now.call([], context);
+    if (typeof value !== "number" || !Number.isFinite(value) || Math.abs(value) > 8.64e15)
+      throw new TypeError("Date clock must return a finite epoch millisecond value within TimeClip limits.");
+    return new NativeDate(value).getTime();
+  };
+  const construct = async (args: readonly SandboxValue[], context?: SandboxCallContext): Promise<SandboxValue> => {
+    let time: number;
+    if (args.length === 0) time = currentTime(context);
+    else if (args.length === 1) {
+      const value = args[0];
+      if (isSandboxDate(value)) time = dateValue(value);
+      else {
+        const primitive = await datePrimitive(value, "default", budget, context);
+        time = typeof primitive === "string"
+          ? parseDate(primitive, budget)
+          : new NativeDate(Number(primitive)).getTime();
+      }
+    } else {
+      const parts = await numericArguments(args.slice(0, 7), budget, context);
+      time = new NativeDate(parts[0], parts[1], parts.length > 2 ? parts[2] : 1,
+        parts.length > 3 ? parts[3] : 0, parts.length > 4 ? parts[4] : 0,
+        parts.length > 5 ? parts[5] : 0, parts.length > 6 ? parts[6] : 0).getTime();
+    }
+    budget.visitNode();
+    return allocateProducedSandboxValue(createDateValue(time, prototype), budget);
+  };
+  const constructor = createSandboxClosure({
+    sandbox: true,
+    name: "Date",
+    length: 7,
+    call: (_args, context) => budget.allocateString(new NativeDate(currentTime(context)).toString()),
+    construct,
+  });
+  registerGuestFunction(constructor, true);
+  const properties = guestFunctionProperties(constructor)!;
+  Object.defineProperty(properties, "prototype", { value: prototype, writable: false });
+  const staticMethods: SandboxObject = {
+    now: createSandboxClosure({ sandbox: true, name: "now", length: 0, call: (_args, context) => currentTime(context) }),
+    parse: createSandboxClosure({ sandbox: true, name: "parse", length: 1,
+      call: async ([value], context) => parseDate(await sandboxString(value, budget, context), budget) }),
+    UTC: createSandboxClosure({ sandbox: true, name: "UTC", length: 7,
+      call: async (args, context) => {
+        const parts = await numericArguments(args.slice(0, 7), budget, context);
+        return Reflect.apply(nativeUTC, undefined, parts);
+      } }),
+  };
+  for (const [name, value] of Object.entries(staticMethods))
+    Object.defineProperty(properties, name, { value, writable: true, configurable: true });
+  Object.defineProperty(prototype, "constructor", { value: constructor, writable: true, configurable: true });
+  const define = (name: string, length: number, call: NonNullable<Parameters<typeof createSandboxClosure>[0]["call"]>) => {
+    const method = createSandboxClosure({ sandbox: true, name, length, call });
+    Object.defineProperty(prototype, name, { value: method, writable: true, configurable: true });
+  };
+  for (const [name, method] of Object.entries(getters))
+    define(name, 0, (_args, context) => Reflect.apply(method, new NativeDate(dateValue(context?.thisValue)), []));
+  for (const [name, method] of Object.entries(formatters))
+    define(name, 0, (_args, context) => budget.allocateString(Reflect.apply(method, new NativeDate(dateValue(context?.thisValue)), [])));
+  for (const [name, method] of Object.entries(setters))
+    define(name, method.length, async (args, context) => {
+      const receiver = context?.thisValue;
+      const native = new NativeDate(dateValue(receiver));
+      const parts = await numericArguments(args.slice(0, method.length), budget, context);
+      const result = Reflect.apply(method, native, parts) as number;
+      setDateValue(receiver as object, result);
+      return result;
+    });
+  Object.defineProperty(prototype, "toGMTString", { value: prototype.toUTCString, writable: true, configurable: true });
+  define("getYear", 0, (_args, context) => new NativeDate(dateValue(context?.thisValue)).getFullYear() - 1900);
+  define("setYear", 1, async ([value], context) => {
+    const receiver = context?.thisValue;
+    const native = new NativeDate(dateValue(receiver));
+    const year = Number(await datePrimitive(value, "number", budget, context));
+    const result = Number.isNaN(year) ? NaN : native.setFullYear(
+      Math.trunc(year) >= 0 && Math.trunc(year) <= 99 ? Math.trunc(year) + 1900 : year);
+    setDateValue(receiver as object, result);
+    return result;
+  });
+  define("toJSON", 1, async (_args, context) => {
+    const receiver = context?.thisValue;
+    if (typeof receiver !== "object" || receiver === null)
+      throw new TypeError("Date toJSON requires a guest object.");
+    const primitive = await datePrimitive(receiver, "number", budget, context);
+    if (typeof primitive === "number" && !Number.isFinite(primitive)) return null;
+    const method = findGuestProperty(receiver, "toISOString", budget)?.descriptor.value;
+    if (!isSandboxClosure(method) || context?.invokeClosure === undefined)
+      throw new TypeError("Date toJSON requires a callable toISOString.");
+    return context.invokeClosure(method, [], receiver);
+  });
+  for (const name of ["toLocaleString", "toLocaleDateString", "toLocaleTimeString"])
+    define(name, 0, () => { throw new TypeError("Date locale formatting is unsupported; use explicit date formatting."); });
+  const roots = [prototype, constructor];
+  registerDateIntrinsic(prototype, budget, roots);
+  registerDateIntrinsic(constructor, budget, roots, true);
+  registerDateIntrinsic(properties, budget, roots);
+  return { Date: constructor };
+}
+
+function parseDate(value: string, budget: Budget): number {
+  budget.allocateString(value);
+  for (let index = 0; index < value.length; index++) budget.visitNode();
+  return nativeParse(value);
+}
+
+async function numericArguments(args: readonly SandboxValue[], budget: Budget, context?: SandboxCallContext): Promise<number[]> {
+  const values: number[] = [];
+  for (const value of args) {
+    budget.visitNode();
+    values.push(Number(await datePrimitive(value, "number", budget, context)));
+  }
+  return values;
+}
+
+export async function datePrimitive(value: SandboxValue, hint: "default" | "number" | "string", budget: Budget, context?: SandboxCallContext): Promise<SandboxValue> {
+  if (typeof value !== "object" || value === null) return value;
+  const names = hint === "string" || (hint === "default" && isSandboxDate(value))
+    ? ["toString", "valueOf"] : ["valueOf", "toString"];
+  for (const name of names) {
+    const found = findGuestProperty(value, name, budget);
+    if (found === undefined) {
+      if (name === "toString") return sandboxString(value, budget, context);
+      continue;
+    }
+    if (!("value" in found.descriptor)) throw new TypeError("Date conversion via guest accessors is unsupported.");
+    const method = found.descriptor.value;
+    if (!isSandboxClosure(method)) continue;
+    if (context?.invokeClosure === undefined) throw new TypeError("Date conversion requires a guest call context.");
+    const result = await context.invokeClosure(method, [], value);
+    if (typeof result !== "object" || result === null) return result;
+  }
+  throw new TypeError("Cannot convert object to primitive value.");
+}
