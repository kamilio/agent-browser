+import { describe, expect, it } from "vitest";
+
+import { createRealm } from "../../core.js";
+import { SandboxError } from "../budget.js";
+import { regexCompiledData } from "./compile-guard.js";
+import { matchRegex } from "./engine.js";
+import { parseRegex } from "./parse.js";
+
+describe("budgeted lookahead assertions", () => {
+  it.each([
+    [String.raw`a(?=b)`, "", "ab"],
+    [String.raw`a(?=b)`, "", "ac"],
+    [String.raw`a(?!b)`, "", "ac"],
+    [String.raw`a(?!b)`, "", "ab"],
+    [
+      String.raw`<(?!area|br|col|embed|hr|img|input|link|meta|param)(([\w:]+)[^>]*)\/>`,
+      "gi",
+      "<span/>"
+    ],
+    [
+      String.raw`<(?!area|br|col|embed|hr|img|input|link|meta|param)(([\w:]+)[^>]*)\/>`,
+      "gi",
+      "<br/>"
+    ],
+    [String.raw`(?=(a+))`, "", "baaabac"],
+    [String.raw`(?=(a+))a*b\1`, "", "baaabac"],
+    [String.raw`^(?=(a|ab))\1c$`, "", "abc"],
+    [String.raw`^(?=(ab|a))\1c$`, "", "abc"],
+    [String.raw`(.*?)a(?!(a+)b\2c)\2(.*)`, "", "baaabaac"],
+    [String.raw`(?:(?=(a))a|b)+\1`, "", "ab"],
+    [String.raw`(?:(?=(a))a|b)+\1`, "", "aba"],
+    [String.raw`(?!(a))\1b`, "", "b"],
+    [String.raw`(?=(a))(?=\1b)ab`, "", "ab"],
+    [String.raw`(?=(?!a)b)b`, "", "b"],
+    [String.raw`(?=)`, "", ""],
+    [String.raw`(?!)`, "", ""],
+    [String.raw`(?=a)?b`, "", "b"],
+    [String.raw`(?=(a))*a`, "", "a"],
+    [String.raw`(?=(a)){2}a`, "", "a"],
+    [String.raw`a(?=b)`, "i", "AB"]
+  ])("matches /%s/%s against %s like the native test oracle", (source, flags, input) => {
+    const expected = new RegExp(source, flags).exec(input);
+    expect(matchRegex(parseRegex(source, flags), input)).toEqual(
+      expected === null
+        ? null
+        : { index: expected.index, text: expected[0], captures: expected.slice(1) }
+    );
+  });
+
+  it.each(["(?=a", "(?!a", "(?=a))"])("rejects malformed lookahead: %s", (source) => {
+    expect(() => parseRegex(source)).toThrow();
+  });
+
+  it.each(["(?<=a)", "(?<!a)", "(?<name>a)"])(
+    "does not silently accept unsupported groups: %s",
+    (source) => {
+      expect(() => parseRegex(source)).toThrow("not supported");
+    }
+  );
+
+  it("counts only actual capturing groups, including nested assertion captures", () => {
+    expect(parseRegex(String.raw`(?=(a))(?!b(c))(d)\3`).captureCount).toBe(3);
+  });
+
+  it("measures assertion bodies when compiled ownership metadata is absent", () => {
+    const copied = structuredClone(parseRegex(String.raw`(?=(a))\1`));
+    expect(regexCompiledData(copied).units).toBeGreaterThan(0);
+    expect(Number.isFinite(regexCompiledData(copied).units)).toBe(true);
+  });
+
+  it.each(["(?=(a+)+b)", "(?!(a+)+b)"])("does not hide budget exhaustion inside %s", (source) => {
+    expect(() => matchRegex(parseRegex(source), "a".repeat(80))).toThrow(SandboxError);
+  });
+
+  it("uses lookahead in public realm regex literals without a native regex fallback", async () => {
+    const realm = createRealm();
+    try {
+      expect((await realm.evaluate('/^<(?!br)([a-z]+)\\/>$/i.test("<span/>")')).returnValue).toBe(
+        true
+      );
+      expect((await realm.evaluate('/^<(?!br)([a-z]+)\\/>$/i.test("<br/>")')).returnValue).toBe(
+        false
+      );
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("retains capture substitutions in public string replacement", async () => {
+    const realm = createRealm();
+    try {
+      const result = await realm.evaluate(
+        String.raw`"<span/> <br/>".replace(/<(?!br)(\w+)\/>/gi, "<$1></$1>")`
+      );
+      expect(result.returnValue).toBe("<span></span> <br/>");
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("retains the existing compilation depth cap for nested assertions", () => {
+    expect(() => parseRegex("(?=".repeat(65) + "a" + ")".repeat(65))).toThrow(SandboxError);
+  });
+});
