+        }
+      }
+    });
+    const realm = core.createRealm({ bindings: { node } });
+    try {
+      const evaluated = await realm.evaluate("node");
+      expect(() => core.deepCopyFromSandbox(evaluated.returnValue)).toThrow();
+      expect(reads).toBe(0);
+    } finally {
+      await realm.close();
+    }
+  });
 });
