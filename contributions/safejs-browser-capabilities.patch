+
+  it("copies persistent-realm data through the lightweight public surface", async () => {
+    const realm = core.createRealm();
+    try {
+      await realm.evaluate("const value = { answer: 42, list: [1, 2] };");
+      const evaluated = await realm.evaluate("value");
+      const copied = core.deepCopyFromSandbox(evaluated.returnValue) as {
+        answer: number;
+        list: number[];
+      };
+      expect(copied).toEqual({ answer: 42, list: [1, 2] });
+      copied.answer = 7;
+      expect((await realm.evaluate("value.answer")).returnValue).toBe(42);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not project live grants into copied records or invoke their getters", async () => {
+    let reads = 0;
