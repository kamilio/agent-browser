+import { describe, expect, it } from "vitest";
+
+import { createRealm } from "../core.js";
+import { parse } from "../parse.js";
+
+describe("new expressions without arguments", () => {
+  it.each(["new Date", "new Date;", "new Date\n"])(
+    "accepts omitted argument lists: %s",
+    (source) => {
+      expect(parse(source)).toMatchObject({
+        type: "NewExpression",
+        callee: { type: "Identifier", name: "Date" },
+        arguments: [],
+        span: { end: { offset: 8 } }
+      });
+    }
+  );
+
+  it.each(["new constructors.Date", 'new constructors["Date"]'])(
+    "keeps member access inside the constructor: %s",
+    (source) => {
+      expect(parse(source)).toMatchObject({
+        type: "NewExpression",
+        callee: {
+          type: "MemberExpression",
+          object: { type: "Identifier", name: "constructors" }
+        },
+        arguments: []
+      });
+    }
+  );
+
+  it("does not consume a following binary expression", () => {
+    expect(parse('"prefix" + 1 * new Date')).toMatchObject({
+      type: "BinaryExpression",
+      operator: "+",
+      right: {
+        type: "BinaryExpression",
+        operator: "*",
+        right: { type: "NewExpression", arguments: [] }
+      }
+    });
+  });
+
+  it("keeps calls and members following an explicit argument list outside new", () => {
+    expect(parse("new Factory().method()")).toMatchObject({
+      type: "CallExpression",
+      callee: {
+        type: "MemberExpression",
+        object: { type: "NewExpression", arguments: [] },
+        property: { name: "method" }
+      }
+    });
+    expect(parse("new Factory()()")).toMatchObject({
+      type: "CallExpression",
+      callee: { type: "NewExpression", arguments: [] }
+    });
+  });
+
+  it.each(["new new Factory", "new new Factory()", "new new Factory()()"])(
+    "preserves nested constructor precedence: %s",
+    (source) => {
+      expect(parse(source)).toMatchObject({
+        type: "NewExpression",
+        callee: {
+          type: "NewExpression",
+          callee: { name: "Factory" },
+          arguments: []
+        },
+        arguments: []
+      });
+    }
+  );
+
+  it.each(["new Date(", "new Date(,)", "new Date?.()", "new Date."])(
+    "still rejects malformed constructor expressions: %s",
+    (source) => {
+      expect(() => parse(source)).toThrow();
+    }
+  );
+
+  it.each(["(new Date)?.method()", "new Date()?.method()"])(
+    "accepts optional access after completed construction: %s",
+    (source) => {
+      expect(() => parse(source)).not.toThrow();
+    }
+  );
+
+  it("executes omitted arguments in a persistent realm", async () => {
+    const realm = createRealm();
+    try {
+      await realm.evaluate(
+        "function Box() { this.value = 7; } const constructors = { Box }; const box = new constructors.Box;"
+      );
+      const result = await realm.evaluate("box.value + (new Box).value");
+      expect(result.returnValue).toBe(14);
+    } finally {
+      await realm.close();
+    }
+  });
+});
