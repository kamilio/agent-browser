+import { describe, expect, it } from "vitest";
+import { Budget, createHostObject, createRealm, deepCopyFromSandbox } from "./core.js";
+
+describe("bounded indexed host objects", () => {
+  it("skips indices removed by an earlier getter during object spread", async () => {
+    const values = [1, 2];
+    const collection = createHostObject({
+      indexed: {
+        maxLength: 4,
+        length: () => values.length,
+        get: (index) => {
+          if (index === 0) values.pop();
+          return values[index];
+        },
+      },
+    });
+    const realm = createRealm({ bindings: { collection } });
+    try {
+      await realm.evaluate("let copied = { ...collection };");
+      expect(
+        deepCopyFromSandbox((await realm.evaluate("[Object.keys(copied), copied[0]]")).returnValue),
+      ).toEqual([["0"], 1]);
+    } finally {
+      await realm.close();
+    }
+  });
+  it("reads changing indices and length without allocating one binding per index", async () => {
+    const values = [10, 20];
+    let reads = 0;
+    const collection = createHostObject({
+      indexed: {
+        maxLength: 100,
+        length: () => values.length,
+        get: (index) => {
+          reads++;
+          return values[index];
+        },
+      },
+    });
+    const realm = createRealm({ bindings: { collection } });
+    try {
+      expect((await realm.evaluate("collection.length")).returnValue).toBe(2);
+      expect(reads).toBe(0);
+      expect((await realm.evaluate("collection[1]")).returnValue).toBe(20);
+      values.unshift(5);
+      expect((await realm.evaluate("collection[1]")).returnValue).toBe(10);
+      values.length = 0;
+      expect((await realm.evaluate("collection[0]")).returnValue).toBeUndefined();
+      expect(reads).toBe(2);
