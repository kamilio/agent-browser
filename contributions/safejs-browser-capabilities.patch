+import { sandboxErrorTypes } from "../../error/shape.js";
+import { liveHostOwnDescriptor } from "../../host-object.js";
+import type { Budget } from "../budget.js";
+import { isFloat32Array } from "../float32.js";
+import { isSandboxDate } from "../date-value.js";
+import {
+  findGuestProperty,
+  guestFunctionProperties,
+  guestPrototype,
+  isOrdinaryGuestObject,
+  registerObjectPrototype,
+  setGuestPrototype,
+} from "../guest-objects.js";
+import { sandboxString } from "../string-coercion.js";
+import {
+  allocateProducedSandboxValue,
+  createSandboxClosure,
+  isSandboxArguments,
+  isSandboxClosure,
+  isSandboxGenerator,
+  isSandboxMap,
+  isSandboxPromise,
+  isSandboxRegex,
+  isSandboxSet,
