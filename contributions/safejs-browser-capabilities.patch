+
+  it("bounds retained data across evaluations", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 100_000, dataSize: 8_000 }) });
+    await realm.evaluate("const retained = [];");
+    let exhausted = false;
+    for (let attempt = 0; attempt < 30; attempt += 1) {
+      try {
+        await realm.evaluate('retained.push("x".repeat(500));');
+      } catch (error) {
+        expect(error).toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+        exhausted = true;
+        break;
+      }
+    }
+    expect(exhausted).toBe(true);
+    expect(realm.closed).toBe(true);
+    await realm.close();
+  });
+
+  it("bounds evaluation count and rejects invalid limits", async () => {
+    for (const limit of [0, -1, 1.5, Infinity, NaN]) {
+      expect(() => createRealm({ maxEvaluations: limit })).toThrow(TypeError);
+      expect(() => createRealm({ maxSourceLength: limit })).toThrow(TypeError);
+    }
+    const realm = createRealm({ maxEvaluations: 1 });
+    await realm.evaluate("1");
+    await expect(realm.evaluate("2")).rejects.toMatchObject({ code: "budgetExceeded" });
+    await realm.close();
+  });
+
+  it("rejects pre-aborted creation and evaluation without effects", async () => {
+    const signal = AbortSignal.abort();
+    expect(() => createRealm({ signal })).toThrow(SandboxError);
+    const effect = vi.fn();
+    const realm = createRealm({ bindings: { effect } });
+    await expect(realm.evaluate("effect()", { signal })).rejects.toMatchObject({ code: "aborted" });
+    expect(effect).not.toHaveBeenCalled();
+    await realm.close();
+  });
+
+  it("keeps granted resources until close and closes each once", async () => {
+    const cleanup = vi.fn(async () => undefined);
+    const realm = createRealm({
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    await realm.evaluate("1");
+    expect(cleanup).not.toHaveBeenCalled();
+    await realm.close();
+    await realm.close();
+    expect(cleanup).toHaveBeenCalledTimes(1);
+  });
+
+  it("automatically releases idle resources on lifetime cancellation", async () => {
+    const controller = new AbortController();
+    const cleanup = vi.fn(async () => undefined);
+    const realm = createRealm({
+      signal: controller.signal,
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    controller.abort();
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    expect(cleanup).toHaveBeenCalledTimes(1);
+    await realm.close();
+  });
+
+  it("preserves fatal errors when resource cleanup also fails", async () => {
+    const cleanup = vi.fn(async () => {
+      throw new Error("cleanup failure");
+    });
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 100 }),
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    await expect(realm.evaluate("while (true) {}")).rejects.toMatchObject({
+      code: "budgetExceeded"
+    });
+    await expect(realm.close()).rejects.toBeInstanceOf(AggregateError);
+    expect(cleanup).toHaveBeenCalledTimes(1);
+  });
+
+  it("accounts for promises retained only by rejection tracking", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 100_000, dataSize: 256 }) });
+    try {
+      await expect(
+        realm.evaluate("for (let index = 0; index < 300; index += 1) { new Promise(() => {}); }")
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally {
+      await realm.close();
+    }
+  });
+});
