@@ -0,0 +1,62 @@
+import { setGuestPrototype } from "./guest-objects.js";
+import type { SandboxObject } from "./values.js";
+import type { Budget } from "./budget.js";
+
+const dateValues = new WeakMap<object, number>();
+const dateIntrinsics = new WeakSet<object>();
+const dateConstructors = new WeakSet<object>();
+const intrinsicOwners = new WeakMap<object, { budget: Budget; roots: readonly object[]; retained: boolean }>();
+const budgetOwners = new WeakMap<Budget, { budget: Budget; roots: readonly object[]; retained: boolean }>();
+
+export function isSandboxDate(value: unknown): boolean {
+  return typeof value === "object" && value !== null && dateValues.has(value);
+}
+
+export function dateValue(value: unknown): number {
+  if (!isSandboxDate(value)) throw new TypeError("Date method requires a Date receiver.");
+  return dateValues.get(value as object)!;
+}
+
+export function setDateValue(value: object, time: number): void {
+  dateValues.set(value, time);
+}
+
+export function createDateValue(time: number, prototype: SandboxObject): SandboxObject {
+  const value = Object.create(null) as SandboxObject;
+  dateValues.set(value, time);
+  setGuestPrototype(value, prototype);
+  return value;
+}
+
+export function registerDateIntrinsic(value: object, budget: Budget, roots: readonly object[], constructor = false): void {
+  dateIntrinsics.add(value);
+  if (constructor) dateConstructors.add(value);
+  let owner = budgetOwners.get(budget);
+  if (owner === undefined) {
+    owner = { budget, roots, retained: false };
+    budgetOwners.set(budget, owner);
+  }
+  intrinsicOwners.set(value, owner);
+}
+
+export function retainDateMutation(value: unknown): void {
+  if (typeof value !== "object" || value === null) return;
+  const owner = intrinsicOwners.get(value);
+  if (owner === undefined || owner.retained) return;
+  owner.retained = true;
+  owner.budget.setRetainedValues(owner, () => owner.roots);
+}
+
+export function releaseDateGlobals(budget: Budget): void {
+  const owner = budgetOwners.get(budget);
+  if (owner !== undefined) {
+    budget.setRetainedValues(owner, undefined);
+    budgetOwners.delete(budget);
+  }
+}
+
+export function hasDateState(value: unknown): boolean {
+  return typeof value === "object" && value !== null &&
+    (dateValues.has(value) || (dateIntrinsics.has(value) &&
+      (!dateConstructors.has(value) || intrinsicOwners.get(value)?.retained === true)));
+}
diff --git a/packages/safe-js/src/interp/date.test.ts b/packages/safe-js/src/interp/date.test.ts
