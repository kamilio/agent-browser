+    expect(typeof core.deepCopyFromSandbox).toBe("function");
     expect(core.lint).toBe(lint);
     expect(core.run).toBe(run);
+    expect(core.createRealm).toBe(createRealm);
+    expect(core.createHostObject).toBe(createHostObject);
