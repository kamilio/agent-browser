@@ -0,0 +1,107 @@
+import { describe, expect, it } from "vitest";
+
+import { createRealm } from "../../core.js";
+import { SandboxError } from "../budget.js";
+import { regexCompiledData } from "./compile-guard.js";
+import { matchRegex } from "./engine.js";
+import { parseRegex } from "./parse.js";
+
+describe("budgeted numeric backreferences", () => {
+  it.each([
+    [String.raw`(ab)\1`, "", "--abab--"],
+    [String.raw`(ab)\1`, "", "abac"],
+    [String.raw`^(\w+)\s+\1$`, "", "word word"],
+    [String.raw`^<(\w+)\s*\/?>(?:<\/\1>|)$`, "", "<span></span>"],
+    [String.raw`^<(\w+)\s*\/?>(?:<\/\1>|)$`, "", "<span></div>"],
+    [String.raw`(a|ab)\1c`, "", "ababc"],
+    [String.raw`(a+)\1`, "", "aaaa"],
+    [String.raw`(a)?\1b`, "", "b"],
+    [String.raw`\1(a)`, "", "a"],
+    [String.raw`(\1a)`, "", "a"],
+    [String.raw`(a|(b))\2`, "", "a"],
+    [String.raw`(a|(b))\2`, "", "bb"],
+    [String.raw`(a|(b))+\2`, "", "aba"],
+    [String.raw`(a)?\1*`, "", ""],
+    [String.raw`(ab)\1+?`, "", "ababab"],
+    [String.raw`(ab)\1`, "i", "abAB"],
+    [String.raw`(k)\1`, "i", "kK"],
+    [String.raw`(ß)\1`, "i", "ßẞ"],
+    [String.raw`(😀)\1`, "", "😀😀"],
+    [String.raw`(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\10`, "", "abcdefghijj"],
+    [String.raw`\10(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)`, "", "abcdefghij"]
+  ])("matches /%s/%s against %s like the native test oracle", (source, flags, input) => {
+    const expected = new RegExp(source, flags).exec(input);
+    expect(matchRegex(parseRegex(source, flags), input)).toEqual(
+      expected === null
+        ? null
+        : { index: expected.index, text: expected[0], captures: expected.slice(1) }
+    );
+  });
+
+  it.each([String.raw`\1`, String.raw`(a)\2`, String.raw`(a)\10`])(
+    "keeps ambiguous legacy decimal/octal escapes unsupported: %s",
+    (source) => {
+      expect(() => parseRegex(source)).toThrow("Invalid numeric backreference");
+    }
+  );
+
+  it("keeps legacy numeric character-class escapes unsupported", () => {
+    expect(() => parseRegex(String.raw`(a)[\1]`)).toThrow(
+      "Legacy numeric escapes are not supported"
+    );
+  });
+
+  it("rejects enormous numeric indices within compilation limits", () => {
+    expect(() => parseRegex(`(a)\\${"9".repeat(300)}`)).toThrow("Invalid numeric backreference");
+  });
+
+  it("retains a finite compiled size when a pattern has no ownership metadata", () => {
+    const copied = structuredClone(parseRegex(String.raw`(a)\1`));
+    expect(regexCompiledData(copied).units).toBeGreaterThan(0);
+    expect(Number.isFinite(regexCompiledData(copied).units)).toBe(true);
+  });
+
+  it("charges each compared code unit rather than treating a backreference as one step", () => {
+    const capture = "a".repeat(200);
+    expect(matchRegex(parseRegex(`^(${capture})$`), capture)?.text).toBe(capture);
+    expect(() => matchRegex(parseRegex(`^(${capture})\\1{10}$`), capture.repeat(11))).toThrow(
+      SandboxError
+    );
+  });
+
+  it("keeps adversarial backtracking inside the existing regex budget", () => {
+    expect(() => matchRegex(parseRegex(String.raw`^(a+)\1+b$`), "a".repeat(80))).toThrow(
+      SandboxError
+    );
+  });
+
+  it("supports regex literals, constructors and persistent reuse in the public realm", async () => {
+    const realm = createRealm();
+    try {
+      await realm.evaluate(
+        String.raw`const matcher = /^(\w+) \1$/i; const constructed = new RegExp("(ab)\\1");`
+      );
+      expect(
+        (await realm.evaluate('matcher.test("word WORD") && constructed.test("abab")')).returnValue
+      ).toBe(true);
+      expect((await realm.evaluate('matcher.test("word other")')).returnValue).toBe(false);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not let guest catch blocks hide backreference budget exhaustion", async () => {
+    const capture = "a".repeat(200);
+    const realm = createRealm();
+    try {
+      await expect(
+        realm.evaluate(
+          `try { /^(${capture})\\1{10}$/.test("a".repeat(2200)); } catch (error) { "hidden"; }`
+        )
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "steps" });
+      expect(realm.closed).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+});
