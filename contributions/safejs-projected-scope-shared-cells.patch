+it("preserves mutable cells shared by distinct projected and original scopes through repeated recovery", async () => {
+  const original = new Scope().child();
+  original.declare("count", "let", 3);
+  original.declare("discard", "const", "x".repeat(60000));
+  let functions = [
+    await closure(0, original.projectOwnBindings(["count"])!),
+    await closure(1, original.projectOwnBindings(["count"])!),
+    await closure(2, original),
+  ];
+  const originalRead = functions[1];
+  for (let iteration = 0; iteration < 3; iteration++) {
+    functions = recover(capture(functions));
+    expect(getClosureOrigin(functions[0])!.scope).not.toBe(
+      getClosureOrigin(functions[1])!.scope,
+    );
+    const scopes = functions.map((value) => getClosureOrigin(value)!.scope);
+    const snapshots = scopes.map((value) => value.retainedDataRoots());
+    const sizes = snapshots.map((value) => measureSandboxData(value));
+    expect(await functions[0].call([])).toBe(4 + iteration);
+    expect(await functions[1].call([])).toBe(4 + iteration);
+    expect(await functions[2].call([])).toBe(4 + iteration);
+    scopes[1].assign("count", "changed");
+    expect(
+      scopes.map((value) => measureSandboxData(value.retainedDataRoots())),
+    ).toEqual(sizes.map((value) => value + 7));
+    expect(await functions[2].call([])).toBe("changed");
+    scopes[2].assign("count", 4 + iteration);
+  }
+  expect(await originalRead.call([])).toBe(3);
+});
