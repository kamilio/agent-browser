+import { expect, it } from "vitest";
+import { parseModule } from "../parse/parser.js";
+import { Scope } from "../interp/scope.js";
+import { createMappedSandboxArguments } from "../interp/arguments.js";
+import { getClosureOrigin } from "../interp/closure-origin.js";
+import { interpret } from "../interp/interpreter.js";
+import { measureSandboxData, type SandboxClosure } from "../interp/values.js";
+import { serialize, type RuntimeSnapshotValue } from "./serialize.js";
+import { restore } from "./restore.js";
+
+const source = "{return [()=>++count,()=>count,()=>count]}";
+const ast = parseModule(source);
+const statement = ast.body[0];
+if (statement.type !== "BlockStatement")
+  throw new Error("Missing source block");
+const returned = statement.body[0];
+if (
+  returned.type !== "ReturnStatement" ||
+  returned.argument?.type !== "ArrayExpression"
+)
+  throw new Error("Missing source closures");
+const nodes = returned.argument.elements;
+
+async function closure(index: number, scope: Scope) {
+  const node = nodes[index];
+  if (node === null || node.type === "SpreadElement")
+    throw new Error("Missing closure node");
+  const result = await interpret(node, { scope, useScopeDirectly: true });
+  if (!result.ok) throw new Error(result.error.message);
+  return result.returnValue as SandboxClosure;
+}
+
+function capture(functions: SandboxClosure[]) {
+  return serialize({
+    source,
+    currentAstNodeId: statement.nodeId!,
+    scopeChain: [
+      {
+        id: "external",
+        bindings: { functions: functions as RuntimeSnapshotValue },
+      },
+    ],
+    callStack: [],
+    pendingPromises: [],
+    moduleBindings: {},
+  });
+}
+
+function recover(wire: ReturnType<typeof capture>) {
+  const restored = restore(JSON.parse(JSON.stringify(wire)), { source });
+  const binding = restored.currentScope.lookup("functions");
+  if (!binding.found) throw new Error("Missing recovered closures");
+  return binding.value as SandboxClosure[];
+}
+
+it("preserves mapped-argument writes shared with projected closure cells", async () => {
+  const original = new Scope().child({}, { functionBoundary: true });
+  original.declare("count", "var", 3);
+  const args = createMappedSandboxArguments(
+    [3],
+    ["count"],
+    original,
+    undefined,
+  );
+  original.declare("arguments", "var", args);
+  const functions = recover(
+    capture([
+      await closure(0, original.projectOwnBindings(["count"])!),
+      await closure(1, original.projectOwnBindings(["count"])!),
+      await closure(2, original),
+    ]),
+  );
+  const scopes = functions.map((value) => getClosureOrigin(value)!.scope);
+  const argumentBinding = scopes[2].lookup("arguments");
+  if (!argumentBinding.found) throw new Error("Missing recovered arguments");
+  const recoveredArgs = argumentBinding.value as Record<string, unknown>;
+  expect(await functions[0].call([])).toBe(4);
+  expect(recoveredArgs["0"]).toBe(4);
+  const previous = scopes[1].retainedDataRoots();
+  expect(measureSandboxData(previous)).toBe(0);
+  recoveredArgs["0"] = "grown";
+  expect(await functions[1].call([])).toBe("grown");
