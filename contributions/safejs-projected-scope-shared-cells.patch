+  const frames = Object.values(wire.heap) as Array<{
+    kind: string;
+    cellIds?: number[];
+    cells: Array<{ kind: string; value?: unknown }>;
+    chargeData: boolean;
+    globalEnvironment?: boolean;
+  }>;
+  const shared = frames.filter(
+    (value) => value.kind === "scope-frame" && value.cellIds !== undefined,
+  );
+  const target = shared.find((value) => value.cells.length === 2)!;
+  if (alteration === "length") target.cellIds = [];
+  if (alteration === "negative") target.cellIds![0] = -1;
+  if (alteration === "fractional") target.cellIds![0] = 0.5;
+  if (alteration === "duplicate") target.cellIds![1] = target.cellIds![0];
+  if (alteration === "conflicting-value") target.cells[0].value = 9;
+  if (alteration === "conflicting-kind") target.cells[0].kind = "const";
