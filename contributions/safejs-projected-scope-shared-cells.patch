+import { setImmediate } from "node:timers/promises";
+import { expect, it } from "vitest";
+import { Scope } from "./scope.js";
+import { Budget } from "./budget.js";
+import { interpret } from "./interpreter.js";
+import { parseModule } from "../parse/parser.js";
+import { measureSandboxData } from "./values.js";
+
+function fixture() {
+  const root = new Scope();
+  root.declare("global", "let", "global");
+  const scope = root.child({}, { functionBoundary: true });
+  scope.declare("value", "let", "a");
+  scope.declare("discard", "const", { text: "x".repeat(60000) });
+  scope.declareAlias("alias", "value");
+  return { scope, root };
+}
+
+it("enforces the interpreter data limit after another view grows a captured value", async () => {
+  const { scope } = fixture();
+  const view = scope.projectOwnBindings(["value"])!;
+  const previous = view.retainedDataRoots();
+  expect(measureSandboxData(previous)).toBe(7);
+  scope.assign("value", "x".repeat(3000));
+  await expect(
+    interpret(parseModule("{return 0}").body[0], {
+      scope: view,
+      budget: new Budget({ dataSize: 2000 }),
+    }),
+  ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+});
+
+it("projects selected live cells without retaining the original local frame", () => {
+  const { scope, root } = fixture();
+  const view = scope.projectOwnBindings(["value", "alias"])!;
+  expect(view).toBeDefined();
+  expect(view.captureFrame().parent).toBe(root);
+  expect(view.lookup("discard")).toEqual({ found: false });
+  expect(view.lookup("global")).toMatchObject({ value: "global" });
+  scope.assign("alias", "before");
+  expect(view.lookup("value")).toMatchObject({ value: "before" });
+  view.assign("value", "after");
+  expect(scope.lookup("alias")).toMatchObject({ value: "after" });
+  expect(view.captureFrame().cells).toHaveLength(1);
+});
+
+it.each(["original", "view", "second-view"])(
+  "invalidates every data cache after writes through %s",
+  (writer) => {
+    const { scope } = fixture();
+    const view = scope.projectOwnBindings(["value"])!;
+    const second = view.projectOwnBindings(["value"])!;
+    const snapshots = [scope, view, second].map((value) =>
+      value.retainedDataRoots(),
+    );
+    const sizes = snapshots.map((value) => measureSandboxData(value));
+    const target =
+      writer === "original" ? scope : writer === "view" ? view : second;
+    target.assign("value", "longer value");
+    expect(
+      [scope, view, second].map((value) =>
+        measureSandboxData(value.retainedDataRoots()),
+      ),
+    ).toEqual(sizes.map((value) => value + 11));
+    target.assign("value", 0);
+    expect(
+      [scope, view, second].map((value) =>
+        measureSandboxData(value.retainedDataRoots()),
+      ),
+    ).toEqual(sizes.map((value) => value - 1));
+    expect(snapshots.map((value) => measureSandboxData(value))).toEqual(sizes);
+  },
+);
+
+it("preserves TDZ initialization and immutable binding rules", () => {
+  const scope = new Scope().child();
+  scope.predeclare("pending", "const");
+  const view = scope.projectOwnBindings(["pending"])!;
