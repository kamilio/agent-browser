@@ -0,0 +1,141 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import { Scope } from "./scope.js";
+import { getScopeDataRoot, setScopeDataRoot } from "./scope-data-roots.js";
+import {
+  createSandboxClosure,
+  measureSandboxData,
+  reconcileCompiledValues,
+} from "./values.js";
+
+for (const mutation of ["registry", "metadata"] as const)
+  it(`does not expose scope-root ${mutation} through later WeakMap.get hooks`, () => {
+    const scope = new Scope({ text: "x".repeat(1000) });
+    const roots = scope.retainedDataRoots();
+    const root = roots[0] as object;
+    const original = WeakMap.prototype.get;
+    const registries = new Set<WeakMap<object, unknown>>();
+    const records = new Set<{ values: unknown }>();
+    try {
+      WeakMap.prototype.get = function (key: object) {
+        const value = Reflect.apply(original, this, [key]);
+        if (
+          key === root &&
+          value &&
+          typeof value === "object" &&
+          "values" in value
+        ) {
+          registries.add(this);
+          records.add(value);
+        }
+        return value;
+      };
+      expect(measureSandboxData(roots)).toBe(1000);
+    } finally {
+      WeakMap.prototype.get = original;
+    }
+    if (mutation === "registry")
+      for (const registry of registries)
+        WeakMap.prototype.set.call(registry, root, { values: [] });
+    else for (const record of records) record.values = [];
+    expect(registries.size).toBe(0);
+    expect(records.size).toBe(0);
+    expect(measureSandboxData(scope.retainedDataRoots())).toBe(1000);
+    expect(() =>
+      reconcileCompiledValues(
+        new Budget({ dataSize: 500 }),
+        scope.retainedDataRoots(),
+      ),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  });
+
+for (const mutation of ["registry", "metadata"] as const)
+  it(`does not expose scope-root ${mutation} through later WeakMap.set hooks`, () => {
+    const scope = new Scope({ text: "x".repeat(1000) });
+    const original = WeakMap.prototype.set;
+    const exposures = new Set<{
+      registry: WeakMap<object, unknown>;
+      root: object;
+      metadata: { values: unknown };
+    }>();
+    let roots;
+    try {
+      WeakMap.prototype.set = function (root: object, metadata: unknown) {
+        if (metadata && typeof metadata === "object" && "values" in metadata)
+          exposures.add({
+            registry: this,
+            root,
+            metadata: metadata as { values: unknown },
+          });
+        return Reflect.apply(original, this, [root, metadata]);
+      };
+      roots = scope.retainedDataRoots();
+    } finally {
+      WeakMap.prototype.set = original;
+    }
+    for (const exposure of exposures) {
+      if (mutation === "registry")
+        WeakMap.prototype.set.call(exposure.registry, exposure.root, {
+          values: [],
+        });
+      else exposure.metadata.values = [];
+    }
+    expect(exposures.size).toBe(0);
+    expect(measureSandboxData(roots)).toBe(1000);
+    expect(() =>
+      reconcileCompiledValues(
+        new Budget({ dataSize: 500 }),
+        scope.retainedDataRoots(),
+      ),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  });
+
+it("does not expose private-name root registration through later WeakMap.set hooks", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("x".repeat(1000));
+  const original = WeakMap.prototype.set;
+  const exposures = new Set<{ values: unknown }>();
+  try {
+    WeakMap.prototype.set = function (root: object, metadata: unknown) {
+      if (metadata && typeof metadata === "object" && "values" in metadata)
+        exposures.add(metadata as { values: unknown });
+      return Reflect.apply(original, this, [root, metadata]);
+    };
+    scope.retainedDataRoots();
+  } finally {
+    WeakMap.prototype.set = original;
+  }
+  for (const metadata of exposures) metadata.values = [];
+  expect(exposures.size).toBe(0);
+  expect(() =>
+    reconcileCompiledValues(
+      new Budget({ dataSize: 500 }),
+      scope.retainedDataRoots(),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("preserves live vector observations from explicit internal registrations", () => {
+  const values: string[] = [];
+  const root = Object.freeze({});
+  const data = { values };
+  setScopeDataRoot(root, data);
+  expect(getScopeDataRoot(root)).toBe(data);
+  const mutate = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      values.push("x".repeat(1000));
+      return [];
+    },
+  });
+  expect(measureSandboxData([mutate, root])).toBe(1001);
+  const budget = new Budget({ dataSize: 500 });
+  const release = budget.deferReconciliation();
+  try {
+    expect(() => reconcileCompiledValues(budget, [root])).toThrow(
+      expect.objectContaining({ budget: "dataSize" }),
+    );
+  } finally {
+    release();
+  }
+});
