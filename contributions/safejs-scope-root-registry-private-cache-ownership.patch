+++ b/src/interp/private-name-cache-ownership.test.ts
@@ -0,0 +1,248 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import { Scope } from "./scope.js";
+import { scopeDataRoots } from "./scope-data-roots.js";
+import { measureSandboxData, reconcileCompiledValues } from "./values.js";
+
+for (const method of ["get", "set"] as const)
+  it(`does not expose the private-name capture registry through later WeakMap.${method} hooks`, () => {
+    const scope = new Scope();
+    const name = scope.declarePrivateName("x".repeat(1000));
+    const names = scope.privateNames!;
+    if (method === "get") scope.retainedDataRoots();
+    const descriptor = Object.getOwnPropertyDescriptor(
+      WeakMap.prototype,
+      method,
+    )!;
+    const aliases = new Set<WeakMap<object, unknown>>();
+    try {
+      Object.defineProperty(WeakMap.prototype, method, {
+        ...descriptor,
+        value: function (
+          this: WeakMap<object, unknown>,
+          key: object,
+          value?: unknown,
+        ) {
+          const result = Reflect.apply(
+            descriptor.value,
+            this,
+            method === "get" ? [key] : [key, value],
+          );
+          if (
+            key === names &&
+            (method === "get" ? result : value) instanceof WeakRef
+          )
+            aliases.add(this);
+          return result;
+        },
+      });
+      scope.retainedDataRoots();
+    } finally {
+      Object.defineProperty(WeakMap.prototype, method, descriptor);
+    }
+    for (const alias of aliases)
+      WeakMap.prototype.set.call(
+        alias,
+        names,
+        new WeakRef({ root: Object.freeze({}), values: [name] }),
+      );
+    expect(aliases.size).toBe(0);
+    expect(measureSandboxData(scope.retainedDataRoots())).toBe(1013);
+    expect(() =>
+      reconcileCompiledValues(
+        new Budget({ dataSize: 500 }),
+        scope.retainedDataRoots(),
+      ),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  });
+
+it("does not expose private-name capture records through a later WeakRef constructor", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("x".repeat(1000));
+  const original = WeakRef;
+  const records = new Set<{ root: unknown }>();
+  try {
+    globalThis.WeakRef = new Proxy(original, {
+      construct(target, args, receiver) {
+        const value = args[0];
+        if (
+          value &&
+          typeof value === "object" &&
+          "root" in value &&
+          "values" in value
+        )
+          records.add(value);
+        return Reflect.construct(target, args, receiver);
+      },
+    });
+    scope.retainedDataRoots();
+  } finally {
+    globalThis.WeakRef = original;
+  }
+  for (const record of records) record.root = Object.freeze({});
+  expect(records.size).toBe(0);
+  expect(() =>
+    reconcileCompiledValues(
+      new Budget({ dataSize: 500 }),
+      scope.retainedDataRoots(),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("does not expose private-name capture records through later deref hooks", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("x".repeat(1000));
+  scope.retainedDataRoots();
+  const descriptor = Object.getOwnPropertyDescriptor(
+    WeakRef.prototype,
+    "deref",
+  )!;
+  const records = new Set<{ root: unknown }>();
+  try {
+    Object.defineProperty(WeakRef.prototype, "deref", {
+      ...descriptor,
+      value: function (this: WeakRef<object>) {
+        const value = Reflect.apply(descriptor.value, this, []);
+        if (
+          value &&
+          typeof value === "object" &&
+          "root" in value &&
+          "values" in value
+        )
+          records.add(value);
+        return value;
+      },
+    });
+    scope.retainedDataRoots();
+  } finally {
+    Object.defineProperty(WeakRef.prototype, "deref", descriptor);
+  }
+  for (const record of records) record.root = Object.freeze({});
+  expect(records.size).toBe(0);
+  expect(() =>
+    reconcileCompiledValues(
+      new Budget({ dataSize: 500 }),
+      scope.retainedDataRoots(),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("keeps private-name projection records and membership vectors immutable", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("x".repeat(1000));
+  const root = scope.retainedDataRoots()[0] as object;
+  const metadata = scopeDataRoots.get(root)!;
+  if (!("values" in metadata)) throw Error("missing projection");
+  expect(Object.isFrozen(metadata)).toBe(true);
+  expect(Object.isFrozen(metadata.values)).toBe(true);
+  expect(Reflect.set(metadata, "values", [])).toBe(false);
+  expect(Reflect.set(metadata.values, "length", 0)).toBe(false);
+  expect(() =>
+    reconcileCompiledValues(
+      new Budget({ dataSize: 500 }),
+      scope.retainedDataRoots(),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("does not expose capture vectors through later inherited numeric setters", () => {
+  const scope = new Scope();
+  const name = scope.declarePrivateName("x".repeat(1000));
+  const descriptor = Object.getOwnPropertyDescriptor(Array.prototype, "0");
+  const arrays = new Set<unknown[]>();
+  try {
+    Object.defineProperty(Array.prototype, "0", {
+      configurable: true,
+      set(value: unknown) {
+        if (value === name) arrays.add(this);
+        Object.defineProperty(this, "0", {
+          value,
+          writable: true,
+          configurable: true,
+          enumerable: true,
+        });
+      },
+    });
+    scope.retainedDataRoots();
+  } finally {
+    if (descriptor) Object.defineProperty(Array.prototype, "0", descriptor);
+    else Reflect.deleteProperty(Array.prototype, "0");
+  }
+  expect(arrays.size).toBe(0);
+  expect(() =>
+    reconcileCompiledValues(
+      new Budget({ dataSize: 500 }),
+      scope.retainedDataRoots(),
+    ),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("preserves raw undefined entries followed by objects and later native membership growth", () => {
+  const scope = new Scope();
+  const first = { description: "first" };
+  scope.privateNames = new Map([
+    ["undefined", undefined as never],
+    ["first", first],
+  ]);
+  expect(measureSandboxData(scope.retainedDataRoots())).toBe(
+    measureSandboxData([undefined, first]),
+  );
+  scope.privateNames.delete("undefined");
+  const before = scope.retainedDataRoots();
+  const second = { description: "second" };
+  scope.privateNames.set("second", second);
+  expect(measureSandboxData(scope.retainedDataRoots())).toBe(
+    measureSandboxData([first, second]),
+  );
+  expect(measureSandboxData(before)).toBe(measureSandboxData([first]));
+});
+
+it("does not admit a custom values method through later reflection hooks", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("decoy");
+  const descriptor = Object.getOwnPropertyDescriptor(Map.prototype, "values")!;
+  const original = Object.getOwnPropertyDescriptor;
+  let roots;
+  try {
+    Object.defineProperty(Map.prototype, "values", {
+      ...descriptor,
+      value: function* () {
+        yield "x".repeat(1000);
+      },
+    });
+    Object.getOwnPropertyDescriptor = (value, key) =>
+      value === Map.prototype && key === "values"
+        ? descriptor
+        : original(value, key);
+    roots = scope.retainedDataRoots();
+  } finally {
+    Object.getOwnPropertyDescriptor = original;
+    Object.defineProperty(Map.prototype, "values", descriptor);
+  }
+  expect(measureSandboxData(roots)).toBe(1000);
+  expect(() =>
+    reconcileCompiledValues(new Budget({ dataSize: 500 }), roots),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
+
+it("does not admit an own custom values method through later hasOwn hooks", () => {
+  const scope = new Scope();
+  scope.declarePrivateName("decoy");
+  Object.defineProperty(scope.privateNames!, "values", {
+    value: function* () {
+      yield "x".repeat(1000);
+    },
+  });
+  const original = Object.hasOwn;
+  let roots;
+  try {
+    Object.hasOwn = () => false;
+    roots = scope.retainedDataRoots();
+  } finally {
+    Object.hasOwn = original;
+  }
+  expect(measureSandboxData(roots)).toBe(1000);
+  expect(() =>
+    reconcileCompiledValues(new Budget({ dataSize: 500 }), roots),
+  ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+});
