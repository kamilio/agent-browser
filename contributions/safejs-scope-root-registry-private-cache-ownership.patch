+type ScopeDataRoot =
+  { readonly value: InterpreterValue } | { readonly values: readonly InterpreterValue[] };
+export const scopeDataRoots = new WeakMap<object, ScopeDataRoot>();
+// Later native hooks must not receive the registry or its metadata records.
+const nativeGet: typeof scopeDataRoots.get = WeakMap.prototype.get.bind(scopeDataRoots);
+const nativeSet: typeof scopeDataRoots.set = WeakMap.prototype.set.bind(scopeDataRoots);
+
+export function getScopeDataRoot(root: object): ScopeDataRoot | undefined {
+  return nativeGet(root);
+}
+
+export function setScopeDataRoot(root: object, data: ScopeDataRoot): void {
+  nativeSet(root, data);
+}
