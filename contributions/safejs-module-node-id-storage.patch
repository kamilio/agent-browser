@@ -0,0 +1,96 @@
+import { expect, it } from "vitest";
+import { assignFreshIds, assignIds } from "./assign-ids.js";
+import { parseSourceModule } from "./source-module.js";
+import type { ParseResult, SourceSpan } from "./parser.js";
+
+const span: SourceSpan = {
+  start: { line: 1, column: 1, offset: 0 },
+  end: { line: 1, column: 2, offset: 1 },
+};
+function nodes(root: unknown) {
+  const visited = new Set<object>();
+  const pending = [root];
+  const result: Array<{ type: string; nodeId?: number; span: SourceSpan }> = [];
+  while (pending.length) {
+    const item = pending.pop();
+    if (!item || typeof item !== "object" || visited.has(item)) continue;
+    visited.add(item);
+    if ("type" in item && "span" in item)
+      result.push(item as (typeof result)[number]);
+    pending.push(...Object.values(item));
+  }
+  return result.sort((a, b) => a.nodeId! - b.nodeId!);
+}
+
+it("assigns a shared child once and terminates on a back edge", () => {
+  const child = { type: "Identifier", name: "x", span };
+  const root = {
+    type: "BinaryExpression",
+    operator: "+",
+    left: child,
+    right: child,
+    span,
+  };
+  Object.assign(child, { parent: root });
+  assignFreshIds(root as ParseResult);
+  expect(nodes(root).map(({ nodeId }) => nodeId)).toEqual([0, 1]);
+  expect(root.left).toBe(root.right);
+  for (const node of nodes(root)) {
+    expect(Object.getOwnPropertyDescriptor(node, "nodeId")).toMatchObject({
+      value: node.nodeId,
+      enumerable: false,
+      writable: true,
+      configurable: true,
+    });
+    expect(node.span).toBe(span);
+  }
+});
+
+it("keeps public reassignment active after fresh assignment and mutated IDs", () => {
+  const root = {
+    type: "BinaryExpression",
+    operator: "+",
+    left: { type: "Identifier", name: "x", span },
+    right: { type: "NumericLiteral", value: 1, span },
+    span,
+  };
+  assignFreshIds(root as ParseResult);
+  for (const node of nodes(root)) node.nodeId = -100;
+  assignIds(root as ParseResult);
+  expect(nodes(root).map(({ nodeId }) => nodeId)).toEqual([0, 1, 2]);
+});
+
+it.each([
+  "export const value={x:1};export function result({x=value.x}={}){return x+value.x}",
+  "import {x} from './dep.js';export default function named(){return x;}export {x};",
+  "export const result=await Promise.resolve(42);export const pattern=/a[b-c]+/g;",
+  "export class Example {#x=1;get value(){return this.#x;}static {this.marker=2;}}",
+  "export const result=`a${1+2}b${`c${3*4}`}`;outer:for(const item of [1]){if(item)break outer;}",
+  "export const result=(x)=>({x,method(){return this.x;}});const {a:b=1,...rest}={a:2};export {b};",
+])(
+  "preserves all node IDs, spans and descriptors in fresh module parsing for %j",
+  (source) => {
+    const original = parseSourceModule(source);
+    const compact = parseSourceModule(source, "<input>", undefined, {
+      sharedPositions: true,
+    });
+    const expected = nodes(original.module);
+    const actual = nodes(compact.module);
+    expect(
+      actual.map(({ type, nodeId, span }) => ({ type, nodeId, span })),
+    ).toEqual(
+      expected.map(({ type, nodeId, span }) => ({ type, nodeId, span })),
+    );
+    expect(actual.map(({ nodeId }) => nodeId)).toEqual(
+      actual.map((_, index) => index),
+    );
+    for (const node of actual)
+      expect(Object.getOwnPropertyDescriptor(node, "nodeId")).toMatchObject({
+        value: node.nodeId,
+        enumerable: false,
+        writable: true,
+        configurable: true,
+      });
+    expect(JSON.stringify(compact)).toBe(JSON.stringify(original));
+  },
+);
