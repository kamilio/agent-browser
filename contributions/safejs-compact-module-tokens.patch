diff --git a/src/parse/compact-tokens.ts b/src/parse/compact-tokens.ts
new file mode 100644
--- /dev/null
+++ b/src/parse/compact-tokens.ts
@@ -0,0 +1,139 @@
+import type { Position, Token, TokenType } from "./tokenizer.js";
+
+const types: readonly TokenType[] = [
+  "identifier",
+  "private-identifier",
+  "keyword",
+  "escaped-keyword",
+  "numeric",
+  "regex",
+  "string",
+  "template",
+  "punctuator",
+  "eof",
+];
+const stride = 7;
+const legacyEscape = 256;
+const tokenCacheSize = 256;
+const positionCacheSize = tokenCacheSize * 2 + 2;
+
+/** Private indexed storage for module compilation; the public tokenizer stays eager. */
+export class CompactTokens {
+  private rows = new Uint32Array(1024 * stride);
+  private readonly values: Array<string | undefined> = [];
+  private readonly templates = new Map<number, Token["templateExpressions"]>();
+  private readonly tokens = new Map<number, Token>();
+  private readonly positions = new Map<number, Position>();
+  private last?: Token;
+  private retired = 0;
+
+  // The lexer/parser only use indexing, length, push, at and prefix retirement.
+  // Array methods read this indexed facade; token records are materialized on demand.
+  readonly indexed: Token[] = new Proxy([] as Token[], {
+    get: (target, key, receiver) => {
+      if (key === "length") return this.values.length;
+      if (key === "push") return this.push;
+      const index = arrayIndex(key);
+      return index === undefined
+        ? Reflect.get(target, key, receiver)
+        : this.get(index);
+    },
+    set: (_target, key, value) => {
+      const index = arrayIndex(key);
+      if (index === undefined || value !== undefined || index !== this.retired)
+        throw new TypeError(
+          "Compact token storage only permits ordered prefix retirement.",
+        );
+      this.values[index] = undefined;
+      this.templates.delete(index);
+      this.tokens.delete(index);
+      this.retired++;
+      return true;
+    },
+  });
+
+  finish(): Token[] {
+    // Parsing needs every token's row initially, but not spare growth capacity.
+    this.rows = this.rows.slice(0, this.values.length * stride);
+    return this.indexed;
+  }
+
+  private push = (token: Token): number => {
+    // String/template scanners annotate the last token after publishing it.
+    // Commit those annotations before that token becomes a historical row.
+    if (this.last !== undefined) {
+      const previous = this.values.length - 1;
+      if (this.last.legacyEscape)
+        this.rows[previous * stride + 6] |= legacyEscape;
+      if (this.last.templateExpressions !== undefined)
+        this.templates.set(previous, this.last.templateExpressions);
+    }
+    const index = this.values.length;
+    const base = index * stride;
+    if (base + stride > this.rows.length) {
+      const rows = new Uint32Array(this.rows.length * 2);
+      rows.set(this.rows);
+      this.rows = rows;
+    }
+    this.rows.set(
+      [
+        token.start.line,
+        token.start.column,
+        token.start.offset,
+        token.end.line,
+        token.end.column,
+        token.end.offset,
+        types.indexOf(token.type),
+      ],
+      base,
+    );
+    this.values.push(token.value);
+    this.last = token;
+    return index + 1;
+  };
+
+  private get(index: number): Token | undefined {
+    if (index < this.retired || index >= this.values.length) return undefined;
+    if (index === this.values.length - 1) return this.last;
+    const cached = this.tokens.get(index);
+    if (cached !== undefined) return cached;
+    const base = index * stride;
+    const bits = this.rows[base + 6]!;
+    const token: Token = {
+      type: types[bits & 255]!,
+      value: this.values[index]!,
+      start: this.position(base),
+      end: this.position(base + 3),
+    };
+    if (bits & legacyEscape) token.legacyEscape = true;
+    const expressions = this.templates.get(index);
+    if (expressions !== undefined) token.templateExpressions = expressions;
+    if (this.tokens.size === tokenCacheSize)
+      this.tokens.delete(this.tokens.keys().next().value!);
+    this.tokens.set(index, token);
+    return token;
+  }
+
+  private position(base: number): Position {
+    const offset = this.rows[base + 2]!;
+    const cached = this.positions.get(offset);
+    if (cached !== undefined) return cached;
+    const position = Object.freeze({
+      line: this.rows[base]!,
+      column: this.rows[base + 1]!,
+      offset,
+    });
+    if (this.positions.size === positionCacheSize)
+      this.positions.delete(this.positions.keys().next().value!);
+    this.positions.set(offset, position);
+    return position;
+  }
+}
+
+function arrayIndex(key: string | symbol): number | undefined {
+  if (typeof key !== "string") return undefined;
+  const index = Number(key);
+  return Number.isSafeInteger(index) && index >= 0 && String(index) === key
+    ? index
+    : undefined;
+}
diff --git a/src/parse/compact-tokens.test.ts b/src/parse/compact-tokens.test.ts
