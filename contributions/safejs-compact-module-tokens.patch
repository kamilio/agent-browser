--- /dev/null
+++ b/src/parse/compact-tokens.test.ts
@@ -0,0 +1,178 @@
+import { expect, it } from "vitest";
+import { Budget, SandboxError } from "../interp/budget.js";
+import { CompactTokens } from "./compact-tokens.js";
+import {
+  functionSources,
+  functionStrictness,
+  templateSources,
+} from "./function-source.js";
+import { parseSourceModule } from "./source-module.js";
+import { tokenize, tokenizeModule } from "./tokenizer.js";
+
+const fixtures = [
+  "import {x} from './dep.js';export const result=await Promise.resolve(x);",
+  "/* before */\r\nexport const astral='😀';\u2028// comment\u2029export const result=`a${astral}b${`c${1}`}`;",
+  "export class Example {#x=1;static {this.marker=2;}get value(){return this.#x;}}",
+  "const value={class:1,async method(){return /a[b-c]+/g;}};for(const item of /a/.exec('a')){};export {value};",
+  `export function long(${Array.from({ length: 400 }, (_, i) => `arg${i}=()=>${i}`).join(",")}){return arg0;}export const result=long();`,
+  `export const result=(${Array.from({ length: 800 }, (_, i) => `v${i}`).join(",")})=>({value:v0,method(){return this.value;}});`,
+  `export const result=[${Array.from({ length: 3000 }, (_, i) => `${i}`).join(",")}];export default function(){return result.length;}`,
+];
+
+it.each(fixtures)("preserves every materialized token for %j", (source) => {
+  const options = {
+    allowRegexLiterals: true,
+    statementList: true,
+    sharedPositions: true,
+  };
+  expect(Array.from(tokenizeModule(source, options))).toEqual(
+    tokenize(source, options),
+  );
+});
+
+it("preserves scanner annotations when the last token becomes historical", () => {
+  const source = "'\\1';`a${`b${1}`}c`;";
+  const options = { allowLegacyEscapes: true, allowRegexLiterals: true };
+  const actual = Array.from(tokenizeModule(source, options));
+  expect(actual).toEqual(tokenize(source, options));
+  expect(actual[0].legacyEscape).toBe(true);
+  expect(actual[2].templateExpressions).toHaveLength(1);
+});
+
+function metadata(root: unknown) {
+  const pending = [root];
+  const visited = new Set<object>();
+  const result: unknown[] = [];
+  while (pending.length) {
+    const value = pending.pop();
+    if (!value || typeof value !== "object" || visited.has(value)) continue;
+    visited.add(value);
+    result.push([
+      functionSources.get(value as Parameters<typeof functionSources.get>[0]),
+      functionStrictness.get(
+        value as Parameters<typeof functionStrictness.get>[0],
+      ),
+      templateSources.get(value as Parameters<typeof templateSources.get>[0]),
+    ]);
+    pending.push(...Object.values(value));
+  }
+  return result;
+}
+
+it.each(fixtures)(
+  "preserves module trees, IDs, source metadata and compilation work for %j",
+  (source) => {
+    function compile(compactTokens: boolean) {
+      const budget = new Budget({
+        maxSteps: 1000000,
+        stringLength: 100000,
+        dataSize: 1000000,
+      });
+      const lease = budget.acquireCompileOwner();
+      try {
+        const parsed = parseSourceModule(source, "fixture.js", lease.owner, {
+          sharedPositions: true,
+          compactTokens,
+        });
+        return {
+          parsed,
+          metadata: metadata(parsed.module),
+          steps: budget.stepsUsed,
+          data: budget.currentDataSize,
+        };
+      } finally {
+        lease.release();
+      }
+    }
+    expect(compile(true)).toEqual(compile(false));
+  },
+);
+
+it.each([
+  "export const = 1;",
+  "export const value=`bad${;}`;",
+  "import {x} from ;",
+  "export const first=1;export const first=2;",
+  "export {missing};",
+  "export const value='\\1';",
+  "export const value=/unterminated;",
+])("preserves syntax diagnostics for %j", (source) => {
+  const errors = [false, true].map((compactTokens) => {
+    try {
+      parseSourceModule(source, "fixture.js", undefined, {
+        sharedPositions: true,
+        compactTokens,
+      });
+    } catch (error) {
+      return error as Error;
+    }
+    throw new Error("Expected syntax rejection.");
+  });
+  expect(errors[1]).toMatchObject({
+    name: errors[0].name,
+    message: errors[0].message,
+  });
+  expect(Object.getOwnPropertyNames(errors[1])).toEqual(
+    Object.getOwnPropertyNames(errors[0]),
+  );
+});
+
+it.each(["steps", "stringLength", "dataSize"] as const)(
+  "preserves compilation %s enforcement",
+  (limit) => {
+    const source =
+      limit === "dataSize"
+        ? "export const value=/a{10}/;"
+        : "export const value=1;";
+    const failures = [false, true].map((compactTokens) => {
+      const budget = new Budget({
+        maxSteps: limit === "steps" ? 3 : 100000,
+        stringLength: limit === "stringLength" ? 3 : 1000,
+        dataSize: limit === "dataSize" ? 1 : 10000,
+      });
+      const lease = budget.acquireCompileOwner();
+      try {
+        parseSourceModule(source, "fixture.js", lease.owner, {
+          sharedPositions: true,
+          compactTokens,
+        });
+      } catch (error) {
+        expect(error).toBeInstanceOf(SandboxError);
+        return { error, steps: budget.stepsUsed };
+      } finally {
+        lease.release();
+      }
+      throw new Error("Expected budget rejection.");
+    });
+    expect(failures[1]).toMatchObject({
+      error: { code: "budgetExceeded", budget: limit },
+      steps: failures[0].steps,
+    });
+  },
+);
+
+it("retires only an ordered token prefix and keeps lookahead/EOF available", () => {
+  const buffer = new CompactTokens().indexed;
+  const point = (offset: number) =>
+    Object.freeze({ line: 1, column: offset + 1, offset });
+  for (let i = 0; i < 1100; i++)
+    buffer.push({
+      type: "identifier",
+      value: `v${i}`,
+      start: point(i),
+      end: point(i + 1),
+    });
+  buffer.push({ type: "eof", value: "", start: point(1100), end: point(1100) });
+  const saved = buffer[0];
+  expect(buffer[1099].value).toBe("v1099");
+  expect(buffer[0]).toEqual(saved);
+  expect(() => {
+    buffer[1] = undefined!;
+  }).toThrow("ordered prefix");
+  for (let i = 0; i < 1099; i++) buffer[i] = undefined!;
+  expect(buffer[0]).toBeUndefined();
+  expect(saved.value).toBe("v0");
+  expect(buffer[1099].value).toBe("v1099");
+  expect(buffer.at(-1)?.type).toBe("eof");
+  expect(buffer[1101]).toBeUndefined();
+});
