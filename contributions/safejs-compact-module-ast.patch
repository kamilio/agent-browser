+      if (kind === 0) {
+        const array = target as unknown[];
+        for (let i = 0; i < array.length; i++)
+          array[i] = value(this.read(index + 2 + i));
+      } else {
+        const shape = this.shapes[kind - 3]!;
+        for (let i = 0; i < shape.keys.length; i++) {
+          const key = shape.keys[i]!;
+          if (!key.startsWith("@"))
