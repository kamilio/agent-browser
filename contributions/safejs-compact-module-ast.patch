+  private decode(reference: number, raw = false): unknown {
+    const tag = reference >>> 28,
+      payload = reference & scalarMask;
+    switch (tag) {
+      case 0:
+        return raw
+          ? new CodeRecord(recordToken, this, payload - 1)
