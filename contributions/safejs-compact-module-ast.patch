+  `function f(){${pad}return tag=>tag\`a\${1}b\`};const tag=(strings,x)=>[strings[0],x,strings[1]];return f()(tag)`,
+  `function* f(){${pad}yield 1;return 2};const iterator=f();return [iterator.next().value,iterator.next().value]`,
+  `async function f(){${pad}return await 3};return await f()`,
+])("preserves execution for %j", async (body) => {
+  const source = `export async function run(){${body}}`;
+  async function run(compact: boolean) {
+    const parsed = compile(source, compact).parsed;
+    // Execute the original function body directly, with the same interpreted context.
+    const fn = parsed.module.body[0] as {
+      body: Parameters<typeof interpret>[0];
+    };
+    return interpret(fn.body);
+  }
+  const control = await run(false),
+    candidate = await run(true);
+  expect(candidate.ok).toBe(true);
+  expect(control.ok).toBe(true);
+  if (!candidate.ok || !control.ok) throw new Error("Execution failed");
+  expect(candidate.returnValue).toEqual(control.returnValue);
+});
+
+it("bounds numeric storage by its admitted source and rejects unsupported scalar values", () => {
+  const storage = new CompactModuleAst("x");
+  expect(() =>
+    storage.pack({ items: Array.from({ length: 2000 }, (_, i) => i) }),
+  ).toThrow("dataSize");
+  const other = new CompactModuleAst("x");
+  expect(() => other.pack({ value: Symbol() })).toThrow("scalar");
+  other.finish();
+  expect(() => other.pack({})).toThrow("finished");
+});
