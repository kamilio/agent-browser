diff --git a/packages/safe-js/src/interp/tracked-object-symbol-data.test.ts b/packages/safe-js/src/interp/tracked-object-symbol-data.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/tracked-object-symbol-data.test.ts
@@ -0,0 +1,110 @@
+import { expect, it, vi } from "vitest";
+import { accessorAdapter } from "./accessors.js";
+import { Budget } from "./budget.js";
+import { internalSymbols } from "./internal-symbols.js";
+import { createIntrinsicObject } from "./object-model.js";
+import { createSandboxClosure, measureSandboxData } from "./values.js";
+
+it("reuses symbol inspection without reusing descendant measurements", () => {
+  const key = Symbol("entry");
+  const child = createIntrinsicObject({ text: "a" });
+  const root = createIntrinsicObject({ [key]: child });
+  const inspect = vi.spyOn(Object, "getOwnPropertySymbols");
+  try {
+    const initial = measureSandboxData([root]);
+    root.uncharged = 1;
+    child.text = "x".repeat(1000);
+    expect(measureSandboxData([root])).toBe(initial + 1009);
+    expect(inspect.mock.calls.filter(([value]) => value === root)).toHaveLength(
+      1,
+    );
+    expect(() =>
+      new Budget({ dataSize: 100 }).reconcileDataUsage(
+        measureSandboxData([root]),
+      ),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  } finally {
+    inspect.mockRestore();
+  }
+});
+
+it("observes symbol assignment, definition, deletion and visibility changes", () => {
+  const key = Symbol("field");
+  const root = createIntrinsicObject({ [key]: "a" });
+  expect(measureSandboxData([root])).toBe(9);
+  root[key] = "longer";
+  expect(measureSandboxData([root])).toBe(14);
+  Object.defineProperty(root, key, { enumerable: false, value: "hidden" });
+  expect(measureSandboxData([root])).toBe(14);
+  delete root[key];
+  expect(measureSandboxData([root])).toBe(1);
+  Object.defineProperty(root, key, { value: "new" });
+  expect(measureSandboxData([root])).toBe(11);
+});
+
+it("captures later symbols before descendant callbacks mutate them", () => {
+  const first = Symbol("first"),
+    later = Symbol("second");
+  const root = createIntrinsicObject();
+  root[first] = createSandboxClosure({
+    call: () => undefined,
+    retainedValues: () => {
+      root[later] = "longer";
+      return [];
+    },
+  });
+  root[later] = "a";
+  expect(measureSandboxData([root])).toBe(18);
+  expect(measureSandboxData([root])).toBe(23);
+});
+
+it("retains accessor captures without invoking getters and drops deleted captures", () => {
+  const key = Symbol("accessor");
+  const getter = vi.fn();
+  const retained = vi.fn(() => ["owned"]);
+  const closure = createSandboxClosure({
+    call: getter,
+    retainedValues: retained,
+  });
+  const root = createIntrinsicObject();
+  Object.defineProperty(root, key, {
+    configurable: true,
+    get: accessorAdapter(closure, "get"),
+  });
+  expect(measureSandboxData([root])).toBe(17);
+  expect(measureSandboxData([root])).toBe(17);
+  expect(getter).not.toHaveBeenCalled();
+  expect(retained).toHaveBeenCalledTimes(2);
+  delete root[key];
+  expect(measureSandboxData([root])).toBe(1);
+  expect(retained).toHaveBeenCalledTimes(2);
+});
+
+it("inspects outer proxies on every walk instead of trusting the wrapped table", () => {
+  const key = Symbol("field");
+  const table = createIntrinsicObject({ [key]: "a" });
+  const root = new Proxy(table, {});
+  const inspect = vi.spyOn(Object, "getOwnPropertySymbols");
+  try {
+    const initial = measureSandboxData([root]);
+    table[key] = "longer";
+    expect(measureSandboxData([root])).toBe(initial + 5);
+    expect(inspect.mock.calls.filter(([value]) => value === root)).toHaveLength(
+      2,
+    );
+  } finally {
+    inspect.mockRestore();
+  }
+});
+
+it("checks internal symbol ownership after a descriptor snapshot is cached", () => {
+  const key = Symbol("late-internal");
+  const root = createIntrinsicObject({ [key]: "owned" });
+  expect(measureSandboxData([root])).toBe(21);
+  internalSymbols.add(key);
+  try {
+    expect(measureSandboxData([root])).toBe(1);
+  } finally {
+    internalSymbols.delete(key);
+  }
+});
