+
+// Cache only SDK-owned descriptor snapshots. Referenced values still need a
+// fresh graph walk, and untracked/proxy wrappers must retain their trap ordering.
+export function trackedObjectSymbolDescriptors(value: object): Array<readonly [symbol, PropertyDescriptor]> | undefined {
+  const state = functionPropertyRevisions.get(value);
+  if (state === undefined) return undefined;
+  if (state.measuredSymbols === undefined) {
+    const descriptors: Array<readonly [symbol, PropertyDescriptor]> = [];
+    for (const key of Object.getOwnPropertySymbols(value)) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, key);
+      if (descriptor !== undefined) descriptors.push([key, descriptor]);
+    }
+    state.measuredSymbols = descriptors;
+  }
+  return state.measuredSymbols;
 }

