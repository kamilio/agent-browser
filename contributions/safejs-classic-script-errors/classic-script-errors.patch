+import { expect, it } from "vitest";
+import { parse } from "../parse.js";
+import { parseExecutableModule } from "../parse/parser.js";
+import { Budget } from "./budget.js";
+import { createBuiltinBindings } from "./globals.js";
+import { interpret, Scope } from "./interpreter.js";
+import { releaseObjectPrototype } from "./object-model.js";
+
+it("reports only an actual throw completion after collecting snapshot and stats", async () => {
+  const node = parse('throw "ordinary"');
+  const result = await interpret(node, { reportUnhandledThrows: true });
+  expect(result).toMatchObject({
+    ok: false,
+    error: { code: "UNCAUGHT_EXCEPTION", name: "Error", message: "ordinary", stack: expect.any(String), nodeType: "ThrowStatement", span: node.span },
+    snapshot: { bindings: expect.any(Object) },
+    stats: { nodeVisits: expect.any(Number), currentDataSize: expect.any(Number) }
+  });
+  expect(result).not.toHaveProperty("recoverable");
+});
+
+it.each([undefined, false])("keeps ordinary unhandled throws throwing without explicit opt-in (%s)", async reportUnhandledThrows => {
+  await expect(interpret(parse("throw 17"), { reportUnhandledThrows })).rejects.toBe(17);
+});
+
+it("normalizes genuine Script ReferenceError completions", async () => {
+  const module = parseExecutableModule("missingReference;");
+  const budget = new Budget();
+  const scope = new Scope(createBuiltinBindings({ budget })).child({}, { globalEnvironment: true });
+  try {
+    expect(await interpret({ type: "BlockStatement", body: module.body, span: module.span }, {
+      budget, scope, useScopeDirectly: true, script: { strict: false }, reportUnhandledThrows: true
+    })).toMatchObject({ ok: false, error: { code: "UNCAUGHT_EXCEPTION", name: "ReferenceError" } });
+  } finally { releaseObjectPrototype(budget); }
+});
+
+it("leaves non-throw interpreter diagnostics unchanged", async () => {
+  expect(await interpret(parse("missingReference"), { reportUnhandledThrows: true }))
+    .toMatchObject({ ok: false, error: { code: "UNBOUND_IDENTIFIER" } });
+});
+
+it("does not turn snapshot/quota reconciliation failures into reported throws", async () => {
+  await expect(interpret(parse('throw "x".repeat(2000)'), {
+    reportUnhandledThrows: true, budget: new Budget({ dataSize: 100 })
+  })).rejects.toMatchObject({ name: "SandboxError", code: "budgetExceeded" });
+});
+
+it("does not recover a forged diagnostic thrown by the activity guard", async () => {
+  const failure = Object.assign(new Error("guard failed"), { code: "UNCAUGHT_EXCEPTION", name: "InterpreterError" });
+  await expect(interpret(parse('throw "ordinary"'), {
+    reportUnhandledThrows: true, assertActive: () => { throw failure; }
+  })).rejects.toBe(failure);
+});
