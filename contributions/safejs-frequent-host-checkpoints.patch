--- /dev/null
+++ b/packages/safe-js/src/interp/jobs-expensive-host-turn.test.ts
@@ -0,0 +1,38 @@
+import { expect, it, vi } from "vitest";
+import { SandboxJobQueue } from "./jobs.js";
+
+it("serves host work within sixteen expensive nodes while keeping guest ownership", async () => {
+  let now = 0;
+  const clock = vi.spyOn(Date, "now").mockImplementation(() => now);
+  const queue = new SandboxJobQueue();
+  queue.enableControl();
+  let hostRan = false;
+  let siblingRan = false;
+  const host = new Promise<void>((resolve) =>
+    setImmediate(() => {
+      hostRan = true;
+      resolve();
+    }),
+  );
+  try {
+    const owner = queue.run(async () => {
+      for (let index = 0; index < 16; index++) {
+        now += 4;
+        const checkpoint = SandboxJobQueue.checkpoint();
+        if (checkpoint !== undefined) await checkpoint;
+        expect(siblingRan).toBe(false);
+      }
+      expect(hostRan).toBe(true);
+    });
+    const sibling = queue.run(() => {
+      siblingRan = true;
+    });
+    await Promise.allSettled([owner, sibling]);
+    await owner;
+    expect(siblingRan).toBe(true);
+  } finally {
+    clock.mockRestore();
+    queue.finish();
+    await host;
+  }
+});
