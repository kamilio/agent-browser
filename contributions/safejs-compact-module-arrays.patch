--- /dev/null
+++ b/src/parse/compact-arrays.test.ts
@@ -0,0 +1,154 @@
+import { expect, it } from "vitest";
+import { Budget } from "../interp/budget.js";
+import {
+  functionSources,
+  functionStrictness,
+  templateSources,
+} from "./function-source.js";
+import { parseSourceModule } from "./source-module.js";
+
+const fixtures = [
+  "",
+  "import {value} from './dep.js';export const result=await Promise.resolve(value);",
+  "export const value=f(1,...items,);export const other=new Constructor(1,2);",
+  "export function f(a=1,{b},...rest){if(a){return b;}else{return rest;}}",
+  "export const f=(a,b)=>{const x=1,y=2;return (a,x,b,y)};",
+  "export const a=[,,1,...items];export const b={x,...other,method(a){return a}};",
+  "export const [a,,...rest]=items;export const {b,c:d=1,...other}=record;",
+  "let a,b,rest;[a,,b,...rest]=items;({a,b,...rest}=record);export {a};",
+  "export const f=()=>({});export const g=()=>[];export function empty(){};f();",
+  "export class A {#x=1;static {this.x=1;}method(a){return a;}get x(){return this.#x}};",
+  "export function f(x){switch(x){case 1:x++;break;case 2:default:return x}};",
+  "export const x=`outer${f(1,...items)}${`inner${2}`}`;",
+  "export function f(){using x=resource,y=other;return x};",
+  `export const x=[${Array.from({ length: 3000 }, (_, i) => i).join(",")}];`,
+  `export function f(${Array.from({ length: 400 }, (_, i) => `a${i}`).join(",")}){return a0;}`,
+];
+
+// Capture metadata and repeated references that structural equality cannot detect.
+function identities(root: unknown) {
+  const pending: Array<[unknown, string]> = [[root, "root"]];
+  const seen = new WeakMap<object, string>();
+  const aliases: Array<[string, string]> = [];
+  const metadata: unknown[] = [];
+  while (pending.length) {
+    const [value, path] = pending.pop()!;
+    if (!value || typeof value !== "object") continue;
+    // Compact coordinates are reconstructible records; compare their data below.
+    if (path.endsWith(".span")) continue;
+    const first = seen.get(value);
+    if (first !== undefined) {
+      aliases.push([path, first]);
+      continue;
+    }
+    seen.set(value, path);
+    if ("nodeId" in value) {
+      metadata.push([
+        value.nodeId,
+        functionSources.get(value as Parameters<typeof functionSources.get>[0]),
+        functionStrictness.get(
+          value as Parameters<typeof functionStrictness.get>[0],
+        ),
+        templateSources.get(value as Parameters<typeof templateSources.get>[0]),
+      ]);
+    }
+    for (const key of Object.keys(value))
+      pending.push([(value as Record<string, unknown>)[key], `${path}.${key}`]);
+  }
+  return { aliases, metadata };
+}
+
+function compile(source: string, compactArrays: boolean, limits = {}) {
+  const budget = new Budget({
+    maxSteps: 1000000,
+    stringLength: 100000,
+    dataSize: 1000000,
+    ...limits,
+  });
+  const lease = budget.acquireCompileOwner();
+  try {
+    budget.chargeDataUsage(source.length + "fixture.js".length + 1);
+    const parsed = parseSourceModule(source, "fixture.js", lease.owner, {
+      sharedPositions: true,
+      compactTokens: true,
+      compactSpans: true,
+      compactArrays,
+    });
+    return {
+      parsed,
+      json: JSON.stringify(parsed),
+      identities: identities(parsed),
+      steps: budget.stepsUsed,
+      data: budget.currentDataSize,
+      peak: budget.peakDataSize,
+    };
+  } finally {
+    lease.release();
+  }
+}
+
+it.each(fixtures)(
+  "preserves trees, source metadata, aliases and accounting for %j",
+  (source) => {
+    expect(compile(source, true)).toEqual(compile(source, false));
+  },
+);
+
+it("keeps child identity and independent mutable list behavior", () => {
+  const parsed = compile(
+    "export const x={x};export const y=f(x);export const z=f(x);",
+    true,
+  ).parsed;
+  const pending: unknown[] = [parsed.module];
+  const calls: Array<{ arguments: unknown[] }> = [];
+  while (pending.length) {
+    const value = pending.pop();
+    if (!value || typeof value !== "object") continue;
+    if ("type" in value && value.type === "CallExpression")
+      calls.push(value as unknown as { arguments: unknown[] });
+    if ("type" in value && value.type === "Property") {
+      const property = value as unknown as { key: unknown; value: unknown };
+      // Shorthand keys and values are separate parser nodes in the public tree.
+      expect(property.key).not.toBe(property.value);
+    }
+    for (const key of Object.keys(value))
+      if (key !== "span") pending.push((value as Record<string, unknown>)[key]);
+  }
+  expect(calls).toHaveLength(2);
+  const saved = calls[0]!.arguments[0];
+  expect(calls[0]!.arguments).not.toBe(calls[1]!.arguments);
+  expect(Object.getPrototypeOf(calls[0]!.arguments)).toBe(Array.prototype);
+  expect(Object.getOwnPropertyDescriptor(calls[0]!.arguments, "0")).toEqual({
+    value: saved,
+    writable: true,
+    configurable: true,
+    enumerable: true,
+  });
+  calls[0]!.arguments.push(saved);
+  expect(calls[1]!.arguments).toHaveLength(1);
+  calls[0]!.arguments.splice(0, 1);
+  expect(calls[0]!.arguments[0]).toBe(saved);
+  delete calls[0]!.arguments[0];
+  expect(0 in calls[0]!.arguments).toBe(false);
+  calls[0]!.arguments.length = 0;
+  expect(calls[1]!.arguments).toHaveLength(1);
+});
+
+it.each([{ maxSteps: 1 }, { stringLength: 5 }, { dataSize: 5 }])(
+  "preserves compile failures for %j",
+  (limits) => {
+    function outcome(compact: boolean) {
+      try {
+        compile("export const x=f(1,2,3);", compact, limits);
+        return "success";
+      } catch (error) {
+        return {
+          name: (error as Error).name,
+          message: (error as Error).message,
+        };
+      }
+    }
+    expect(outcome(true)).toEqual(outcome(false));
+    expect(outcome(true)).not.toBe("success");
+  },
+);
