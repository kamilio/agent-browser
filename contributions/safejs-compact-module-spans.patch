@@ -0,0 +1,243 @@
+import { expect, it } from "vitest";
+import { Budget, SandboxError } from "../interp/budget.js";
+import { CompactSourcePositions, compactSourceSpan } from "./compact-spans.js";
+import {
+  functionSources,
+  functionStrictness,
+  templateSources,
+} from "./function-source.js";
+import { parseSourceModule } from "./source-module.js";
+import { tokenize, tokenizeModule } from "./tokenizer.js";
+
+const fixtures = [
+  "",
+  "import {x} from './dep.js';export const result=await Promise.resolve(x);",
+  "/* before */\r\nexport const astral='😀';\u2028// comment\u2029export const result=`a${astral}b${`c${1}`}`;\n",
+  "export class Example {#x=1;static {this.marker=2;}get value(){return this.#x;}}",
+  "export const value={async method(){return /a[b-c]+/g;}};outer:for(const item of /a/.exec('a')){if(item)break outer;}",
+  "export default function named(){return (1+2)};export const arrow=(x)=>({x,method(){return this.x;}});",
+  "export const value=`first\u2028second${1}\u2029third`;",
+  "export const value=`first\r\n${(()=>{return `nested${2}`})()}\nlast`;",
+  `export const result=(${Array.from({ length: 800 }, (_, i) => `v${i}`).join(",")})=>({value:v0});`,
+  `export const result=[${Array.from({ length: 3000 }, (_, i) => `${i}`).join(",")}];export default function(){return result.length;}`,
+];
+
+function metadata(root: unknown) {
+  const pending = [root];
+  const visited = new Set<object>();
+  const result: unknown[] = [];
+  while (pending.length) {
+    const value = pending.pop();
+    if (!value || typeof value !== "object" || visited.has(value)) continue;
+    // Only AST identities matter; reconstructed coordinate records may share less.
+    if ("nodeId" in value) {
+      visited.add(value);
+      result.push([
+        (value as { nodeId?: number }).nodeId,
+        functionSources.get(value as Parameters<typeof functionSources.get>[0]),
+        functionStrictness.get(
+          value as Parameters<typeof functionStrictness.get>[0],
+        ),
+        templateSources.get(value as Parameters<typeof templateSources.get>[0]),
+      ]);
+    }
+    pending.push(...Object.values(value));
+  }
+  return result;
+}
+
+it.each(fixtures)(
+  "preserves source coordinates and token data for %j",
+  (source) => {
+    const options = {
+      allowRegexLiterals: true,
+      statementList: true,
+      sharedPositions: true,
+    };
+    const positions = new CompactSourcePositions(source);
+    expect(Array.from(tokenizeModule(source, options, positions))).toEqual(
+      tokenize(source, options),
+    );
+  },
+);
+
+it.each(fixtures)(
+  "preserves complete trees, IDs, metadata, JSON and budgets for %j",
+  (source) => {
+    function compile(compactSpans: boolean) {
+      const budget = new Budget({
+        maxSteps: 1000000,
+        stringLength: 100000,
+        dataSize: 1000000,
+      });
+      const lease = budget.acquireCompileOwner();
+      try {
+        const parsed = parseSourceModule(source, "fixture.js", lease.owner, {
+          sharedPositions: true,
+          compactTokens: true,
+          compactSpans,
+        });
+        return {
+          parsed,
+          json: JSON.stringify(parsed),
+          metadata: metadata(parsed.module),
+          steps: budget.stepsUsed,
+          data: budget.currentDataSize,
+        };
+      } finally {
+        lease.release();
+      }
+    }
+    expect(compile(true)).toEqual(compile(false));
+  },
+);
+
+it("keeps public span fields as independent mutable data records", () => {
+  const parsed = parseSourceModule("export const value=1;");
+  const span = parsed.module.span;
+  expect(Object.getOwnPropertyDescriptor(span, "start")).toMatchObject({
+    value: span.start,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+  expect(Object.isFrozen(span.start)).toBe(false);
+});
+
+it("keeps own enumerable fields, assignments, sealing and freezing", () => {
+  const owner = new CompactSourcePositions("a\r\nb\u2028c");
+  const span = owner.span(0, 6);
+  expect(Object.keys(span)).toEqual(["start", "end"]);
+  expect(JSON.parse(JSON.stringify(span))).toEqual({
+    start: { line: 1, column: 1, offset: 0 },
+    end: { line: 3, column: 2, offset: 6 },
+  });
+  const point = { line: 99, column: 88, offset: 77 };
+  span.start = point;
+  expect(span.start).toBe(point);
+  span.end = owner.position(3);
+  expect(span.end).toEqual({ line: 2, column: 1, offset: 3 });
+  Object.seal(span);
+  span.start = owner.position(0);
+  expect(span.start.offset).toBe(0);
+  Object.freeze(span);
+  expect(() => {
+    span.start = point;
+  }).toThrow("frozen");
+  expect(() => {
+    span.end = point;
+  }).toThrow("frozen");
+});
+
+it("keeps saved coordinates immutable and correct after bounded cache eviction", () => {
+  const owner = new CompactSourcePositions("x".repeat(2000));
+  const span = owner.span(1, 2);
+  const saved = span.start;
+  for (let offset = 0; offset < 1500; offset++) owner.position(offset);
+  expect(span.start).toEqual(saved);
+  expect(Object.isFrozen(saved)).toBe(true);
+  expect(() => {
+    saved.offset = 9;
+  }).toThrow(TypeError);
+});
+
+it("keeps deleted endpoint fields absent until assigned again", () => {
+  const owner = new CompactSourcePositions("abc");
+  const span = owner.span(0, 3);
+  delete (span as Partial<typeof span>).start;
+  expect(span.start).toBeUndefined();
+  expect(Object.keys(span)).toEqual(["end"]);
+  span.start = owner.position(1);
+  expect(span.start.offset).toBe(1);
+});
+
+it("rejects foreign and forged ownership and keeps separate source coordinates", () => {
+  const first = new CompactSourcePositions("a\nb");
+  const second = new CompactSourcePositions("abc");
+  expect(
+    compactSourceSpan(first.position(0), second.position(3)),
+  ).toBeUndefined();
+  expect(
+    compactSourceSpan({ ...first.position(0) }, { ...first.position(3) }),
+  ).toBeUndefined();
+  expect(compactSourceSpan(first.position(0), first.position(3))?.end).toEqual({
+    line: 2,
+    column: 2,
+    offset: 3,
+  });
+  expect(
+    compactSourceSpan(second.position(0), second.position(3))?.end,
+  ).toEqual({ line: 1, column: 4, offset: 3 });
+});
+
+it("rejects offsets outside their source before publishing owned coordinates", () => {
+  const owner = new CompactSourcePositions("abc");
+  for (const offset of [-1, 4, 0.5, NaN, Infinity]) {
+    expect(() => owner.position(offset)).toThrow(RangeError);
+    expect(() => owner.span(0, offset)).toThrow(RangeError);
+  }
+  expect(owner.position(3)).toEqual({ line: 1, column: 4, offset: 3 });
+});
+
+it.each([
+  "export const = 1;",
+  "export const value=`bad${;}`;",
+  "import {x} from ;",
+  "export {missing};",
+  "export const value='\\1';",
+])("preserves diagnostics for %j", (source) => {
+  const errors = [false, true].map((compactSpans) => {
+    try {
+      parseSourceModule(source, "fixture.js", undefined, {
+        sharedPositions: true,
+        compactTokens: true,
+        compactSpans,
+      });
+    } catch (error) {
+      return error as Error;
+    }
+    throw new Error("Expected syntax rejection.");
+  });
+  expect(errors[1]).toMatchObject({
+    name: errors[0].name,
+    message: errors[0].message,
+  });
+  expect(Object.getOwnPropertyNames(errors[1])).toEqual(
+    Object.getOwnPropertyNames(errors[0]),
+  );
+});
+
+it.each(["steps", "stringLength", "dataSize"] as const)(
+  "preserves compilation %s enforcement",
+  (limit) => {
+    const source =
+      limit === "dataSize"
+        ? "export const value=/a{10}/;"
+        : "export const value=1;";
+    const failures = [false, true].map((compactSpans) => {
+      const budget = new Budget({
+        maxSteps: limit === "steps" ? 3 : 100000,
+        stringLength: limit === "stringLength" ? 3 : 1000,
+        dataSize: limit === "dataSize" ? 1 : 10000,
+      });
+      const lease = budget.acquireCompileOwner();
+      try {
+        parseSourceModule(source, "fixture.js", lease.owner, {
+          sharedPositions: true,
+          compactTokens: true,
+          compactSpans,
+        });
+      } catch (error) {
+        expect(error).toBeInstanceOf(SandboxError);
+        return { error, steps: budget.stepsUsed };
+      } finally {
+        lease.release();
+      }
+      throw new Error("Expected budget rejection.");
+    });
+    expect(failures[1]).toMatchObject({
+      error: { code: "budgetExceeded", budget: limit },
+      steps: failures[0].steps,
+    });
+  },
+);
