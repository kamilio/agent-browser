diff --git a/src/parse/compact-module-ast.test.ts b/src/parse/compact-module-ast.test.ts
--- a/src/parse/compact-module-ast.test.ts
+++ b/src/parse/compact-module-ast.test.ts
@@ -290,3 +290,46 @@
   other.finish();
   expect(() => other.pack({})).toThrow("finished");
