+
+it("links binding names without decoding or executing large initializers", async () => {
+  const { SourceModuleGraph } = await import("../modules/source-graph.js");
+  const { Scope } = await import("../interp/scope.js");
+  const { createModuleEnvironment } = await import("../modules/registry.js");
+  const budget = new Budget({ maxSteps: 1000000, dataSize: 1000000 });
+  const lease = budget.acquireCompileOwner();
+  const graph = new SourceModuleGraph({
+    resolver: () => undefined,
+    scope: new Scope({}),
+    budget,
+    compileOwner: lease.owner,
+    modules: createModuleEnvironment(undefined, {
+      budget,
+      compileOwner: lease.owner,
+    }),
+  });
+  const values = Array.from(
+    { length: 250 },
+    (_, i) => `{value:[${i},${i + 1}]}`,
+  ).join(",");
+  try {
+    const namespace = await graph.evaluateSource(
+      {
+        id: "large.js",
+        source: `let runs=0; export const values=(runs++, [${values}]); export {runs};`,
+      },
+      (module) => {
+        expect(compactAstStatistics(module)!.materializedRecords).toBeLessThan(
+          80,
+        );
+      },
+    );
+    expect(namespace.runs).toBe(1);
+    const result = namespace.values as Array<{ value: number[] }>;
+    expect(result.length).toBe(250);
+    expect(result[0]!.value).toEqual([0, 1]);
+    expect(result[249]!.value).toEqual([249, 250]);
+  } finally {
+    graph.close();
+    lease.release();
+  }
+});
