+import { expect, it, vi } from "vitest";
+import { parse } from "../parse.js";
+import { Budget } from "./budget.js";
+import { interpret } from "./interpreter.js";
+import { markDescriptorObject, setSandboxPrototype } from "./object-model.js";
+import { deepCopyFromSandbox, measureSandboxData, type SandboxObject } from "./values.js";
+
+async function literal(source = "return { text: 'abc', nested: { text: 'initial' } }"): Promise<SandboxObject> {
+  const result = await interpret(parse(source), { budget: new Budget() });
+  expect(result.ok).toBe(true);
+  if (!result.ok || result.returnValue === null || typeof result.returnValue !== "object") throw new Error("Expected object literal");
+  return result.returnValue as SandboxObject;
+}
+
+it("does not recapture unchanged literal string descriptors on repeated measurement", async () => {
+  const value = await literal();
+  const before = measureSandboxData([value]);
+  const descriptors = vi.spyOn(Object, "getOwnPropertyDescriptor");
+  try {
+    expect(measureSandboxData([value])).toBe(before);
+    expect(descriptors.mock.calls.filter(([owner, key]) => owner === value && typeof key === "string")).toHaveLength(0);
+  } finally { descriptors.mockRestore(); }
+});
+
+it("observes replacement, addition and deletion without stale projections", async () => {
+  const value = await literal();
+  const before = measureSandboxData([value]);
+  value.text = "longer";
+  expect(measureSandboxData([value])).toBe(before + 3);
+  value.extra = "new";
+  expect(measureSandboxData([value])).toBe(before + 12);
+  delete value.extra;
+  delete value.text;
+  expect(measureSandboxData([value])).toBe(before - 8);
+});
+
+it("remeasures nested growth and deduplicates shared descendants", async () => {
+  const value = await literal();
+  const nested = value.nested as SandboxObject;
+  const before = measureSandboxData([value]);
+  nested.text = "x".repeat(1000);
+  expect(measureSandboxData([value])).toBe(before + 993);
+  value.alias = nested;
+  expect(measureSandboxData([value, nested])).toBe(before + 999);
+  const budget = new Budget({ dataSize: 100 });
+  expect(() => budget.reconcileDataUsage(measureSandboxData([value]))).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  nested.text = "initial";
+  expect(measureSandboxData([value])).toBe(before + 6);
+});
+
+it("preserves hidden descriptor and symbol changes after an initial capture", async () => {
+  const value = await literal("return { text: 'abc' }");
+  const before = measureSandboxData([value]);
+  Object.defineProperty(value, "hidden", { value: "abc", configurable: true });
+  expect(measureSandboxData([value])).toBe(before);
+  markDescriptorObject(value);
+  expect(measureSandboxData([value])).toBe(before + 10);
+  Object.defineProperty(value, "hidden", { value: "longer", enumerable: true });
+  expect(measureSandboxData([value])).toBe(before + 13);
+  const key = Symbol("owned");
+  value[key] = "abc";
+  expect(measureSandboxData([value])).toBe(before + 23);
+  delete value[key];
+  delete value.hidden;
+  expect(measureSandboxData([value])).toBe(before);
+});
+
+it("keeps prototype data live and exports ordinary records", async () => {
+  const value = await literal("return { text: 'abc' }");
+  const prototype = { extra: "abc" };
+  const before = measureSandboxData([value]);
+  expect(deepCopyFromSandbox(value)).toEqual({ text: "abc" });
+  setSandboxPrototype(value, prototype);
+  expect(measureSandboxData([value])).toBe(before + 10);
+  prototype.extra = "longer";
+  expect(measureSandboxData([value])).toBe(before + 13);
+  expect(() => deepCopyFromSandbox(value)).toThrow("Guest prototype links and custom descriptors cannot be copied as data");
+});
+
+it("does not trust an outer host proxy or omit its descriptor observations", async () => {
+  const value = await literal("return { text: 'abc' }");
+  const reads = vi.fn(Reflect.getOwnPropertyDescriptor);
+  const proxy = new Proxy<SandboxObject>(value, { getOwnPropertyDescriptor: reads });
+  const before = measureSandboxData([proxy]);
+  reads.mockClear();
+  expect(measureSandboxData([proxy])).toBe(before);
+  expect(reads.mock.calls.some(([, key]) => key === "text")).toBe(true);
+  expect(() => deepCopyFromSandbox(proxy)).toThrow("Unsupported proxy sandbox value");
+});
