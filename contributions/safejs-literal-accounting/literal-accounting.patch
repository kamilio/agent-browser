@@ -0,0 +1,105 @@
+import { expect, it, vi } from "vitest";
+import { dump } from "./dump.js";
+import { createIntrinsicObject, isTrackedIntrinsicObject } from "./interp/object-model.js";
+import { restore } from "./restore.js";
+import { run } from "./run.js";
+import { validateRuntimeSnapshotDescriptors, validateSnapshotData } from "./snapshot/validation.js";
+
+it("restores an in-memory snapshot containing a newly created literal", async () => {
+  const source = "const value={text:'abc'};return value.text";
+  const first = await run(source);
+  expect(first).toMatchObject({ ok: true, returnValue: "abc" });
+  const snapshot = restore(first.snapshot, { source });
+  expect(await run(source, { snapshot })).toMatchObject({ ok: true, returnValue: "abc" });
+});
+
+it.each([
+  ["const child={text:'abc'};const value={left:child,right:child};return value.left===value.right&&value.right.text", "abc"],
+  ["const value={text:'abc'};Object.defineProperty(value,'hidden',{value:{text:'hidden'}});return value.hidden.text", "hidden"],
+  ["const base={text:'inherited'};const value={__proto__:base};return value.text", "inherited"],
+  ["let reads=0;const value={get text(){reads++;return 'abc'}};return reads", 0]
+])("roundtrips nested and descriptor literal state: %s", async (source, expected) => {
+  const first = await run(source);
+  expect(first).toMatchObject({ ok: true, returnValue: expected });
+  expect(isTrackedIntrinsicObject(first.snapshot.bindings.value as object)).toBe(true);
+  const runtime = restore(first.snapshot, { source });
+  expect(await run(source, { snapshot: runtime })).toMatchObject({ ok: true, returnValue: expected });
+  const portable = JSON.parse(await dump(first));
+  const restored = restore(portable, { source });
+  expect(await run(source, { snapshot: restored })).toMatchObject({ ok: true, returnValue: expected });
+});
+
+it("keeps descriptor state on the invalidState portable fallback", async () => {
+  const source = "const value={text:'abc'};Object.defineProperty(value,'hidden',{value:'kept'});return value.hidden";
+  const first = await run(source);
+  const restored = restore(first.snapshot, { source });
+  expect(restored).not.toBe(first.snapshot);
+  expect(await run(source, { snapshot: restored })).toMatchObject({ ok: true, returnValue: "kept" });
+});
+
+it("does not transfer runtime trust to copied or forged envelopes", async () => {
+  const source = "return 1";
+  const first = await run(source);
+  const wrapper = createIntrinsicObject({ text: "abc" });
+  first.snapshot.extra = wrapper;
+  expect(restore(first.snapshot, { source })).toBe(first.snapshot);
+  expect(() => restore({ ...first.snapshot }, { source })).toThrow(expect.objectContaining({ code: "invalidType" }));
+  const forged = JSON.parse(await dump(first));
+  forged.extra = wrapper;
+  expect(() => restore(forged, { source })).toThrow(expect.objectContaining({ code: "invalidType", path: "$.extra" }));
+});
+
+it.each([false, true])("rejects exact branded wrappers in plain data, nested=%s", nested => {
+  const wrapper = createIntrinsicObject({ text: "abc" });
+  expect(() => validateSnapshotData(nested ? { wrapper } : wrapper)).toThrow(expect.objectContaining({
+    code: "invalidType", path: nested ? "$.wrapper" : "$"
+  }));
+});
+
+it.each(["unknown", "outer", "revoked"])("rejects %s host proxies without traps on both runtime paths", async kind => {
+  const source = "return 1";
+  const first = await run(source);
+  const trap = vi.fn((): never => { throw new Error("Host proxy trap ran"); });
+  const target = kind === "unknown" ? {} : createIntrinsicObject({ text: "abc" });
+  const pair = Proxy.revocable(target, {
+    get: trap, has: trap, ownKeys: trap, getPrototypeOf: trap, getOwnPropertyDescriptor: trap
+  });
+  if (kind === "revoked") pair.revoke();
+  expect(isTrackedIntrinsicObject(pair.proxy)).toBe(false);
+  first.snapshot.extra = pair.proxy;
+  expect(() => restore(first.snapshot, { source })).toThrow(expect.objectContaining({ code: "invalidType", path: "$.extra" }));
+  expect(() => validateRuntimeSnapshotDescriptors(first.snapshot)).toThrow(expect.objectContaining({ code: "invalidType", path: "$.extra" }));
+  expect(trap).not.toHaveBeenCalled();
+});
+
+it.each([false, true])("rejects caller getters on tracked literals without reading them, enumerable=%s", async enumerable => {
+  const source = "const value={text:'abc'};return value.text";
+  const first = await run(source);
+  const getter = vi.fn((): never => { throw new Error("Host getter ran"); });
+  Object.defineProperty(first.snapshot.bindings.value, "caller", { get: getter, enumerable });
+  expect(() => restore(first.snapshot, { source })).toThrow(expect.objectContaining({
+    code: "invalidType", path: "$.bindings.value.caller"
+  }));
+  expect(getter).not.toHaveBeenCalled();
+});
+
+it.each(["getter", "outer-proxy"])("keeps rejecting caller %s after guest descriptor fallback", async kind => {
+  const source = "const value={get text(){return 'abc'}};return 1";
+  const first = await run(source);
+  const callback = vi.fn((): never => { throw new Error("Caller code ran"); });
+  const value = first.snapshot.bindings.value as object;
+  if (kind === "getter") Object.defineProperty(value, "caller", { get: callback });
+  else Object.defineProperty(value, "caller", { value: new Proxy(createIntrinsicObject(), {
+    get: callback, ownKeys: callback, getPrototypeOf: callback, getOwnPropertyDescriptor: callback
+  }), enumerable: true });
+  expect(() => restore(first.snapshot, { source })).toThrow(expect.objectContaining({
+    code: "invalidType", path: "$.bindings.value.caller"
+  }));
+  expect(callback).not.toHaveBeenCalled();
+});
+
+it("still checks source identity after accepting a tracked literal", async () => {
+  const source = "const value={text:'abc'};return value.text";
+  const first = await run(source);
+  expect(() => restore(first.snapshot, { source: "const value={text:'changed'};return value.text" })).toThrow(expect.objectContaining({ name: "SnapshotMismatchError" }));
+});
