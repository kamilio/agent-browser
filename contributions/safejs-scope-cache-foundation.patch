@@ -0,0 +1,63 @@
+import { expect, it } from "vitest";
+import { Budget } from "./budget.js";
+import { createBuiltinBindings } from "./globals.js";
+import { Scope } from "./scope.js";
+import { measureSandboxData } from "./values.js";
+
+it("remeasures deleted bindings and aliases while preserving earlier snapshots", () => {
+  const parent = new Scope();
+  parent.declareVar("text", { functionValue: "abc", deletable: true });
+  parent.declareAlias("alias", "text");
+  const child = parent.child({ local: "x" });
+  const original = child.retainedDataRoots();
+  expect(measureSandboxData(original)).toBe(4);
+  expect(parent.deleteBinding("text")).toBe(true);
+  const aliased = child.retainedDataRoots();
+  expect(measureSandboxData(aliased)).toBe(4);
+  expect(aliased[0]).not.toBe(original[0]);
+  expect(parent.deleteBinding("alias")).toBe(true);
+  expect(measureSandboxData(child.retainedDataRoots())).toBe(1);
+  expect(measureSandboxData(original)).toBe(4);
+});
+
+it("invalidates ancestor snapshots when an empty scope is hydrated", () => {
+  const parent = new Scope();
+  const child = parent.child({ local: "x" });
+  const original = child.retainedDataRoots();
+  const donor = new Scope({ text: "abc" });
+  parent.hydrateFrame(donor.captureFrame());
+  const hydrated = child.retainedDataRoots();
+  expect(hydrated[0]).not.toBe(original[0]);
+  expect(measureSandboxData(hydrated)).toBe(4);
+  expect(measureSandboxData(original)).toBe(1);
+});
+
+it("remeasures mutable descendants even when scope snapshot identity is reused", () => {
+  const payload = { text: "abc" };
+  const parent = new Scope({ payload });
+  const child = parent.child({ local: "x" });
+  const before = child.retainedDataRoots();
+  const initial = measureSandboxData(before);
+  payload.text = "x".repeat(1000);
+  const after = child.retainedDataRoots();
+  expect(after[0]).toBe(before[0]);
+  expect(measureSandboxData(after)).toBe(initial + 997);
+  const budget = new Budget({ dataSize: initial });
+  expect(() => budget.reconcileDataUsage(measureSandboxData(after))).toThrow(
+    expect.objectContaining({ budget: "dataSize" }),
+  );
+});
+
+it("invalidates captured declaration names for deletable classic globals", () => {
+  const bindings = createBuiltinBindings({ budget: new Budget() });
+  const parent = new Scope(bindings, undefined, undefined, { chargeData: false });
+  const global = parent.child({}, { globalEnvironment: true });
+  const child = global.child();
+  const before = child.retainedDataRoots();
+  global.declareVar("temporary", { deletable: true });
+  const declared = child.retainedDataRoots();
+  expect(declared[0]).not.toBe(before[0]);
+  expect(measureSandboxData(declared)).toBeGreaterThan(measureSandboxData(before));
+  expect(global.deleteGlobalBinding("temporary")).toBe(true);
+  expect(measureSandboxData(child.retainedDataRoots())).toBe(measureSandboxData(before));
+});
