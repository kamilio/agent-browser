+import type { Budget } from "./budget.js";
+
+const NativeArrayBuffer = ArrayBuffer;
+const NativeUint8Array = Uint8Array;
+const NativeDataView = DataView;
+const nativeIsView = ArrayBuffer.isView;
+const getPrototypeOf = Object.getPrototypeOf;
+const apply = Reflect.apply;
+const typedArrayPrototype = getPrototypeOf(Uint8Array.prototype);
+const readArrayBufferLength = intrinsicGetter(ArrayBuffer.prototype, "byteLength");
+const readResizable = Object.getOwnPropertyDescriptor(ArrayBuffer.prototype, "resizable")?.get;
+const readTypedBuffer = intrinsicGetter(typedArrayPrototype, "buffer");
+const readTypedOffset = intrinsicGetter(typedArrayPrototype, "byteOffset");
+const readTypedLength = intrinsicGetter(typedArrayPrototype, "byteLength");
+const readTypedTag = intrinsicGetter(typedArrayPrototype, Symbol.toStringTag);
+const readViewBuffer = intrinsicGetter(DataView.prototype, "buffer");
+const readViewOffset = intrinsicGetter(DataView.prototype, "byteOffset");
+const readViewLength = intrinsicGetter(DataView.prototype, "byteLength");
+const setBytes = Uint8Array.prototype.set;
+
+function intrinsicGetter(target: object, property: PropertyKey): (this: unknown) => unknown {
+  const getter = Object.getOwnPropertyDescriptor(target, property)?.get;
+  if (typeof getter !== "function") throw new TypeError("Missing native binary storage getter.");
+  return getter;
+}
+
+export type BinaryStorage = {
+  kind: "arraybuffer" | "uint8array" | "dataview";
+  buffer: ArrayBuffer;
+  byteOffset: number;
+  byteLength: number;
+  bufferByteLength: number;
+};
+
+export type BinaryCopyState = {
+  buffers: WeakMap<ArrayBuffer, ArrayBuffer>;
+};
+
+export function binaryStorage(value: unknown): BinaryStorage {
+  try {
+    let kind: BinaryStorage["kind"];
+    let buffer: ArrayBuffer;
+    let byteOffset: number;
+    let byteLength: number;
+    if (nativeIsView(value)) {
+      const prototype = getPrototypeOf(value);
+      if (
+        prototype === NativeUint8Array.prototype &&
+        apply(readTypedTag, value, []) === "Uint8Array"
+      ) {
+        kind = "uint8array";
+        buffer = apply(readTypedBuffer, value, []) as ArrayBuffer;
+        byteOffset = apply(readTypedOffset, value, []) as number;
+        byteLength = apply(readTypedLength, value, []) as number;
+      } else if (prototype === NativeDataView.prototype) {
+        kind = "dataview";
+        buffer = apply(readViewBuffer, value, []) as ArrayBuffer;
+        byteOffset = apply(readViewOffset, value, []) as number;
+        byteLength = apply(readViewLength, value, []) as number;
+      } else {
+        throw new TypeError();
+      }
+    } else {
+      byteLength = apply(readArrayBufferLength, value, []) as number;
+      kind = "arraybuffer";
+      buffer = value as ArrayBuffer;
+      byteOffset = 0;
+    }
+    const bufferByteLength = apply(readArrayBufferLength, buffer, []) as number;
+    if (
+      getPrototypeOf(buffer) !== NativeArrayBuffer.prototype ||
+      (readResizable !== undefined && apply(readResizable, buffer, []))
+    ) {
+      throw new TypeError();
+    }
+    new NativeUint8Array(buffer, 0, 0);
+    return { kind, buffer, byteOffset, byteLength, bufferByteLength };
+  } catch {
+    throw new TypeError(
+      "Binary storage requires a native fixed, non-shared, non-detached ArrayBuffer, Uint8Array or DataView."
+    );
+  }
+}
+
+export function copyBinaryStorage(
+  value: unknown,
+  state: BinaryCopyState,
+  budget: Budget
+): ArrayBuffer | Uint8Array | DataView {
+  const storage = binaryStorage(value);
+  budget.allocateArrayLength(storage.bufferByteLength);
+  const existing = state.buffers.get(storage.buffer);
+  const release = budget.provisionDataUsage(
+    (existing === undefined ? storage.bufferByteLength : 0) + 1
+  );
+  try {
+    const buffer = existing ?? new NativeArrayBuffer(storage.bufferByteLength);
+    if (existing === undefined) {
+      apply(setBytes, new NativeUint8Array(buffer), [new NativeUint8Array(storage.buffer)]);
+    }
+    const copy =
+      storage.kind === "arraybuffer"
+        ? buffer
+        : storage.kind === "uint8array"
+          ? new NativeUint8Array(buffer, storage.byteOffset, storage.byteLength)
+          : new NativeDataView(buffer, storage.byteOffset, storage.byteLength);
+    if (existing === undefined) state.buffers.set(storage.buffer, buffer);
+    return copy;
+  } finally {
+    release();
+  }
+}
