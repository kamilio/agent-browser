+  const realm = createRealm({
+    callbackScheduling: "after-prefix",
+    ...options,
+    bindings: {
+      save: (callback: unknown) => { callbacks.push(callback); },
+      mark: (value: unknown) => { marks.push(value); },
+      wait: () => tail.promise,
+      sourceWait: () => { sourceEntered.resolve(); return sourceWait.promise; },
+      ...options.bindings
+    }
+  });
+  return { realm, callbacks, marks, tail, sourceEntered, sourceWait };
