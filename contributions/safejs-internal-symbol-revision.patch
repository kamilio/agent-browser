+import { expect, it } from "vitest";
+import { internalSymbols, internalSymbolRevision } from "./internal-symbols.js";
+
+it("changes revision only when catalogue membership changes", () => {
+  const key = Symbol("revision");
+  const before = internalSymbolRevision();
+  expect(internalSymbols.delete(key)).toBe(false);
+  expect(internalSymbolRevision()).toBe(before);
+  expect(internalSymbols.add(key)).toBe(internalSymbols);
+  const added = internalSymbolRevision();
+  expect(added).not.toBe(before);
+  try {
+    internalSymbols.add(key);
+    expect(internalSymbolRevision()).toBe(added);
+    expect(internalSymbols.delete(key)).toBe(true);
+    expect(internalSymbolRevision()).not.toBe(added);
+  } finally {
+    internalSymbols.delete(key);
+  }
+});
+
+it("preserves catalogue order, iteration and forEach receiver semantics", () => {
+  const first = Symbol("first"),
+    later = Symbol("later");
+  const size = internalSymbols.size;
+  internalSymbols.add(first).add(later);
+  try {
+    expect(internalSymbols.size).toBe(size + 2);
+    expect([...internalSymbols].slice(-2)).toEqual([first, later]);
+    expect([...internalSymbols.keys()]).toEqual([...internalSymbols.values()]);
+    expect([...internalSymbols.entries()].slice(-2)).toEqual([
+      [first, first],
+      [later, later],
+    ]);
+    const receiver = {};
+    const visited: symbol[] = [];
+    internalSymbols.forEach(function (this: unknown, value, key, catalogue) {
+      expect(this).toBe(receiver);
+      expect(value).toBe(key);
+      expect(catalogue).toBe(internalSymbols);
+      if (value === first || value === later) visited.push(value);
+    }, receiver);
+    expect(visited).toEqual([first, later]);
+    expect(Object.prototype.toString.call(internalSymbols)).toBe(
+      "[object Set]",
+    );
+  } finally {
+    internalSymbols.delete(first);
+    internalSymbols.delete(later);
+  }
+});
+
+it("supports live iteration when a forEach callback adds a later marker", () => {
+  const first = Symbol("first"),
+    later = Symbol("later");
+  internalSymbols.add(first);
+  const visited: symbol[] = [];
+  try {
+    internalSymbols.forEach((value) => {
+      if (value === first) {
+        visited.push(value);
+        internalSymbols.add(later);
+      } else if (value === later) visited.push(value);
+    });
+    expect(visited).toEqual([first, later]);
+  } finally {
+    internalSymbols.delete(first);
+    internalSymbols.delete(later);
+  }
+});
+
+it("revises clear and leaves an empty catalogue unchanged on a second clear", () => {
+  const all = [...internalSymbols];
+  internalSymbols.add(Symbol("clear-seed"));
+  const before = internalSymbolRevision();
+  try {
+    internalSymbols.clear();
+    const cleared = internalSymbolRevision();
+    expect(cleared).not.toBe(before);
+    expect(internalSymbols.size).toBe(0);
+    internalSymbols.clear();
+    expect(internalSymbolRevision()).toBe(cleared);
+  } finally {
+    for (const key of all) internalSymbols.add(key);
+  }
+});
+
+it("rejects borrowed native mutations so membership cannot bypass its revision", () => {
+  const key = Symbol("borrowed");
+  const before = internalSymbolRevision();
+  expect(() => Set.prototype.add.call(internalSymbols, key)).toThrow(TypeError);
+  expect(() => Set.prototype.delete.call(internalSymbols, key)).toThrow(
+    TypeError,
+  );
+  expect(() => Set.prototype.clear.call(internalSymbols)).toThrow(TypeError);
+  expect(internalSymbols.has(key)).toBe(false);
+  expect(internalSymbolRevision()).toBe(before);
+  expect(Object.isFrozen(internalSymbols)).toBe(true);
+});
+
+it("rejects a noncallable forEach callback even when the catalogue is empty", () => {
+  const all = [...internalSymbols];
+  try {
+    internalSymbols.clear();
+    expect(() => internalSymbols.forEach(null as never)).toThrow(TypeError);
+    internalSymbols.add(Symbol("nonempty"));
+    expect(() => internalSymbols.forEach(null as never)).toThrow(TypeError);
+  } finally {
+    internalSymbols.clear();
+    for (const key of all) internalSymbols.add(key);
+  }
+});
