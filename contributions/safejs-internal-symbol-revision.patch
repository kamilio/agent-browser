+// Keep the mutable Set private: every supported mutation changes the revision.
+// The facade deliberately cannot be a receiver for borrowed native Set methods.
+const catalogue = new Set<symbol>();
+const nativeHas = Set.prototype.has.bind(catalogue);
+const nativeAdd = Set.prototype.add.bind(catalogue);
+const nativeDelete = Set.prototype.delete.bind(catalogue);
+const nativeClear = Set.prototype.clear.bind(catalogue);
+const nativeValues = Set.prototype.values.bind(catalogue);
+const nativeEntries = Set.prototype.entries.bind(catalogue);
+const nativeForEach = Set.prototype.forEach.bind(catalogue);
+const nativeSize = Object.getOwnPropertyDescriptor(
+  Set.prototype,
+  "size",
+)!.get!.bind(catalogue);
+const nativeFreeze = Object.freeze;
+let revision = nativeFreeze({});
+
+export function internalSymbolRevision(): object {
+  return revision;
+}
+
+interface InternalSymbolCatalogue extends Iterable<symbol> {
+  readonly size: number;
+  has(symbol: symbol): boolean;
+  add(symbol: symbol): InternalSymbolCatalogue;
+  delete(symbol: symbol): boolean;
+  clear(): void;
+  keys(): SetIterator<symbol>;
+  values(): SetIterator<symbol>;
+  entries(): SetIterator<[symbol, symbol]>;
+  forEach(
+    callback: (
+      value: symbol,
+      key: symbol,
+      catalogue: InternalSymbolCatalogue,
+    ) => void,
+    thisArg?: unknown,
+  ): void;
+  readonly [Symbol.toStringTag]: string;
+}
+
+export const internalSymbols: InternalSymbolCatalogue = nativeFreeze({
+  get size(): number {
+    return nativeSize();
+  },
+  has: nativeHas,
+  add(symbol: symbol): InternalSymbolCatalogue {
+    if (!nativeHas(symbol)) {
+      nativeAdd(symbol);
+      revision = nativeFreeze({});
+    }
+    return internalSymbols;
+  },
+  delete(symbol: symbol): boolean {
+    if (!nativeDelete(symbol)) return false;
+    revision = nativeFreeze({});
+    return true;
+  },
+  clear(): void {
+    if (nativeSize() === 0) return;
+    nativeClear();
+    revision = nativeFreeze({});
+  },
+  keys: nativeValues,
+  values: nativeValues,
+  entries: nativeEntries,
+  forEach(
+    callback: (
+      value: symbol,
+      key: symbol,
+      catalogue: InternalSymbolCatalogue,
+    ) => void,
+    thisArg?: unknown,
+  ): void {
+    if (typeof callback !== "function")
+      throw new TypeError("Catalogue forEach callback must be callable.");
+    nativeForEach((value) =>
+      Reflect.apply(callback, thisArg, [value, value, internalSymbols]),
+    );
+  },
+  [Symbol.iterator]: nativeValues,
+  [Symbol.toStringTag]: "Set",
+});
