+    const bytes = new Uint8Array([3, 4]);
+    Object.defineProperty(bytes, "length", { value: 99 });
+    expect(await from.call([bytes])).toEqual([3, 4]);
+  });
+
+  it("preserves the Float32 reflection path", async () => {
+    const { method } = reflectionFixture();
+    const values = new Float32Array(1);
+    expect(await method("assign").call([values, { "0": 1.5 }])).toBe(values);
+    expect(await method("entries").call([values])).toEqual([["0", 1.5]]);
+  });
+
+  it("preserves byte references in Array constructors and Array.of", async () => {
