+      expect((result as unknown[])[0]).toBe(bytes);
+    }
+  });
+
+  it("does not use inherited numeric properties for integer-indexed assignment", async () => {
+    const { method } = reflectionFixture();
+    const bytes = new Uint8Array(1);
+    const prototype = Object.create(null) as SandboxObject;
+    Object.defineProperty(prototype, "5", { value: 1 });
