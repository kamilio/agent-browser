+    expect(await method("assign").call([bytes, { "5": 9 }])).toBe(bytes);
+    expect(Object.hasOwn(bytes, "5")).toBe(false);
+  });
+
+  it("reflects native tags and backing identity in a persistent guest realm", async () => {
+    const realm = createRealm();
+    try {
+      const result = await realm.evaluate(`(() => {
+        const buffer = new ArrayBuffer(3);
+        const bytes = new Uint8Array(buffer);
+        const view = new DataView(buffer);
+        Object.assign(bytes, { 0: 257, 1: 2 });
+        const inspect = Object.prototype.toString;
+        return [inspect.call(buffer), inspect.call(bytes), inspect.call(view),
+          Object(buffer) === buffer, Object.values({ bytes: bytes })[0] === bytes,
+          Object.assign({}, { view: view }).view === view, bytes.buffer === view.buffer,
+          Object.prototype.propertyIsEnumerable.call(bytes, "0"),
+          Object.prototype.propertyIsEnumerable.call(view, "buffer"),
+          Array.from(bytes)];
+      })()`);
+      expect(result.returnValue).toEqual([
+        "[object ArrayBuffer]",
+        "[object Uint8Array]",
+        "[object DataView]",
+        true,
+        true,
+        true,
+        true,
+        true,
+        false,
+        [1, 2, 0]
+      ]);
+    } finally {
+      await realm.close();
+    }
+  });
+});
