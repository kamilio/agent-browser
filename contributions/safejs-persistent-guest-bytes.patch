+import { types as nodeTypes } from "node:util";
+
+import {
+  type BinaryStorage,
+  type NativeBinary,
+  binaryStorage,
+  isBinaryIndex,
+  isBinaryStorage
+} from "../binary-storage.js";
+import type { Budget } from "../budget.js";
+import { type SandboxClosure, type SandboxValue, createSandboxClosure } from "../values.js";
+
+const NativeArrayBuffer = ArrayBuffer;
+const NativeUint8Array = Uint8Array;
+const NativeDataView = DataView;
+const nativeIsView = ArrayBuffer.isView;
+const apply = Reflect.apply;
+const constructors = new WeakMap<SandboxClosure, BinaryStorage["kind"]>();
+const numericMethods = new Map<
+  string,
+  { width: number; write: boolean; intrinsic: (...args: unknown[]) => number | undefined }
+>();
+
+for (const [suffix, width] of [
+  ["Int8", 1],
+  ["Uint8", 1],
+  ["Int16", 2],
+  ["Uint16", 2],
+  ["Int32", 4],
+  ["Uint32", 4],
+  ["Float32", 4],
+  ["Float64", 8]
+] as const) {
+  for (const prefix of ["get", "set"] as const) {
+    const name = `${prefix}${suffix}`;
+    const descriptor = Object.getOwnPropertyDescriptor(NativeDataView.prototype, name);
+    if (
+      descriptor === undefined ||
+      !("value" in descriptor) ||
+      typeof descriptor.value !== "function"
+    )
+      throw new TypeError(`Missing native DataView method ${name}.`);
+    numericMethods.set(name, {
+      width,
+      write: prefix === "set",
+      intrinsic: descriptor.value
+    });
+  }
+}
+
+function primitive(value: SandboxValue): void {
+  if (
+    (typeof value === "object" && value !== null) ||
+    typeof value === "function" ||
+    typeof value === "symbol" ||
+    typeof value === "bigint"
+  ) {
+    throw new TypeError("Binary arguments must be primitive values without coercion callbacks.");
+  }
+}
+
+function number(value: SandboxValue): number {
+  primitive(value);
+  return Number(value);
+}
+
+function index(value: SandboxValue, fallback = 0): number {
+  if (value === undefined) return fallback;
+  const numeric = number(value);
+  if (Number.isNaN(numeric)) return 0;
+  const integer = Math.trunc(numeric);
+  if (integer < 0 || !Number.isSafeInteger(integer))
+    throw new RangeError("Invalid binary length or offset.");
+  return integer;
+}
+
+function argumentsLimit(args: readonly SandboxValue[], maximum: number): void {
+  if (args.length > maximum) throw new TypeError("Unsupported binary arguments or options.");
+}
+
+function relativeIndex(value: SandboxValue, length: number, fallback: number): number {
+  if (value === undefined) return fallback;
+  const numeric = number(value);
+  const integer = Number.isNaN(numeric) ? 0 : Math.trunc(numeric);
+  return integer < 0 ? Math.max(length + integer, 0) : Math.min(integer, length);
+}
+
+function provision<T>(budget: Budget, length: number, units: number, operation: () => T): T {
+  budget.allocateArrayLength(length);
+  const release = budget.provisionDataUsage(units);
+  try {
+    return operation();
+  } finally {
+    release();
+  }
+}
+
