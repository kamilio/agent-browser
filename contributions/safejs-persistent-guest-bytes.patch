+++ b/packages/safe-js/src/interp/binary-callable-metadata.test.ts
@@ -0,0 +1,127 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import * as binaryStorage from "./binary-storage.js";
+import { Budget } from "./budget.js";
+import { wrapCallerInjectedBindings } from "./host-bridge.js";
+import { type SandboxClosure, deepCopyFromSandbox, isSandboxPromise } from "./values.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("R6 callable metadata cannot mutate preflight byte graphs", () => {
+  it.each(["default", "nested", "returned"] as const)(
+    "rejects accessor names before hooks or backing copies: %s",
+    async (path) => {
+      const first = { bytes: new ArrayBuffer(0) };
+      const second = { bytes: new ArrayBuffer(0) };
+      const callable = () => undefined;
+      const getter = vi.fn(() => {
+        first.bytes = new ArrayBuffer(10);
+        second.bytes = new ArrayBuffer(10);
+        return "host";
+      });
+      Object.defineProperty(callable, "name", { get: getter });
+      const copy = vi.spyOn(binaryStorage, "copyBinaryStorage");
+      const budget = new Budget({ dataSize: path === "default" ? 19 : 1024 });
+      if (path === "returned") {
+        const wrapped = wrapCallerInjectedBindings(
+          {
+            produce: () => ({ callable, first, second })
+          },
+          { budget }
+        );
+        await expect(
+          Promise.resolve().then(() => (wrapped.produce as SandboxClosure).call([]))
+        ).rejects.toBeDefined();
+      } else {
+        expect(() =>
+          wrapCallerInjectedBindings(
+            path === "default"
+              ? { default: callable, first, second }
+              : { graph: { callable, first, second } },
+            { budget }
+          )
+        ).toThrow(TypeError);
+      }
+      expect(getter).not.toHaveBeenCalled();
+      expect(copy).not.toHaveBeenCalled();
+      expect(first.bytes.byteLength).toBe(0);
+      expect(second.bytes.byteLength).toBe(0);
+    }
+  );
+
+  it.each(["default", "nested"] as const)("rejects proxy callables without traps: %s", (path) => {
+    const trap = vi.fn(() => {
+      throw new Error("metadata trap");
+    });
+    const callable = new Proxy(() => undefined, {
+      get: trap,
+      getPrototypeOf: trap,
+      ownKeys: trap,
+      getOwnPropertyDescriptor: trap
+    });
+    expect(() =>
+      wrapCallerInjectedBindings(
+        path === "default" ? { default: callable } : { graph: { callable } },
+        { budget: new Budget() }
+      )
+    ).toThrow(TypeError);
+    expect(trap).not.toHaveBeenCalled();
+  });
+
+  it.each(["default", "nested", "returned"] as const)(
+    "ignores inherited metadata traps: %s",
+    (path) => {
+      const getter = vi.fn(() => {
+        throw new Error("inherited name");
+      });
+      const trap = vi.fn(() => {
+        throw new Error("prototype trap");
+      });
+      const callable = () => 7;
+      Reflect.deleteProperty(callable, "name");
+      const prototype = Object.defineProperty({}, "name", { get: getter });
+      Object.setPrototypeOf(prototype, new Proxy({}, { getPrototypeOf: trap }));
+      Object.setPrototypeOf(callable, prototype);
+      const wrapped = wrapCallerInjectedBindings(
+        path === "default"
+          ? { default: callable }
+          : path === "nested"
+            ? { graph: { callable } }
+            : { produce: () => ({ callable }) },
+        { budget: new Budget() }
+      );
+      const closure =
+        path === "default"
+          ? (wrapped.default as SandboxClosure)
+          : path === "nested"
+            ? (wrapped.graph as { callable: SandboxClosure }).callable
+            : ((wrapped.produce as SandboxClosure).call([]) as { callable: SandboxClosure })
+                .callable;
+      expect(closure.name).toBe(path === "default" ? "default" : "callable");
+      expect(closure.call([])).toBe(7);
+      expect(getter).not.toHaveBeenCalled();
+      expect(trap).not.toHaveBeenCalled();
+    }
+  );
+
+  it("preserves ordinary callable names, async flags and byte-return copies", async () => {
+    const buffer = new ArrayBuffer(2);
+    new Uint8Array(buffer).set([4, 9]);
+    async function produceBytes() {
+      return { buffer, bytes: new Uint8Array(buffer) };
+    }
+    const wrapped = wrapCallerInjectedBindings({ default: produceBytes }, { budget: new Budget() });
+    const closure = wrapped.default as SandboxClosure;
+    expect(closure.name).toBe("produceBytes");
+    expect(closure.async).toBe(true);
+    const result = closure.call([]);
+    if (!isSandboxPromise(result)) throw new Error("Expected a sandbox promise");
+    const copied = deepCopyFromSandbox(await result.promise) as {
+      buffer: ArrayBuffer;
+      bytes: Uint8Array;
+    };
+    expect(copied.buffer).not.toBe(buffer);
+    expect(copied.bytes.buffer).toBe(copied.buffer);
+    expect([...copied.bytes]).toEqual([4, 9]);
+  });
+});
diff --git a/packages/safe-js/src/interp/binary-globals.test.ts b/packages/safe-js/src/interp/binary-globals.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/binary-globals.test.ts
@@ -0,0 +1,487 @@
+import { describe, expect, it } from "vitest";
+
+import { type NativeBinary, isBinaryStorage } from "./binary-storage.js";
+import { Budget, SandboxError } from "./budget.js";
+import {
+  binaryInstanceOf,
+  createBinaryGlobals,
+  getBinaryMember,
+  setBinaryMember
+} from "./globals/binary.js";
+import {
+  type SandboxClosure,
+  type SandboxValue,
+  createSandboxClosure,
+  isSandboxClosure
+} from "./values.js";
+
+function construct(budget: Budget, name: string, args: SandboxValue[] = []): NativeBinary {
+  const constructorClosure = createBinaryGlobals(budget)[name];
+  if (!isSandboxClosure(constructorClosure) || constructorClosure.construct === undefined)
+    throw new Error(`Expected a binary constructor closure for ${name}.`);
+  const result = constructorClosure.construct(args);
+  if (!isBinaryStorage(result)) throw new Error(`Expected native binary storage from ${name}.`);
+  return result;
+}
+
+function method(value: NativeBinary, name: string, budget = new Budget()): SandboxClosure {
+  return getBinaryMember(value, name, budget) as SandboxClosure;
+}
+
+function invoke(
+  value: NativeBinary,
+  name: string,
+  args: SandboxValue[] = [],
+  budget = new Budget()
+) {
+  return method(value, name, budget).call(args, { thisValue: value, stack: [] });
+}
+
+describe("binary SDK closures", () => {
+  it.each([
+    [-0.5, 0],
+    [-Number.MIN_VALUE, 0],
+    [1.75, 1]
+  ])("truncates constructor index %s to %s before range checks", (fraction, expected) => {
+    const budget = new Budget();
+    const buffer = new ArrayBuffer(4);
+    const allocated = construct(budget, "ArrayBuffer", [fraction]);
+    expect(allocated.byteLength).toBe(expected);
+    expect(allocated.byteLength).toBe(new ArrayBuffer(fraction).byteLength);
+    const bytes = construct(budget, "Uint8Array", [fraction]);
+    expect(bytes.byteLength).toBe(expected);
+    expect(bytes.byteLength).toBe(new Uint8Array(fraction).byteLength);
+    for (const name of ["Uint8Array", "DataView"]) {
+      const native =
+        name === "Uint8Array" ? new Uint8Array(buffer, fraction) : new DataView(buffer, fraction);
+      const view = construct(budget, name, [buffer, fraction]);
+      expect(getBinaryMember(view, "byteOffset", budget)).toBe(expected);
+      expect(getBinaryMember(view, "byteOffset", budget)).toBe(native.byteOffset);
+      expect(view.byteLength).toBe(4 - expected);
+      expect(view.byteLength).toBe(native.byteLength);
+      const nativeLength =
+        name === "Uint8Array"
+          ? new Uint8Array(buffer, 0, fraction)
+          : new DataView(buffer, 0, fraction);
+      const sized = construct(budget, name, [buffer, 0, fraction]);
+      expect(sized.byteLength).toBe(expected);
+      expect(sized.byteLength).toBe(nativeLength.byteLength);
+    }
+  });
+
+  it.each([
+    [-0.5, 0],
+    [-Number.MIN_VALUE, 0],
+    [1.75, 1]
+  ])("truncates DataView and set offset %s to %s", (fraction, expected) => {
+    const view = new DataView(new ArrayBuffer(3));
+    const nativeView = new DataView(new ArrayBuffer(3));
+    invoke(view, "setUint16", [fraction, 0x1234, true]);
+    nativeView.setUint16(fraction, 0x1234, true);
+    expect([...new Uint8Array(view.buffer)]).toEqual(
+      expected === 0 ? [0x34, 0x12, 0] : [0, 0x34, 0x12]
+    );
+    expect([...new Uint8Array(view.buffer)]).toEqual([...new Uint8Array(nativeView.buffer)]);
+    expect(invoke(view, "getUint16", [fraction, true])).toBe(0x1234);
+    expect(invoke(view, "getUint16", [fraction, true])).toBe(nativeView.getUint16(fraction, true));
+    const bytes = new Uint8Array([1, 2, 3]);
+    const nativeBytes = new Uint8Array([1, 2, 3]);
+    invoke(bytes, "set", [[9], fraction]);
+    nativeBytes.set([9], fraction);
+    expect([...bytes]).toEqual(expected === 0 ? [9, 2, 3] : [1, 9, 3]);
+    expect([...bytes]).toEqual([...nativeBytes]);
+  });
+
+  it("keeps slice and subarray clamping when a negative fraction truncates to zero", () => {
+    const bytes = new Uint8Array([1, 2, 3]);
+    for (const name of ["slice", "subarray"] as const) {
+      const copied = invoke(bytes, name, [-0.5, 2]) as Uint8Array;
+      expect([...copied]).toEqual([1, 2]);
+      expect([...copied]).toEqual([...bytes[name](-0.5, 2)]);
+      expect(invoke(bytes, name, [0, -0.5])).toHaveLength(0);
+      expect(bytes[name](0, -0.5)).toHaveLength(0);
+    }
+    const buffer = invoke(bytes.buffer, "slice", [-0.5, 2]) as ArrayBuffer;
+    expect([...new Uint8Array(buffer)]).toEqual([1, 2]);
+    expect([...new Uint8Array(buffer)]).toEqual([...new Uint8Array(bytes.buffer.slice(-0.5, 2))]);
+  });
+
+  it.each([
+    -1,
+    -1.75,
+    Number.POSITIVE_INFINITY,
+    Number.NEGATIVE_INFINITY,
+    Number.MAX_SAFE_INTEGER + 1
+  ])("still rejects invalid length and method offset %s after truncation", (invalid) => {
+    const budget = new Budget();
+    const buffer = new ArrayBuffer(4);
+    const view = new DataView(buffer);
+    const bytes = new Uint8Array(buffer);
+    expect(() => construct(budget, "ArrayBuffer", [invalid])).toThrow(RangeError);
+    expect(() => construct(budget, "Uint8Array", [invalid])).toThrow(RangeError);
+    expect(() => construct(budget, "Uint8Array", [buffer, invalid])).toThrow(RangeError);
+    expect(() => construct(budget, "DataView", [buffer, invalid])).toThrow(RangeError);
+    expect(() => invoke(view, "getUint8", [invalid])).toThrow(RangeError);
+    expect(() => invoke(view, "setUint8", [invalid, 9])).toThrow(RangeError);
+    expect(() => invoke(bytes, "set", [[9], invalid])).toThrow(RangeError);
+    expect(() => new ArrayBuffer(invalid)).toThrow(RangeError);
+    expect(() => new Uint8Array(buffer, invalid)).toThrow(RangeError);
+    expect(() => new DataView(buffer, invalid)).toThrow(RangeError);
+    expect(() => view.getUint8(invalid)).toThrow(RangeError);
+    expect(() => view.setUint8(invalid, 9)).toThrow(RangeError);
+    expect(() => bytes.set([9], invalid)).toThrow(RangeError);
+    expect([...bytes]).toEqual([0, 0, 0, 0]);
+  });
+
+  it("constructs genuine storage with exact shared buffer identity and empty end views", () => {
+    const budget = new Budget();
+    const buffer = construct(budget, "ArrayBuffer", [4]) as ArrayBuffer;
+    const bytes = construct(budget, "Uint8Array", [buffer, 1, 2]) as Uint8Array;
+    const view = construct(budget, "DataView", [buffer, 4, 0]) as DataView;
+    expect(Object.getPrototypeOf(buffer)).toBe(ArrayBuffer.prototype);
+    expect(Object.getPrototypeOf(bytes)).toBe(Uint8Array.prototype);
+    expect(Object.getPrototypeOf(view)).toBe(DataView.prototype);
+    expect(getBinaryMember(bytes, "buffer", budget)).toBe(buffer);
+    expect(getBinaryMember(bytes, "length", budget)).toBe(2);
+    expect(getBinaryMember(bytes, "byteOffset", budget)).toBe(1);
+    expect(getBinaryMember(bytes, "BYTES_PER_ELEMENT", budget)).toBe(1);
+    expect(getBinaryMember(view, "byteLength", budget)).toBe(0);
+    expect(construct(budget, "Uint8Array", [buffer, 4])).toHaveLength(0);
+    expect(construct(budget, "ArrayBuffer")).toHaveProperty("byteLength", 0);
+  });
+
+  it("exposes branded constructors and isView without host constructor injection", () => {
+    const globals = createBinaryGlobals(new Budget());
+    for (const name of ["ArrayBuffer", "Uint8Array", "DataView"]) {
+      const constructorClosure = globals[name] as SandboxClosure;
+      expect(constructorClosure.kind).toBe("fn");
+      expect(() => constructorClosure.call([])).toThrow(TypeError);
+    }
+    expect((globals.Uint8Array as SandboxClosure).properties?.BYTES_PER_ELEMENT).toBe(1);
+    const isView = (globals.ArrayBuffer as SandboxClosure).properties?.isView as SandboxClosure;
+    expect(isView.call([new Uint8Array(0)])).toBe(true);
+    expect(isView.call([new Float32Array(0)])).toBe(true);
+    expect(isView.call([new ArrayBuffer(0)])).toBe(false);
+    expect(binaryInstanceOf(new Uint8Array(0), globals.Uint8Array)).toBe(true);
+    expect(binaryInstanceOf(new DataView(new ArrayBuffer(0)), globals.Uint8Array)).toBe(false);
+    expect(binaryInstanceOf({}, globals.ArrayBuffer)).toBe(false);
+    expect(binaryInstanceOf({}, createSandboxClosure({ call: () => undefined }))).toBeUndefined();
+  });
+
+  it("reads and writes indices and data expandos, but rejects read-only and accessor writes", () => {
+    const budget = new Budget();
+    const bytes = construct(budget, "Uint8Array", [[257, -1, "2"]]) as Uint8Array<ArrayBuffer>;
+    expect([...bytes]).toEqual([1, 255, 2]);
+    setBinaryMember(bytes, 1, 258);
+    expect(getBinaryMember(bytes, 1, budget)).toBe(2);
+    setBinaryMember(bytes, "note", "kept");
+    expect(getBinaryMember(bytes, "note", budget)).toBe("kept");
+    expect(() => setBinaryMember(bytes, "buffer", null)).toThrow(TypeError);
+    setBinaryMember(bytes.buffer, 0, 1);
+    expect(getBinaryMember(bytes.buffer, 0, budget)).toBe(1);
+    const view = new DataView(bytes.buffer);
+    setBinaryMember(view, 0, 2);
+    expect(getBinaryMember(view, 0, budget)).toBe(2);
+    for (const key of ["-1", "3", "-0", "NaN", "Infinity", "1.5"]) {
+      setBinaryMember(bytes, key, 19);
+      expect(Object.hasOwn(bytes, key)).toBe(false);
+    }
+    Object.defineProperty(bytes, "accessor", {
+      get: () => {
+        throw new Error("hook");
+      }
+    });
+    expect(() => getBinaryMember(bytes, "accessor", budget)).toThrow(TypeError);
+    expect(() => setBinaryMember(bytes, "accessor", 1)).toThrow(TypeError);
+    Object.defineProperty(bytes, "fixed", { value: 1 });
+    expect(() => setBinaryMember(bytes, "fixed", 2)).toThrow(TypeError);
+  });
+
+  it.each([
+    ["ArrayBuffer", "length", false],
+    ["ArrayBuffer", "byteLength", true],
+    ["ArrayBuffer", "byteOffset", false],
+    ["ArrayBuffer", "buffer", false],
+    ["ArrayBuffer", "BYTES_PER_ELEMENT", false],
+    ["DataView", "length", false],
+    ["DataView", "byteLength", true],
+    ["DataView", "byteOffset", true],
+    ["DataView", "buffer", true],
+    ["DataView", "BYTES_PER_ELEMENT", false],
+    ["Uint8Array", "length", true],
+    ["Uint8Array", "byteLength", true],
+    ["Uint8Array", "byteOffset", true],
+    ["Uint8Array", "buffer", true],
+    ["Uint8Array", "BYTES_PER_ELEMENT", true]
+  ] as const)("matches native assignment and own descriptors for %s.%s", (name, key, readonly) => {
+    const budget = new Budget();
+    const native =
+      name === "ArrayBuffer"
+        ? new ArrayBuffer(4)
+        : name === "DataView"
+          ? new DataView(new ArrayBuffer(4))
+          : new Uint8Array(4);
+    const guest = construct(budget, name, [name === "DataView" ? new ArrayBuffer(4) : 4]);
+    const originalNative = Reflect.get(native, key);
+    const originalGuest = getBinaryMember(guest, key, budget);
+    expect(Object.hasOwn(native, key)).toBe(false);
+    expect(Object.hasOwn(guest, key)).toBe(false);
+    expect(Reflect.set(native, key, 17)).toBe(!readonly);
+    if (readonly) {
+      expect(() => setBinaryMember(guest, key, 17)).toThrow(TypeError);
+      expect(getBinaryMember(guest, key, budget)).toBe(originalGuest);
+      expect(Reflect.get(native, key)).toBe(originalNative);
+      expect(Object.hasOwn(native, key)).toBe(false);
+      expect(Object.hasOwn(guest, key)).toBe(false);
+    } else {
+      setBinaryMember(guest, key, 17);
+      expect(getBinaryMember(guest, key, budget)).toBe(Reflect.get(native, key));
+      expect(getBinaryMember(guest, key, budget)).toBe(17);
+      expect(Object.getOwnPropertyDescriptor(guest, key)).toEqual(
+        Object.getOwnPropertyDescriptor(native, key)
+      );
+    }
+    for (const value of [native, guest]) {
+      Object.defineProperty(value, key, {
+        value: 23,
+        writable: true,
+        enumerable: false,
+        configurable: true
+      });
+    }
+    expect(Reflect.set(native, key, 29)).toBe(true);
+    setBinaryMember(guest, key, 29);
+    expect(getBinaryMember(guest, key, budget)).toBe(Reflect.get(native, key));
+    expect(Object.getOwnPropertyDescriptor(guest, key)).toEqual(
+      Object.getOwnPropertyDescriptor(native, key)
+    );
+    for (const value of [native, guest]) {
+      Object.defineProperty(value, key, { writable: false });
+    }
+    expect(Reflect.set(native, key, 31)).toBe(false);
+    expect(() => setBinaryMember(guest, key, 31)).toThrow(TypeError);
+    expect(getBinaryMember(guest, key, budget)).toBe(29);
+    expect(Object.getOwnPropertyDescriptor(guest, key)).toEqual(
+      Object.getOwnPropertyDescriptor(native, key)
+    );
+  });
+
+  it("copies slices and constructors, shares subarrays, and safely handles overlap", () => {
+    const budget = new Budget();
+    const bytes = construct(budget, "Uint8Array", [[1, 2, 3, 4]]) as Uint8Array<ArrayBuffer>;
+    const shared = invoke(bytes, "subarray", [0, 3]) as Uint8Array;
+    invoke(bytes, "set", [shared, 1]);
+    expect([...bytes]).toEqual([1, 1, 2, 3]);
+    expect(shared.buffer).toBe(bytes.buffer);
+    const sliced = invoke(bytes, "slice", [1, 3]) as Uint8Array;
+    const copied = construct(budget, "Uint8Array", [bytes]) as Uint8Array;
+    const bufferCopy = invoke(bytes.buffer, "slice", [1, 3]) as ArrayBuffer;
+    bytes[1] = 9;
+    expect([...sliced]).toEqual([1, 2]);
+    expect([...copied]).toEqual([1, 1, 2, 3]);
+    expect([...new Uint8Array(bufferCopy)]).toEqual([1, 2]);
+    expect(invoke(bytes, "subarray", [4, 4])).toHaveLength(0);
+    invoke(bytes, "set", [new Uint8Array(bytes.buffer, 1, 3)]);
+    expect([...bytes]).toEqual([9, 2, 3, 3]);
+  });
+
+  it.each([
+    [-2, undefined],
+    [-20, 2],
+    [Number.NEGATIVE_INFINITY, Number.POSITIVE_INFINITY],
+    [1, -1],
+    [Number.POSITIVE_INFINITY, undefined],
+    [Number.NaN, -0.5],
+    [-0.5, 2.9],
+    [3, 1]
+  ])("matches native relative slice indices %s, %s", (start, end) => {
+    const backing = new Uint8Array([9, 1, 2, 3, 4, 9]);
+    const source = new Uint8Array(backing.buffer, 1, 4);
+    const expectedSlice = source.slice(start, end);
+    const expectedView = source.subarray(start, end);
+    const sliced = invoke(source, "slice", [start, end]) as Uint8Array;
+    const view = invoke(source, "subarray", [start, end]) as Uint8Array;
+    const copiedBuffer = invoke(backing.buffer, "slice", [start, end]) as ArrayBuffer;
+    expect([...sliced]).toEqual([...expectedSlice]);
+    expect(sliced.buffer).not.toBe(backing.buffer);
+    expect([...view]).toEqual([...expectedView]);
+    expect(view.buffer).toBe(backing.buffer);
+    expect(view.byteOffset).toBe(expectedView.byteOffset);
+    expect([...new Uint8Array(copiedBuffer)]).toEqual([
+      ...new Uint8Array(backing.buffer.slice(start, end))
+    ]);
+  });
+
+  it("never consults source species, constructor, iterator or inherited array entries", () => {
+    const bytes = new Uint8Array([1, 2]);
+    Object.defineProperty(bytes, "constructor", {
+      get: () => {
+        throw new Error("hook");
+      }
+    });
+    expect(invoke(bytes, "slice", [])).toEqual(new Uint8Array([1, 2]));
+    expect(invoke(bytes, "subarray", [])).toHaveLength(2);
+    const source = [3, 4];
+    Object.defineProperty(source, Symbol.iterator, {
+      get: () => {
+        throw new Error("hook");
+      }
+    });
+    expect(construct(new Budget(), "Uint8Array", [source])).toEqual(new Uint8Array([3, 4]));
+    const sparse = new Array<SandboxValue>(2);
+    expect(construct(new Budget(), "Uint8Array", [sparse])).toEqual(new Uint8Array(2));
+  });
+
+  it("rejects wrong receivers even for the same method name", () => {
+    const bytes = new Uint8Array(4);
+    for (const [owner, name, wrong] of [
+      [bytes, "slice", bytes.buffer],
+      [bytes.buffer, "slice", bytes],
+      [new DataView(bytes.buffer), "getUint8", bytes]
+    ] as const) {
+      const closure = method(owner, name);
+      expect(() => closure.call([0], { thisValue: wrong, stack: [] })).toThrow(TypeError);
+      expect(() => closure.call([0], { thisValue: {}, stack: [] })).toThrow(TypeError);
+      expect(() => closure.call([0], { thisValue: new Proxy(owner, {}), stack: [] })).toThrow(
+        TypeError
+      );
+      expect(() => closure.call([0])).toThrow(TypeError);
+      expect(closure.construct).toBeUndefined();
+    }
+  });
+
+  it("rejects callbacks, options, unsupported sources and invalid indices", () => {
+    const budget = new Budget();
+    const hostile = {
+      valueOf: createSandboxClosure({
+        call: () => {
+          throw new Error("hook");
+        }
+      })
+    };
+    for (const invalid of [
+      -1,
+      Number.POSITIVE_INFINITY,
+      Number.NEGATIVE_INFINITY,
+      Number.MAX_SAFE_INTEGER + 1,
+      hostile
+    ]) {
+      expect(() => construct(budget, "ArrayBuffer", [invalid])).toThrow();
+      expect(() => construct(budget, "Uint8Array", [new ArrayBuffer(4), invalid])).toThrow();
+      expect(() => construct(budget, "DataView", [new ArrayBuffer(4), invalid])).toThrow();
+    }
+    expect(() => invoke(new Uint8Array(4), "slice", [hostile])).toThrow(TypeError);
+    expect(() => invoke(new Uint8Array(4), "subarray", [hostile])).toThrow(TypeError);
+    expect(() => construct(budget, "ArrayBuffer", [1, {}])).toThrow(TypeError);
+    expect(() => construct(budget, "Uint8Array", [2, 0])).toThrow(TypeError);
+    expect(() => construct(budget, "Uint8Array", [new Float32Array(2)])).toThrow(TypeError);
+    expect(() => construct(budget, "DataView", [new Uint8Array(2)])).toThrow(TypeError);
+    expect(() => construct(budget, "Uint8Array", [new Proxy([], {})])).toThrow(TypeError);
+    const source = [1];
+    Object.defineProperty(source, 0, {
+      get: () => {
+        throw new Error("hook");
+      }
+    });
+    expect(() => construct(budget, "Uint8Array", [source])).toThrow(TypeError);
+    expect(() => setBinaryMember(new Uint8Array(1), 0, hostile)).toThrow(TypeError);
+  });
+
+  it("rejects unsupported native stores and primitive types without coercion hooks", () => {
+    const budget = new Budget();
+    class DerivedBytes extends Uint8Array {}
+    class DerivedBuffer extends ArrayBuffer {}
+    for (const source of [new DerivedBytes(1), new DerivedBuffer(1), new Uint16Array(1)]) {
+      expect(() => construct(budget, "Uint8Array", [source as unknown as SandboxValue])).toThrow(
+        TypeError
+      );
+    }
+    for (const source of [1n, Symbol("byte"), () => 1]) {
+      expect(() => construct(budget, "ArrayBuffer", [source as unknown as SandboxValue])).toThrow(
+        TypeError
+      );
+      expect(() =>
+        setBinaryMember(new Uint8Array(1), 0, source as unknown as SandboxValue)
+      ).toThrow(TypeError);
+    }
+    expect(() => construct(budget, "Uint8Array", [new ArrayBuffer(2), 1, 2])).toThrow(RangeError);
+    expect(() => construct(budget, "DataView", [new ArrayBuffer(2), 3])).toThrow(RangeError);
+    expect(() => construct(budget, "DataView", [new ArrayBuffer(2), 0, 1, {}])).toThrow(TypeError);
+  });
+
+  it.each([
+    ["Int8", 1, -12],
+    ["Uint8", 1, 250],
+    ["Int16", 2, -1234],
+    ["Uint16", 2, 50000],
+    ["Int32", 4, -123456],
+    ["Uint32", 4, 3000000000],
+    ["Float32", 4, 1.25],
+    ["Float64", 8, -123.5]
+  ] as const)("implements DataView %s with view-relative bounds", (suffix, width, value) => {
+    const buffer = new ArrayBuffer(12);
+    const view = new DataView(buffer, 2, 8);
+    for (const littleEndian of [false, true]) {
+      invoke(view, `set${suffix}`, [0, value, littleEndian]);
+      expect(invoke(view, `get${suffix}`, [0, littleEndian])).toBe(value);
+    }
+    expect(() => invoke(view, `get${suffix}`, [9 - width])).toThrow(RangeError);
+    expect(() => invoke(view, `set${suffix}`, [-1, value])).toThrow(RangeError);
+    expect(new Uint8Array(buffer)[0]).toBe(0);
+  });
+
+  it("handles explicit endianness and rejects nonprimitive endian/offset arguments", () => {
+    const view = new DataView(new ArrayBuffer(4));
+    invoke(view, "setUint16", [1, 0x1234]);
+    expect([...new Uint8Array(view.buffer)]).toEqual([0, 0x12, 0x34, 0]);
+    expect(invoke(view, "getUint16", [1, true])).toBe(0x3412);
+    expect(() => invoke(view, "setUint16", [0, {}])).toThrow(TypeError);
+    expect(() => invoke(view, "getUint16", [0, {}])).toThrow(TypeError);
+    expect(() => invoke(view, "getUint8", [Number.POSITIVE_INFINITY])).toThrow(RangeError);
+    expect(getBinaryMember(view, "getBigInt64", new Budget())).toBeUndefined();
+  });
+
+  it("preflights full allocation plus wrappers and releases provisional usage", () => {
+    for (const [name, units] of [
+      ["ArrayBuffer", 5],
+      ["Uint8Array", 6]
+    ] as const) {
+      const budget = new Budget({ dataSize: units });
+      construct(budget, name, [4]);
+      expect(budget.peakDataSize).toBe(units);
+      expect(budget.currentDataSize).toBe(0);
+      expect(() => construct(new Budget({ dataSize: units - 1 }), name, [4])).toThrow(SandboxError);
+      expect(() => construct(new Budget({ arrayLength: 3 }), name, [4])).toThrow(SandboxError);
+    }
+    const budget = new Budget({ dataSize: 6 });
+    budget.reconcileDataUsage(5);
+    construct(budget, "DataView", [new ArrayBuffer(4)]);
+    expect(budget.peakDataSize).toBe(6);
+    expect(budget.currentDataSize).toBe(5);
+    expect(() => invoke(new Uint8Array(4), "slice", [], budget)).toThrow(SandboxError);
+    const failing = new Budget({ maxSteps: 0, dataSize: 3 });
+    expect(() => construct(failing, "Uint8Array", [[1]])).toThrow(SandboxError);
+    expect(failing.currentDataSize).toBe(0);
+  });
+
+  it("budgets set staging including overlap and leaves targets unchanged on failure", () => {
+    const bytes = new Uint8Array([1, 2, 3]);
+    const budget = new Budget({ dataSize: 3 });
+    expect(() => invoke(bytes, "set", [bytes.subarray(0, 2), 1], budget)).toThrow(SandboxError);
+    expect([...bytes]).toEqual([1, 2, 3]);
+    expect(budget.currentDataSize).toBe(0);
+    expect(() => invoke(bytes, "set", [[1, {}]], new Budget())).toThrow(TypeError);
+    expect([...bytes]).toEqual([1, 2, 3]);
+    const success = new Budget({ dataSize: 4 });
+    invoke(bytes, "set", [[8, 9], 1], success);
+    expect([...bytes]).toEqual([1, 8, 9]);
+    expect(success.peakDataSize).toBe(4);
+    expect(success.currentDataSize).toBe(0);
+    const exhausted = new Budget({ maxSteps: 0 });
+    expect(() => invoke(bytes, "slice", [0, 2], exhausted)).toThrow(SandboxError);
+    expect(exhausted.currentDataSize).toBe(0);
+    const noWrapper = new Budget({ dataSize: 0 });
+    expect(() => invoke(bytes, "subarray", [3, 3], noWrapper)).toThrow(SandboxError);
+    expect(noWrapper.currentDataSize).toBe(0);
+  });
+});
