+import { afterEach, describe, expect, it, vi } from "vitest";
+import * as binaryStorage from "./binary-storage.js";
+import { Budget } from "./budget.js";
+import { type CallerInjectedBinding, wrapCallerInjectedBindings } from "./host-bridge.js";
+import {
+  type SandboxMap,
+  type SandboxSet,
+  type SandboxValue,
+  checkBinaryCopyBudget,
+  cloneSandboxValue,
+  createSandboxMap,
+  createSandboxSet,
+  deepCopyFromSandbox,
+  deepCopyToSandbox,
+  measureSandboxData
+} from "./values.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("R3 array expando retained accounting", () => {
+  it.each([false, true])(
+    "counts indexed slots, expando keys, strings and bytes with frozen=%s",
+    (frozen) => {
+      const value = Object.assign(["hi", 7], { bytes: new ArrayBuffer(16), label: "abc" });
+      if (frozen) Object.freeze(value);
+      expect(measureSandboxData([value])).toBe(37);
+      expect(measureSandboxData([value])).toBe(37);
+    }
+  );
+
+  it.each([false, true])(
+    "counts mixed aliases once through array expandos with frozen=%s",
+    (frozen) => {
+      const buffer = new ArrayBuffer(16);
+      const value = Object.assign([], {
+        buffer,
+        bytes: new Uint8Array(buffer),
+        view: new DataView(buffer),
+        floats: new Float32Array(buffer)
+      });
+      if (frozen) Object.freeze(value);
+      expect(measureSandboxData([value])).toBe(46);
+      expect(measureSandboxData([value])).toBe(46);
+    }
+  );
+
+  it("keeps mutable expando descendants live after a frozen array is cached", () => {
+    const child = { payload: new ArrayBuffer(8) };
+    const value = Object.freeze(Object.assign([], { child }));
+    expect(measureSandboxData([value])).toBe(25);
+    child.payload = new ArrayBuffer(16);
+    expect(measureSandboxData([value])).toBe(33);
+    Object.defineProperty(child.payload, "note", { value: "abc" });
+    expect(measureSandboxData([value])).toBe(41);
+  });
+
+  it.each([false, true])(
+    "preserves sparse length and hidden indexed costs while charging non-index numeric keys with frozen=%s",
+    (frozen) => {
