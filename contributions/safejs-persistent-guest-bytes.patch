+import { describe, expect, it } from "vitest";
+import { parseModule } from "../parse/parser.js";
+import { restore as restoreDump } from "../restore.js";
+import { type RunRandom, run } from "../run.js";
+import { serializeSafeJSSnapshot } from "../snapshot/dump-format.js";
+import { encodeReplayData } from "../snapshot/replay-data.js";
+import { restore } from "../snapshot/restore.js";
+import { type RuntimeSnapshotValue, serialize } from "../snapshot/serialize.js";
+import {
+  SnapshotValidationError,
+  validateArgumentsProperties,
+  validateDumpEnvelope,
+  validateInterpreterSnapshot,
+  validateSnapshotData,
+  validateSnapshotSourceHash
+} from "../snapshot/validation.js";
+import { Budget } from "./budget.js";
+
+const source = "return 1;";
+const persistenceMessage = "Binary persistence is not supported.";
+
+function fixture(value: RuntimeSnapshotValue = null) {
+  const statement = parseModule(source).body[0];
+  if (statement === undefined) throw new Error("Missing statement");
+  if (statement.nodeId === undefined) throw new Error("Missing statement node ID");
+  return {
+    nodes: new Map([[statement.nodeId, statement]]),
+    snapshot: serialize({
+      source,
+      currentAstNodeId: statement.nodeId,
+      scopeChain: [{ id: "module", bindings: { value } }],
+      callStack: [],
+      pendingPromises: [],
+      moduleBindings: {}
+    })
+  };
+}
+
+function argumentsRecord() {
+  return { extensible: true, lengthBeforeCallee: false, properties: {}, iterator: null };
+}
+
+function random(): RunRandom {
+  return { seed: 1, next: () => 0.5, snapshot: () => 1 };
+}
+
+function expectInvalidType(action: () => unknown): void {
+  expect(action).toThrow(SnapshotValidationError);
+  expect(action).toThrow(expect.objectContaining({ code: "invalidType" }));
+}
+
+const candidates: Array<[string, () => object]> = [
+  ["ArrayBuffer", () => new ArrayBuffer(4)],
+  ["Uint8Array", () => new Uint8Array([1])],
+  ["DataView", () => new DataView(new ArrayBuffer(4))],
+  ["shared buffer", () => new SharedArrayBuffer(4)],
+  ["unsupported view", () => new Uint16Array([1])],
+  ["native Float32 wire impostor", () => new Float32Array([1])],
+  ["null-prototype buffer", () => Object.setPrototypeOf(new ArrayBuffer(4), null)],
+  ["plain-prototype view", () => Object.setPrototypeOf(new Uint8Array([1]), Object.prototype)],
+  [
+    "tagged native buffer",
+    () => Object.assign(new ArrayBuffer(4), { kind: "number", value: "NaN" })
+  ]
+];
+
+const validators: Array<[string, (value: unknown) => void]> = [
+  ["snapshot data", (value) => validateSnapshotData({ extra: value })],
+  [
+    "dump envelope",
+    (value) =>
+      validateDumpEnvelope({
+        version: 1,
+        sourceHash: "binary-test",
+        extra: value
+      })
+  ],
+  [
+    "source hash",
+    (value) => validateSnapshotSourceHash({ sourceHash: "binary-test", extra: value })
+  ],
+  [
+    "interpreter snapshot",
+    (value) => {
+      const { snapshot, nodes } = fixture();
+      validateInterpreterSnapshot({ ...snapshot, extra: value }, nodes, new Budget());
+    }
+  ],
+  [
+    "arguments properties",
+    (value) =>
+      validateArgumentsProperties(
+        {
+          ...argumentsRecord(),
+          extra: value
+        },
+        "arguments"
+      )
+  ]
+];
+
+describe.each(validators)("binary %s admission", (_name, validate) => {
+  it.each(candidates)("rejects %s with the typed validation contract", (_kind, create) => {
+    const value = create();
+    expectInvalidType(() => validate(value));
+  });
+
+  it("rejects bytes in hidden and symbol-keyed envelope data", () => {
+    const hidden = Object.defineProperty({}, "bytes", { value: new ArrayBuffer(4) });
+    const symbolic = { [Symbol("bytes")]: new ArrayBuffer(4) };
+    expectInvalidType(() => validate(hidden));
+    expectInvalidType(() => validate(symbolic));
+  });
+
+  it("rejects bytes behind collection contents", () => {
+    expectInvalidType(() => validate(new Map([["bytes", new ArrayBuffer(4)]])));
+    expectInvalidType(() => validate(new Set([new ArrayBuffer(4)])));
+  });
+
+  it("does not invoke accessor or proxy hooks", () => {
+    let hooks = 0;
+    const accessor = Object.defineProperty({}, "value", {
+      enumerable: true,
+      get() {
+        hooks += 1;
+        return new ArrayBuffer(4);
+      }
+    });
+    const proxy = new Proxy(
+      {},
+      {
+        get() {
+          hooks += 1;
+          return undefined;
+        },
+        ownKeys() {
+          hooks += 1;
+          return [];
+        },
+        getPrototypeOf() {
+          hooks += 1;
+          return Object.prototype;
+        }
+      }
+    );
+    expectInvalidType(() => validate(accessor));
+    expectInvalidType(() => validate(proxy));
+    expect(hooks).toBe(0);
+  });
+
+  it("accepts ordinary byte-shaped data and Float32 wire descriptions", () => {
+    expect(() => validate({ byteLength: 4, byteOffset: 0, buffer: {}, "0": 1 })).not.toThrow();
+    expect(() =>
+      validate({
+        kind: "float32array",
+        bytes: [0, 0, 128, 63],
+        byteOffset: 0,
+        length: 1,
+        entries: {}
+      })
+    ).not.toThrow();
+  });
+});
+
+describe("raw snapshot roots and restoration", () => {
+  it("rejects native buffers impersonating complete snapshot envelopes", () => {
+    const { snapshot, nodes } = fixture();
+    const impostor = Object.assign(Object.setPrototypeOf(new ArrayBuffer(4), null), snapshot);
+    expectInvalidType(() => validateSnapshotSourceHash(impostor));
+    expectInvalidType(() => validateInterpreterSnapshot(impostor, nodes, new Budget()));
+    expectInvalidType(() => restore(impostor, { source }));
+    const dumped = Object.assign(Object.setPrototypeOf(new ArrayBuffer(4), null), {
+      version: 1,
+      sourceHash: snapshot.sourceHash
+    });
+    expectInvalidType(() => validateDumpEnvelope(dumped));
+    expectInvalidType(() => restoreDump(dumped, { source }));
+  });
+
+  it("rejects a native buffer impersonating an otherwise valid arguments descriptor", () => {
+    const impostor = Object.assign(new ArrayBuffer(4), argumentsRecord()) as unknown as Record<
+      string,
+      unknown
+    >;
+    expectInvalidType(() => validateArgumentsProperties(impostor, "arguments"));
+  });
+
+  it("rejects raw bytes in ignored restore fields and before tag dispatch", () => {
+    const { snapshot } = fixture();
+    const extended = { ...snapshot, extra: new ArrayBuffer(4) };
+    expectInvalidType(() => restore(extended, { source }));
+    const scope = snapshot.scopeChain[0];
+    if (scope === undefined) throw new Error("Missing snapshot scope");
+    Object.defineProperty(scope.bindings, "value", {
+      value: Object.assign(new ArrayBuffer(4), { kind: "undefined" }),
+      enumerable: true
+    });
+    expectInvalidType(() => restore(snapshot, { source }));
+  });
+
+  it("rejects native storage impersonating an encoded Float32 heap node", () => {
+    const { snapshot, nodes } = fixture(new Float32Array([1]));
+    const heap = snapshot.heap;
+    if (heap === undefined) throw new Error("Missing snapshot heap");
+    const encoded = heap["1"];
+    if (encoded === undefined) throw new Error("Missing Float32 heap node");
+    heap["1"] = Object.assign(new ArrayBuffer(4), encoded);
+    expectInvalidType(() => validateInterpreterSnapshot(snapshot, nodes, new Budget()));
+    expectInvalidType(() => restore(snapshot, { source }));
+  });
+
+  it("does not invoke root schema getters or proxy traps", () => {
+    const { snapshot } = fixture();
+    let hooks = 0;
+    const accessor = Object.defineProperty({ ...snapshot }, "sourceHash", {
+      get() {
+        hooks += 1;
+        return snapshot.sourceHash;
+      }
+    });
+    expectInvalidType(() => restore(accessor, { source }));
+    const proxy = new Proxy(snapshot, {
+      get() {
+        hooks += 1;
+        throw new Error("Unexpected read");
+      },
+      ownKeys() {
+        hooks += 1;
+        return [];
+      }
+    });
+    expectInvalidType(() => restore(proxy, { source }));
+    expect(hooks).toBe(0);
+  });
+
+  it("rejects inherited schema getters and proxy prototypes without invoking them", () => {
+    let hooks = 0;
+    const inherited = Object.create({
+      get sourceHash() {
+        hooks += 1;
+        return "hash";
+      }
+    });
+    const prototype = new Proxy(
+      {},
+      {
+        get() {
+          hooks += 1;
+          return undefined;
+        },
+        ownKeys() {
+          hooks += 1;
+          return [];
+        }
+      }
+    );
+    expectInvalidType(() => validateSnapshotSourceHash(inherited));
+    expectInvalidType(() => validateSnapshotSourceHash(Object.create(prototype)));
+    expect(hooks).toBe(0);
+  });
+
+  it("preserves encoded Float32 backing references and ordinary restored values", () => {
+    const floats = new Float32Array([1, 2, 3]);
+    const { snapshot, nodes } = fixture({ first: floats, tail: floats.subarray(1) });
+    expect(() => validateInterpreterSnapshot(snapshot, nodes, new Budget())).not.toThrow();
+    expect(() => validateSnapshotData(encodeReplayData(floats))).not.toThrow();
+    const dumped = JSON.parse(
+      serializeSafeJSSnapshot({
+        sourceHash: snapshot.sourceHash,
+        bindings: { value: { first: floats, tail: floats.subarray(1) } }
+      })
+    );
+    validateDumpEnvelope(dumped);
+    const binding = restore(snapshot, { source }).currentScope.lookup("value");
+    expect(binding.found).toBe(true);
+    if (!binding.found) throw new Error("Missing restored value");
+    const restored = binding.value as { first: Float32Array; tail: Float32Array };
+    expect(Array.from(restored.first)).toEqual([1, 2, 3]);
+    expect(Array.from(restored.tail)).toEqual([2, 3]);
+    expect(restored.first.buffer).toBe(restored.tail.buffer);
+  });
+
+  it("preserves existing non-binary schema errors", () => {
+    expect(() => validateDumpEnvelope({ version: 999, sourceHash: "hash" })).toThrow(
+      expect.objectContaining({ code: "unsupportedVersion" })
+    );
+    expect(() =>
+      validateDumpEnvelope({ version: 1, sourceHash: "hash", clock: { next: -1 } })
+    ).toThrow(expect.objectContaining({ code: "invalidValue" }));
+    const { snapshot, nodes } = fixture();
+    expect(() =>
+      validateInterpreterSnapshot({ ...snapshot, currentAstNodeId: -1 }, nodes, new Budget())
+    ).toThrow(expect.objectContaining({ code: "invalidValue" }));
+  });
+});
+
+describe("raw run snapshot construction", () => {
+  it("validates a supplied snapshot before reading its promise replay state", async () => {
+    const { snapshot } = fixture();
+    let hooks = 0;
+    const supplied = new Proxy(
+      { version: 1, ...snapshot },
+      {
+        get() {
+          hooks += 1;
+          throw new Error("Unexpected snapshot read");
+        },
+        ownKeys() {
+          hooks += 1;
+          return [];
+        }
+      }
+    );
+    await expect(run(source, { snapshot: supplied, random: random() })).rejects.toThrow(
+      expect.objectContaining({ code: "invalidType" })
+    );
+    expect(hooks).toBe(0);
+  });
+
+  it("rejects bytes produced by clock.snapshot without requesting a dump", async () => {
+    await expect(
+      run(source, {
+        random: random(),
+        clock: { snapshot: () => ({ next: 1, extra: new ArrayBuffer(4) }) }
+      })
+    ).rejects.toThrow(new TypeError(persistenceMessage));
+  });
+
+  it("checks the final random snapshot rather than only its initial state", async () => {
+    let snapshots = 0;
+    await expect(
+      run(source, {
+        random: {
+          ...random(),
+          snapshot: () => {
+            snapshots += 1;
+            return snapshots === 1 ? 1 : (new ArrayBuffer(4) as unknown as number);
+          }
+        }
+      })
+    ).rejects.toThrow(new TypeError(persistenceMessage));
+    expect(snapshots).toBeGreaterThanOrEqual(2);
+  });
+
+  it("rejects symbol-keyed bytes in freshly produced clock metadata", async () => {
+    await expect(
+      run(source, {
+        random: random(),
+        clock: { snapshot: () => ({ next: 1, [Symbol("bytes")]: new ArrayBuffer(4) }) }
+      })
+    ).rejects.toThrow(expect.objectContaining({ code: "invalidType" }));
+  });
+
+  it("rejects clock metadata accessors without evaluating them", async () => {
+    let reads = 0;
+    await expect(
+      run(source, {
+        random: random(),
+        clock: {
+          snapshot: () => ({
+            get next() {
+              reads += 1;
+              return 1;
+            }
+          })
+        }
+      })
+    ).rejects.toThrow(expect.objectContaining({ code: "invalidType" }));
+    expect(reads).toBe(0);
+  });
+
+  it("rejects proxy clock snapshots without invoking reflection hooks", async () => {
+    let hooks = 0;
+    const clockSnapshot = new Proxy(
+      { next: 1 },
+      {
+        get() {
+          hooks += 1;
+          return undefined;
+        },
+        ownKeys() {
+          hooks += 1;
+          return [];
+        }
+      }
+    );
+    await expect(
+      run(source, {
+        random: random(),
+        clock: { snapshot: () => clockSnapshot }
+      })
+    ).rejects.toThrow("Proxy objects cannot be persisted or digested.");
+    expect(hooks).toBe(0);
+  });
+
+  it("preserves native Float32 runtime values and ordinary snapshot metadata", async () => {
+    const result = await run("const floats = new Float32Array([1, 2]); return floats;", {
+      random: random(),
+      clock: { snapshot: () => ({ next: 1 }) }
+    });
+    expect(result.ok).toBe(true);
+    expect(result.snapshot.bindings.floats).toBeInstanceOf(Float32Array);
+    expect(result.snapshot.clock).toEqual({ next: 1 });
+    expect(result.snapshot.random?.state).toBe(1);
+  });
+});
