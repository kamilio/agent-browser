+import { describe, expect, it } from "vitest";
+import {
+  type NativeBinary,
+  binaryDataProperties,
+  isBinaryCandidate,
+  isBinaryIndex,
+  isBinaryStorage
+} from "./binary-storage.js";
+
+const factories = [
+  { name: "ArrayBuffer", create: (): NativeBinary => new ArrayBuffer(4) },
+  { name: "Uint8Array", create: (): NativeBinary => new Uint8Array([1, 2, 3, 4]) },
+  { name: "DataView", create: (): NativeBinary => new DataView(new ArrayBuffer(4)) }
+];
+
+describe("binary value admission barriers", () => {
+  it.each(factories)("recognizes supported $name storage", ({ create }) => {
+    const value = create();
+    expect(isBinaryCandidate(value)).toBe(true);
+    expect(isBinaryStorage(value)).toBe(true);
+    expect(binaryDataProperties(value)).toEqual([]);
