+    expect(await method("entries").call([bytes])).toEqual([
+      ["0", 7],
+      ["1", 8],
+      ["backing", buffer]
+    ]);
+    expect(await method("keys").call([buffer])).toEqual([]);
+    expect(await method("keys").call([new DataView(buffer)])).toEqual([]);
+  });
+
+  it("uses byte assignment rules and preserves existing data descriptors", async () => {
+    const { method } = reflectionFixture();
+    const bytes = new Uint8Array(2);
+    Object.defineProperty(bytes, "metadata", { value: 1, writable: true });
+    expect(
+      await method("assign").call([
+        bytes,
+        {
+          "0": "258",
+          "1": -1,
+          "5": 9,
+          "-0": 9,
+          "1.5": 9,
+          metadata: 2
+        }
+      ])
+    ).toBe(bytes);
+    expect([...bytes]).toEqual([2, 255]);
+    expect(Object.keys(bytes)).toEqual(["0", "1"]);
+    expect(Object.getOwnPropertyDescriptor(bytes, "metadata")).toEqual({
+      value: 2,
+      writable: true,
+      enumerable: false,
+      configurable: false
+    });
+  });
+
+  it("rejects object-valued indexed assignment without coercion", () => {
+    const { method } = reflectionFixture();
+    let calls = 0;
+    const entry = Object.create(null) as SandboxObject;
+    Object.defineProperty(entry, "valueOf", {
+      get: () => {
+        calls += 1;
+        return 3;
+      }
+    });
+    const bytes = new Uint8Array([7]);
+    expect(() => method("assign").call([bytes, { "0": entry }])).toThrow(TypeError);
+    expect(bytes[0]).toBe(7);
+    expect(calls).toBe(0);
+  });
+
+  it("protects readonly binary metadata in generic assignment", () => {
+    const { method } = reflectionFixture();
+    const buffer = new ArrayBuffer(4);
+    for (const target of [buffer, new Uint8Array(buffer), new DataView(buffer)]) {
+      expect(() => method("assign").call([target, { byteLength: 99 }])).toThrow(TypeError);
+    }
+    for (const target of [new Uint8Array(buffer), new DataView(buffer)]) {
+      expect(() => method("assign").call([target, { buffer }])).toThrow(TypeError);
+      expect(() => method("assign").call([target, { byteOffset: 1 }])).toThrow(TypeError);
+    }
+  });
+
+  it("inspects real own descriptors rather than inherited metadata", async () => {
+    const { method } = reflectionFixture();
+    const bytes = new Uint8Array(2);
+    expect(await method("hasOwn").call([bytes, "0"])).toBe(true);
+    expect(await method("hasOwn").call([bytes, "buffer"])).toBe(false);
+    expect(await method("hasOwn").call([bytes, "length"])).toBe(false);
+    expect(await method("hasOwn").call([bytes, "-0"])).toBe(false);
+  });
+
+  it("does not invoke binary accessor expandos during reflection", () => {
+    const { budget, method } = reflectionFixture();
+    const bytes = new Uint8Array(1);
+    let calls = 0;
+    Object.defineProperty(bytes, "metadata", {
+      enumerable: true,
+      get: () => {
+        calls += 1;
+        return 3;
+      }
+    });
+    for (const name of ["keys", "values", "entries", "freeze", "isFrozen", "getPrototypeOf"])
+      expect(() => method(name).call([bytes])).toThrow(TypeError);
+    expect(() => method("assign").call([{}, bytes])).toThrow(TypeError);
+    expect(() => method("hasOwn").call([bytes, "metadata"])).toThrow(TypeError);
+    expect(() => findGuestProperty(bytes, "metadata", budget)).toThrow(TypeError);
+    expect(() => guestForInKeys(bytes, budget)).toThrow(TypeError);
+    expect(calls).toBe(0);
+  });
+
+  it("rejects unsupported and mis-prototyped native storage instead of flattening it", () => {
+    const { budget, method } = reflectionFixture();
+    const changed = new Uint8Array(1);
+    Object.setPrototypeOf(changed, null);
+    const symbol = new Uint8Array(1);
+    Object.defineProperty(symbol, Symbol.toStringTag, { value: "Object" });
+    for (const value of [new Uint16Array(1), changed, symbol]) {
+      expect(isOrdinaryGuestObject(value)).toBe(false);
+      for (const name of ["keys", "values", "entries", "freeze", "isFrozen", "getPrototypeOf"])
+        expect(() => method(name).call([value as unknown as SandboxObject])).toThrow(TypeError);
+      expect(() => guestPrototype(value, budget)).toThrow(TypeError);
+    }
+  });
+
+  it("uses only explicitly registered guest prototypes, never host prototypes", async () => {
+    const { budget, method } = reflectionFixture();
+    const bytes = new Uint8Array(1);
+    expect(await method("getPrototypeOf").call([bytes])).toBe(null);
+    const prototype = Object.create(null) as SandboxObject;
+    setGuestPrototype(prototype, null);
+    setGuestPrototype(bytes, prototype);
+    expect(await method("getPrototypeOf").call([bytes])).toBe(prototype);
+    expect(Object.getPrototypeOf(bytes)).toBe(Uint8Array.prototype);
+    expect(findGuestProperty(bytes, "constructor", budget)).toBeUndefined();
+    expect(guestForInKeys(bytes, budget)).toEqual(["0"]);
+  });
+
+  it("preserves native freeze constraints without claiming backing bytes are immutable", async () => {
+    const { method } = reflectionFixture();
+    const bytes = new Uint8Array([1]);
+    expect(() => method("freeze").call([bytes])).toThrow(TypeError);
+    expect(Object.isExtensible(bytes)).toBe(false);
+    expect(await method("isFrozen").call([bytes])).toBe(false);
+    const buffer = new ArrayBuffer(1);
+    const view = new DataView(buffer);
+    for (const value of [buffer, view, new Uint8Array(0)]) {
+      expect(await method("freeze").call([value])).toBe(value);
+      expect(await method("isFrozen").call([value])).toBe(true);
+    }
+    view.setUint8(0, 9);
+    expect(new Uint8Array(buffer)[0]).toBe(9);
+  });
+
+  it("collects Uint8Array contents without consulting shadowed length metadata", async () => {
+    const { globals } = reflectionFixture();
+    const from = globals.Array.properties?.from;
