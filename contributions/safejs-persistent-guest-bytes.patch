+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createRealm } from "../realm.js";
+import * as storage from "./binary-storage.js";
+import { Budget } from "./budget.js";
+import { createConsoleJsonGlobals } from "./globals/console-json.js";
+import { createMiscGlobals } from "./globals/misc.js";
+import { type SandboxClosure, isSandboxClosure } from "./values.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+function consoleMethod(budget: Budget, level: "log" | "error") {
+  const sink = { log: vi.fn(), error: vi.fn() };
+  const method = createConsoleJsonGlobals({ budget, sink }).console[level];
+  if (!isSandboxClosure(method)) throw new Error("Missing console method.");
+  return { sink, method: method as SandboxClosure };
+}
+
+describe("guest binary copy boundary budgets", () => {
+  it("rejects structuredClone before copying when existing retention consumes the budget", () => {
+    const budget = new Budget({ arrayLength: 16, dataSize: 17 });
+    budget.chargeDataUsage(17);
+    const copy = vi.spyOn(storage, "copyBinaryStorage");
+    const globals = createMiscGlobals({ budget });
+    expect(() => globals.structuredClone.call([new ArrayBuffer(16)])).toThrow(
+      expect.objectContaining({ budget: "dataSize" })
+    );
+    expect(copy).not.toHaveBeenCalled();
+    expect(budget.currentDataSize).toBe(17);
+  });
+
+  it("preflights all structuredClone backing stores as one graph", () => {
+    const budget = new Budget({ arrayLength: 8, dataSize: 11 });
+    const copy = vi.spyOn(storage, "copyBinaryStorage");
+    const globals = createMiscGlobals({ budget });
+    expect(() => globals.structuredClone.call([[new ArrayBuffer(8), new ArrayBuffer(8)]])).toThrow(
+      expect.objectContaining({ budget: "dataSize" })
+    );
+    expect(copy).not.toHaveBeenCalled();
+    expect(budget.currentDataSize).toBe(0);
+  });
+
+  it("charges aliased structuredClone backing once and keeps its output independent", () => {
+    const budget = new Budget({ arrayLength: 8, dataSize: 9 });
+    const buffer = new ArrayBuffer(8);
+    const result = createMiscGlobals({ budget }).structuredClone.call([
+      [buffer, buffer]
+    ]) as ArrayBuffer[];
+    expect(result).toHaveLength(2);
+    expect(result[0]).toBe(result[1]);
+    expect(result[0]).not.toBe(buffer);
+    expect(budget.currentDataSize).toBe(0);
+  });
+
+  it.each(["log", "error"] as const)(
+    "blocks console.%s before copying or publishing retained bytes",
+    async (level) => {
+      const budget = new Budget({ arrayLength: 16, dataSize: 17 });
+      budget.chargeDataUsage(17);
+      const { sink, method } = consoleMethod(budget, level);
+      const copy = vi.spyOn(storage, "copyBinaryStorage");
+      await expect(method.call([new ArrayBuffer(16)])).rejects.toMatchObject({
+        budget: "dataSize"
+      });
+      expect(copy).not.toHaveBeenCalled();
+      expect(sink.log).not.toHaveBeenCalled();
+      expect(sink.error).not.toHaveBeenCalled();
+      expect(budget.currentDataSize).toBe(17);
+    }
+  );
+
+  it.each(["log", "error"] as const)("preflights console.%s arguments together", async (level) => {
+    const budget = new Budget({ arrayLength: 8, dataSize: 11 });
+    const { sink, method } = consoleMethod(budget, level);
+    const copy = vi.spyOn(storage, "copyBinaryStorage");
+    await expect(method.call([new ArrayBuffer(8), new ArrayBuffer(8)])).rejects.toMatchObject({
+      budget: "dataSize"
+    });
+    expect(copy).not.toHaveBeenCalled();
+    expect(sink.log).not.toHaveBeenCalled();
+    expect(sink.error).not.toHaveBeenCalled();
+    expect(budget.currentDataSize).toBe(0);
+  });
+
+  it.each(["log", "error"] as const)(
+    "preserves cross-argument aliases in console.%s",
+    async (level) => {
+      const budget = new Budget({ arrayLength: 8, dataSize: 10 });
+      const { sink, method } = consoleMethod(budget, level);
+      const original = new Uint8Array([1, 2, 3, 4, 5, 6, 7, 8]);
+      const value = new Uint8Array(original.buffer, 2, 3);
+      await method.call([value, original.buffer, value]);
+      expect(sink[level]).toHaveBeenCalledTimes(1);
+      const [copied, buffer, repeated] = sink[level].mock.calls[0] as [
+        Uint8Array,
+        ArrayBuffer,
+        Uint8Array
+      ];
+      expect(copied).toBe(repeated);
+      expect(copied.buffer).toBe(buffer);
+      expect(buffer).not.toBe(original.buffer);
+      expect(copied.byteOffset).toBe(2);
+      expect([...copied]).toEqual([3, 4, 5]);
+      copied[0] = 90;
+      expect(original[2]).toBe(3);
+      expect(budget.currentDataSize).toBe(0);
+    }
+  );
+
+  it("uses the actual realm budget for guest structuredClone copies", async () => {
+    const budget = new Budget({ arrayLength: 1000, dataSize: 100000 });
+    const realm = createRealm({ budget });
+    const copy = vi.spyOn(storage, "copyBinaryStorage");
+    try {
+      const result = await realm.evaluate("structuredClone(new Uint8Array([7, 8]).buffer)");
+      expect([...new Uint8Array(result.returnValue as ArrayBuffer)]).toEqual([7, 8]);
+      expect(copy).toHaveBeenCalled();
+      expect(copy.mock.calls.every((args) => args[2] === budget)).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("uses one budgeted native graph for a real guest console call", async () => {
+    const budget = new Budget({ arrayLength: 1000, dataSize: 100000 });
+    const sink = { log: vi.fn(), error: vi.fn() };
+    const realm = createRealm({ budget, sink });
+    const copy = vi.spyOn(storage, "copyBinaryStorage");
+    try {
+      await realm.evaluate(
+        "const bytes = new Uint8Array([7, 8]); console.log(bytes, bytes.buffer, bytes);"
+      );
+      const [bytes, buffer, repeated] = sink.log.mock.calls[0] as [
+        Uint8Array,
+        ArrayBuffer,
+        Uint8Array
+      ];
+      expect(bytes).toBe(repeated);
+      expect(bytes.buffer).toBe(buffer);
+      expect([...bytes]).toEqual([7, 8]);
+      expect(copy).toHaveBeenCalled();
+      expect(copy.mock.calls.every((args) => args[2] === budget)).toBe(true);
+    } finally {
+      await realm.close();
+    }
+  });
+});
diff --git a/packages/safe-js/src/interp/binary-persistence.test.ts b/packages/safe-js/src/interp/binary-persistence.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/binary-persistence.test.ts
@@ -0,0 +1,241 @@
+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { serializeSafeJSSnapshot } from "../snapshot/dump-format.js";
+import {
+  MissingReplayCapabilityError,
+  decodeReplayData,
+  encodeReplayData
+} from "../snapshot/replay-data.js";
+import { type RuntimeSnapshotValue, serialize } from "../snapshot/serialize.js";
+import { digestHostCallArguments } from "./host-call.js";
+import {
+  type SandboxValue,
+  createSandboxClosure,
+  createSandboxMap,
+  createSandboxSet
+} from "./values.js";
+
+const persistenceMessage = "Binary persistence is not supported.";
+const digestMessage = "Binary argument digests are not supported.";
+
+function snapshot(value: unknown) {
+  return serialize({
+    source: "await task()",
+    currentAstNodeId: 1,
+    scopeChain: [{ id: 1, bindings: { value: value as RuntimeSnapshotValue } }],
+    callStack: [],
+    pendingPromises: [],
+    moduleBindings: {}
+  });
+}
+
+const persistenceRoutes: Array<[string, (value: unknown) => unknown]> = [
+  ["replay", (value) => encodeReplayData(value as SandboxValue)],
+  ["snapshot", snapshot],
+  ["dump", (value) => serializeSafeJSSnapshot({ sourceHash: "binary-test", value })]
+];
+
+const candidates: Array<[string, () => unknown]> = [
+  ["ArrayBuffer", () => new ArrayBuffer(4)],
+  ["Uint8Array", () => new Uint8Array([1, 2])],
+  ["DataView", () => new DataView(new ArrayBuffer(4))],
+  ["unsupported view", () => new Uint16Array([1])],
+  ["shared buffer", () => new SharedArrayBuffer(4)],
+  ["shared view", () => new Uint8Array(new SharedArrayBuffer(4))],
+  ["subclassed buffer", () => new (class extends ArrayBuffer {})(4)],
+  [
+    "detached buffer",
+    () => {
+      const buffer = new ArrayBuffer(4);
+      structuredClone(buffer, { transfer: [buffer] });
+      return buffer;
+    }
+  ],
+  ["null-prototype buffer", () => Object.setPrototypeOf(new ArrayBuffer(4), null)],
+  ["plain-prototype view", () => Object.setPrototypeOf(new Uint8Array([1]), Object.prototype)],
+  ["null-prototype DataView", () => Object.setPrototypeOf(new DataView(new ArrayBuffer(4)), null)],
+  ["invalid Float32 prototype", () => Object.setPrototypeOf(new Float32Array([1]), null)]
+];
+
+describe.each(persistenceRoutes)("binary %s barrier", (_name, persist) => {
+  it.each(candidates)("explicitly rejects %s", (_kind, create) => {
+    expect(() => persist(create())).toThrow(new TypeError(persistenceMessage));
+  });
+
+  it("rejects nested arrays, collections, closure properties and shared cyclic graphs", () => {
+    const bytes = new Uint8Array([1]) as unknown as SandboxValue;
+    const graph: Record<string, SandboxValue> = {};
+    graph.self = graph;
+    graph.bytes = bytes;
+    const values = [
+      [bytes],
+      { nested: { bytes } },
+      createSandboxMap([[bytes, 1]]),
+      createSandboxMap([["bytes", bytes]]),
+      createSandboxSet([bytes]),
+      new Map([["bytes", bytes]]),
+      new Set([bytes]),
+      createSandboxClosure({ call: () => 1, properties: { bytes } }),
+      [graph, graph]
+    ];
+    for (const value of values) {
+      expect(() => persist(value)).toThrow(new TypeError(persistenceMessage));
+    }
+  });
+
+  it("rejects bytes in Float32 expando data without treating its backing as new binary data", () => {
+    const floats = new Float32Array([1]);
+    Object.defineProperty(floats, "bytes", { value: new ArrayBuffer(4) });
+    expect(() => persist(floats)).toThrow(new TypeError(persistenceMessage));
+    expect(() => persist(new Float32Array([1, 2]))).not.toThrow();
+  });
+
+  it("does not reject ordinary byte-shaped records", () => {
+    const lookalike = { byteLength: 4, byteOffset: 0, buffer: {}, length: 4, "0": 1 };
+    expect(() => persist(lookalike)).not.toThrow();
+    expect(() => persist(Object.assign(Object.create(null), lookalike))).not.toThrow();
+  });
+
+  it("rejects proxies without invoking reflection traps", () => {
+    const traps: string[] = [];
+    const proxy = new Proxy(new ArrayBuffer(4), {
+      getPrototypeOf() {
+        traps.push("getPrototypeOf");
+        return ArrayBuffer.prototype;
+      },
+      ownKeys() {
+        traps.push("ownKeys");
+        return [];
+      },
+      get() {
+        traps.push("get");
+        return undefined;
+      }
+    });
+    expect(() => persist(proxy)).toThrow("Proxy objects cannot be persisted or digested.");
+    expect(traps).toEqual([]);
+  });
+});
+
+describe("binary replay and digest integrity", () => {
+  it("does not hide bytes behind missing capability errors or capability-only encoding", () => {
+    const closure = createSandboxClosure({
+      call: () => 1,
+      properties: { bytes: new ArrayBuffer(4) as unknown as SandboxValue }
+    });
+    expect(() => encodeReplayData(closure)).toThrow(new TypeError(persistenceMessage));
+    expect(() => encodeReplayData(closure)).not.toThrow(MissingReplayCapabilityError);
+    for (const captureCapabilityProperties of [false, true]) {
+      expect(() =>
+        encodeReplayData(closure, {
+          identifyCapability: () => "callback",
+          captureCapabilityProperties
+        })
+      ).toThrow(new TypeError(persistenceMessage));
+    }
+  });
+
+  it("rejects native bytes smuggled into replay wire records before decoding", () => {
+    const atom = Object.assign(Object.setPrototypeOf(new ArrayBuffer(4), null), {
+      tag: "undefined"
+    });
+    expect(() => decodeReplayData({ root: atom, nodes: [] })).toThrow(
+      new TypeError(persistenceMessage)
+    );
+  });
+
+  it("rejects bytes in pending-promise metadata and ignored dump heap fields", () => {
+    expect(() =>
+      serialize({
+        source: "await task()",
+        currentAstNodeId: 1,
+        scopeChain: [],
+        callStack: [],
+        pendingPromises: [{ id: 1, result: new ArrayBuffer(4) as unknown as RuntimeSnapshotValue }],
+        moduleBindings: {}
+      })
+    ).toThrow(new TypeError(persistenceMessage));
+    expect(() =>
+      serializeSafeJSSnapshot({
+        sourceHash: "binary-test",
+        heap: { hidden: new ArrayBuffer(4) }
+      })
+    ).toThrow(new TypeError(persistenceMessage));
+  });
+
+  it("preserves Float32 replay tags, shared backing and bytes", () => {
+    const backing = new Float32Array([1, 2, 3, 4]);
+    const views = [backing.subarray(0, 2), backing.subarray(2)];
+    const encoded = encodeReplayData(views);
+    expect(encoded.nodes[1]).toMatchObject({
+      kind: "float32array",
+      byteOffset: 0,
+      length: 2,
+      bytes: Array.from(new Uint8Array(backing.buffer))
+    });
+    expect(encoded.nodes[2]).toMatchObject({
+      kind: "float32array",
+      byteOffset: 8,
+      length: 2,
+      buffer: { tag: "ref", id: 1 }
+    });
+    const restored = decodeReplayData(encoded) as Float32Array[];
+    const [first, second] = restored;
+    if (first === undefined || second === undefined)
+      throw new Error("Missing restored Float32 views.");
+    expect(Array.from(first)).toEqual([1, 2]);
+    expect(Array.from(second)).toEqual([3, 4]);
+    expect(first.buffer).toBe(second.buffer);
+    expect(snapshot(backing).heap?.["1"]).toMatchObject({ kind: "float32array" });
+    expect(
+      JSON.parse(serializeSafeJSSnapshot({ sourceHash: "float-test", backing })).heap["1"]
+    ).toMatchObject({ kind: "float32array" });
+  });
+
+  it.each(candidates)("prevents %s from receiving a generic-object digest", (_kind, create) => {
+    expect(() => digestHostCallArguments([create()])).toThrow(new TypeError(digestMessage));
+    expect(() => digestHostCallArguments([{}])).not.toThrow();
+  });
+
+  it("rejects different byte contents rather than hashing either as an empty record", () => {
+    for (const byte of [1, 2]) {
+      const buffer = new Uint8Array([byte]).buffer;
+      expect(() => digestHostCallArguments([buffer])).toThrow(new TypeError(digestMessage));
+      expect(() => digestHostCallArguments([new DataView(buffer)])).toThrow(
+        new TypeError(digestMessage)
+      );
+    }
+  });
+
+  it("rejects bytes nested in collection and closure digest arguments", () => {
+    const bytes = new Uint8Array([1]) as unknown as SandboxValue;
+    for (const value of [
+      [bytes],
+      { bytes },
+      createSandboxMap([[bytes, 1]]),
+      createSandboxSet([bytes]),
+      new Map([[bytes, 1]]),
+      new Set([bytes]),
+      createSandboxClosure({ call: () => 1, properties: { bytes } }),
+      Object.assign(new Float32Array([1]), { bytes })
+    ]) {
+      expect(() => digestHostCallArguments([value])).toThrow(new TypeError(digestMessage));
+    }
+  });
+
+  it("preserves the established Float32 digest representation", () => {
+    const floats = new Float32Array([1, 2]);
+    const representation = [
+      {
+        $type: "float32array",
+        bytes: Array.from(new Uint8Array(floats.buffer)),
+        byteOffset: 0,
+        length: 2,
+        properties: {}
+      }
+    ];
+    const expected = createHash("sha256").update(JSON.stringify(representation)).digest("hex");
+    expect(digestHostCallArguments([floats])).toBe(expected);
+    expect(() => digestHostCallArguments([{ byteLength: 4, buffer: {}, "0": 1 }])).not.toThrow();
+  });
+});
