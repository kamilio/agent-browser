+    const floats = new Float32Array(buffer, 4, 2);
+    bytes[0] = 91;
+    Object.defineProperty(buffer, "owner", { value: bytes, enumerable: false });
+    Object.defineProperty(bytes, "self", { value: bytes, enumerable: false });
+    Object.preventExtensions(buffer);
+    Object.preventExtensions(bytes);
+    const copied = copyValue([floats, bytes, buffer, view, bytes]) as [
+      Float32Array,
+      Uint8Array,
+      ArrayBuffer,
+      DataView,
+      Uint8Array
+    ];
+    expect(copied[2]).not.toBe(buffer);
+    expect(copied[0].buffer).toBe(copied[2]);
+    expect(copied[1].buffer).toBe(copied[2]);
+    expect(copied[3].buffer).toBe(copied[2]);
+    expect(copied[4]).toBe(copied[1]);
+    expect(copied[1].byteOffset).toBe(3);
+    expect(copied[1].length).toBe(5);
+    expect(copied[3].byteOffset).toBe(2);
+    expect(copied[3].byteLength).toBe(7);
+    expect(Object.getOwnPropertyDescriptor(copied[2], "owner")).toEqual({
+      value: copied[1],
+      enumerable: false,
+      writable: false,
+      configurable: false
+    });
+    expect(Object.getOwnPropertyDescriptor(copied[1], "self")?.value).toBe(copied[1]);
+    expect(Object.isExtensible(copied[2])).toBe(false);
+    expect(Object.isExtensible(copied[1])).toBe(false);
