index 0000000..aab8545
--- /dev/null
+++ b/packages/safe-js/src/realm.test.ts
@@ -0,0 +1,329 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { createRealm } from "./core.js";
+import { Budget, SandboxError } from "./interp/budget.js";
+import { deepCopyFromSandbox } from "./interp/values.js";
+import { runResources } from "./interp/resources.js";
+
+describe("persistent realm", () => {
+  it("keeps lexical state, object identity and old closures without replay", async () => {
+    const record = vi.fn();
+    const realm = createRealm({ bindings: { record } });
+    try {
+      await realm.evaluate(
+        "let count = 1; const object = { count: 2 }; function next() { count += object.count; return count; } record(count);"
+      );
+      await realm.evaluate("const alias = object; object.count = 4;");
+      const result = await realm.evaluate("[next(), next(), object === alias, count]");
+      expect(deepCopyFromSandbox(result.returnValue)).toEqual([5, 9, true, 9]);
+      expect(record).toHaveBeenCalledExactlyOnceWith(1);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("isolates independent realms", async () => {
+    const first = createRealm();
+    const second = createRealm();
+    try {
+      await first.evaluate("let count = 11;");
+      expect((await second.evaluate("typeof count")).returnValue).toBe("undefined");
+      expect((await first.evaluate("count")).returnValue).toBe(11);
+    } finally {
+      await Promise.all([first.close(), second.close()]);
+    }
+  });
+
+  it("retains regexes and asynchronous functions across sources", async () => {
+    const realm = createRealm();
+    try {
+      await realm.evaluate(
+        "const matcher = /ab+/; async function check(value) { return matcher.test(await Promise.resolve(value)); }"
+      );
+      expect((await realm.evaluate('await check("abbb")')).returnValue).toBe(true);
+      expect((await realm.evaluate('await check("xyz")')).returnValue).toBe(false);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("fails closed on declaration conflicts and parse failures", async () => {
+    for (const source of ["let count = 2;", "let = ;"]) {
+      const realm = createRealm();
+      await realm.evaluate("let count = 1;");
+      await expect(realm.evaluate(source)).rejects.toBeDefined();
+      await expect(realm.evaluate("count")).rejects.toMatchObject({ code: "aborted" });
+      await realm.close();
+    }
+  });
+
+  it("charges cumulative steps and cannot catch fatal exhaustion", async () => {
+    const budget = new Budget({ maxSteps: 120 });
+    const realm = createRealm({ budget });
+    await realm.evaluate("let count = 0;");
+    const before = budget.stepsUsed;
+    await realm.evaluate("count += 1;");
+    expect(budget.stepsUsed).toBeGreaterThan(before);
+    await expect(
+      realm.evaluate("try { while (true) { count += 1; } } catch (error) { count = 0; }")
+    ).rejects.toMatchObject({ code: "budgetExceeded", budget: "steps" });
+    await expect(realm.evaluate("count")).rejects.toMatchObject({ code: "aborted" });
+    await realm.close();
+  });
+
+  it("rejects overlap without aborting the already-running job", async () => {
+    let settle!: (value: number) => void;
+    let entered!: () => void;
+    const started = new Promise<void>((resolve) => {
+      entered = resolve;
+    });
+    const realm = createRealm({
+      bindings: {
+        wait: () => {
+          entered();
+          return new Promise<number>((resolve) => {
+            settle = resolve;
+          });
+        }
+      }
+    });
+    const pending = realm.evaluate("await wait()");
+    await started;
+    await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "reentry" });
+    settle(42);
+    expect((await pending).returnValue).toBe(42);
+    await realm.close();
+  });
+
+  it("cancels a pending await and closes permanently", async () => {
+    const controller = new AbortController();
+    let entered!: () => void;
+    const started = new Promise<void>((resolve) => {
+      entered = resolve;
+    });
+    const realm = createRealm({
+      bindings: {
+        wait: () => {
+          entered();
+          return new Promise(() => undefined);
+        }
+      }
+    });
+    const pending = realm.evaluate("await wait()", { signal: controller.signal });
+    const rejection = expect(pending).rejects.toBeInstanceOf(SandboxError);
+    await started;
+    controller.abort();
+    await rejection;
+    await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "aborted" });
+    await realm.close();
+  });
+
+  it("revokes host-retained guest callbacks on close", async () => {
+    let callback!: () => Promise<unknown>;
+    const effect = vi.fn();
+    const realm = createRealm({
+      bindings: {
+        save: (value: unknown) => {
+          callback = value as typeof callback;
+        },
+        effect
+      }
+    });
+    await realm.evaluate("save(() => effect());");
+    await realm.evaluate("1");
+    await realm.close();
+    await expect(callback()).rejects.toBeDefined();
+    expect(effect).not.toHaveBeenCalled();
+    await realm.close();
+  });
+
+  it("closes on an unhandled promise rejection", async () => {
+    const realm = createRealm();
+    await expect(realm.evaluate('Promise.reject("failure"); 1;')).rejects.toMatchObject({
+      name: "UnhandledRejectionError"
+    });
+    await expect(realm.evaluate("1")).rejects.toMatchObject({ code: "aborted" });
+    await realm.close();
+  });
+
+  it("bounds cumulative source, not just individual programs", async () => {
+    const realm = createRealm({ maxSourceLength: 20 });
+    await realm.evaluate("let count = 0;");
+    await expect(realm.evaluate("count += 1;")).rejects.toMatchObject({
+      code: "budgetExceeded",
+      budget: "stringLength"
+    });
+    await realm.close();
+  });
+
+  it("does not expose host globals or module imports", async () => {
+    const realm = createRealm();
+    expect(
+      deepCopyFromSandbox(
+        (await realm.evaluate("[typeof process, typeof require, typeof fetch, typeof Function]"))
+          .returnValue
+      )
+    ).toEqual(["undefined", "undefined", "undefined", "undefined"]);
+    await expect(realm.evaluate('import { readFile } from "fs";')).rejects.toBeDefined();
+    await realm.close();
+  });
+
+  it("waits for an interrupted active job when closing", async () => {
+    let entered!: () => void;
+    const started = new Promise<void>((resolve) => {
+      entered = resolve;
+    });
+    const effect = vi.fn();
+    const realm = createRealm({
+      bindings: {
+        wait: () => {
+          entered();
+          return new Promise(() => undefined);
+        },
+        effect
+      }
+    });
+    const pending = realm.evaluate("await wait(); effect();");
+    const rejection = expect(pending).rejects.toMatchObject({ code: "aborted" });
+    await started;
+    await realm.close();
+    await rejection;
+    expect(effect).not.toHaveBeenCalled();
+    expect(realm.closed).toBe(true);
+  });
+
+  it("keeps retained guest callbacks live between evaluations", async () => {
+    let callback!: () => Promise<unknown>;
+    const realm = createRealm({
+      bindings: {
+        save: (value: unknown) => {
+          callback = value as typeof callback;
+        }
+      }
+    });
+    try {
+      await realm.evaluate("let count = 0; save(() => { count += 1; return count; });");
+      await realm.evaluate("count += 10;");
+      expect(await callback()).toBe(11);
+      expect((await realm.evaluate("count")).returnValue).toBe(11);
+    } finally {
+      await realm.close();
+    }
+  });
+
+  it("does not let finally replace a fatal budget error", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 100 }) });
+    await expect(
+      realm.evaluate(
+        'function exhaust() { try { while (true) {} } finally { return "escaped"; } } exhaust();'
+      )
+    ).rejects.toMatchObject({ code: "budgetExceeded", budget: "steps" });
+    expect(realm.closed).toBe(true);
+    await realm.close();
+  });
+
+  it("bounds retained data across evaluations", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 100_000, dataSize: 8_000 }) });
+    await realm.evaluate("const retained = [];");
+    let exhausted = false;
+    for (let attempt = 0; attempt < 30; attempt += 1) {
+      try {
+        await realm.evaluate('retained.push("x".repeat(500));');
+      } catch (error) {
+        expect(error).toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+        exhausted = true;
+        break;
+      }
+    }
+    expect(exhausted).toBe(true);
+    expect(realm.closed).toBe(true);
+    await realm.close();
+  });
+
+  it("bounds evaluation count and rejects invalid limits", async () => {
+    for (const limit of [0, -1, 1.5, Infinity, NaN]) {
+      expect(() => createRealm({ maxEvaluations: limit })).toThrow(TypeError);
+      expect(() => createRealm({ maxSourceLength: limit })).toThrow(TypeError);
+    }
+    const realm = createRealm({ maxEvaluations: 1 });
+    await realm.evaluate("1");
+    await expect(realm.evaluate("2")).rejects.toMatchObject({ code: "budgetExceeded" });
+    await realm.close();
+  });
+
+  it("rejects pre-aborted creation and evaluation without effects", async () => {
+    const signal = AbortSignal.abort();
+    expect(() => createRealm({ signal })).toThrow(SandboxError);
+    const effect = vi.fn();
+    const realm = createRealm({ bindings: { effect } });
+    await expect(realm.evaluate("effect()", { signal })).rejects.toMatchObject({ code: "aborted" });
+    expect(effect).not.toHaveBeenCalled();
+    await realm.close();
+  });
+
+  it("keeps granted resources until close and closes each once", async () => {
+    const cleanup = vi.fn(async () => undefined);
+    const realm = createRealm({
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    await realm.evaluate("1");
+    expect(cleanup).not.toHaveBeenCalled();
+    await realm.close();
+    await realm.close();
+    expect(cleanup).toHaveBeenCalledTimes(1);
+  });
+
+  it("automatically releases idle resources on lifetime cancellation", async () => {
+    const controller = new AbortController();
+    const cleanup = vi.fn(async () => undefined);
+    const realm = createRealm({
+      signal: controller.signal,
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    controller.abort();
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    expect(cleanup).toHaveBeenCalledTimes(1);
+    await realm.close();
+  });
+
+  it("preserves fatal errors when resource cleanup also fails", async () => {
+    const cleanup = vi.fn(async () => {
+      throw new Error("cleanup failure");
+    });
+    const realm = createRealm({
+      budget: new Budget({ maxSteps: 100 }),
+      bindings: {
+        acquire: () => {
+          runResources.getStore()!.add(cleanup);
+        }
+      }
+    });
+    await realm.evaluate("acquire();");
+    await expect(realm.evaluate("while (true) {}")).rejects.toMatchObject({
+      code: "budgetExceeded"
+    });
+    await expect(realm.close()).rejects.toBeInstanceOf(AggregateError);
+    expect(cleanup).toHaveBeenCalledTimes(1);
+  });
+
+  it("accounts for promises retained only by rejection tracking", async () => {
+    const realm = createRealm({ budget: new Budget({ maxSteps: 100_000, dataSize: 256 }) });
+    try {
+      await expect(
+        realm.evaluate("for (let index = 0; index < 300; index += 1) { new Promise(() => {}); }")
+      ).rejects.toMatchObject({ code: "budgetExceeded", budget: "dataSize" });
+    } finally {
+      await realm.close();
+    }
+  });
+});
