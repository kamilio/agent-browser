diff --git a/packages/safe-js/src/interp/jobs-host-turn.test.ts b/packages/safe-js/src/interp/jobs-host-turn.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/safe-js/src/interp/jobs-host-turn.test.ts
@@ -0,0 +1,67 @@
+import { expect, it, vi } from "vitest";
+import { SandboxJobQueue } from "./jobs.js";
+
+it("serves host timers during expensive short execution without releasing guest ownership", async () => {
+  let now = 0;
+  const clock = vi.spyOn(Date, "now").mockImplementation(() => now);
+  const queue = new SandboxJobQueue();
+  queue.enableControl();
+  const order: string[] = [];
+  let timerRan = false;
+  let siblingRan = false;
+  const timer = new Promise<void>((resolve) =>
+    setImmediate(() => {
+      timerRan = true;
+      order.push("host timer");
+      resolve();
+    }),
+  );
+  try {
+    const parent = queue.run(async () => {
+      for (let index = 0; index < 512; index++) {
+        now++;
+        const checkpoint = SandboxJobQueue.checkpoint();
+        if (checkpoint !== undefined) await checkpoint;
+        expect(siblingRan).toBe(false);
+      }
+      expect(timerRan).toBe(true);
+      order.push("parent complete");
+    });
+    const sibling = queue.run(() => {
+      siblingRan = true;
+      order.push("sibling");
+    });
+    await Promise.all([parent, sibling, timer]);
+    expect(order).toEqual(["host timer", "parent complete", "sibling"]);
+  } finally {
+    clock.mockRestore();
+    queue.finish();
+    await timer;
+  }
+});
+
+it("still serves host timers when the host clock does not advance", async () => {
+  const clock = vi.spyOn(Date, "now").mockReturnValue(0);
+  const queue = new SandboxJobQueue();
+  queue.enableControl();
+  let timerRan = false;
+  const timer = new Promise<void>((resolve) =>
+    setImmediate(() => {
+      timerRan = true;
+      resolve();
+    }),
+  );
+  try {
+    await queue.run(async () => {
+      for (let index = 0; index < 8192; index++) {
+        const checkpoint = SandboxJobQueue.checkpoint();
+        if (checkpoint !== undefined) await checkpoint;
+      }
+      expect(timerRan).toBe(true);
+    });
+  } finally {
+    clock.mockRestore();
+    queue.finish();
+    await timer;
+  }
+});
