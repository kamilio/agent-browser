diff --git a/src/interp/generic-metadata-data-walk.test.ts b/src/interp/generic-metadata-data-walk.test.ts
new file mode 100644
--- /dev/null
+++ b/src/interp/generic-metadata-data-walk.test.ts
@@ -0,0 +1,316 @@
+import { expect, it } from "vitest";
+import { MAX_DATA_DEPTH } from "../graph-depth.js";
+import { Budget } from "./budget.js";
+import {
+  createIntrinsicObject,
+  markDescriptorObject,
+  setSandboxPrototype,
+} from "./object-model.js";
+import { internalSymbols } from "./internal-symbols.js";
+import { disposableStackStates } from "./disposable-stack.js";
+import { asyncDisposableStackStates } from "./async-disposable-stack.js";
+import { addPrivateElement } from "./private-state.js";
+import {
+  createSandboxClosure,
+  measureSandboxData,
+  reconcileCompiledValues,
+  type SandboxValue,
+} from "./values.js";
+
+function chain(depth: number, kind: "symbol" | "private" | "proxy"): object {
+  let root: object = {};
+  const key = Symbol("next");
+  const name = { description: "next" };
+  for (let index = 0; index < depth; index++) {
+    const parent = {};
+    if (kind === "private")
+      addPrivateElement(parent, name, {
+        kind: "field",
+        value: root as SandboxValue,
+      });
+    else Object.defineProperty(parent, key, { value: root });
+    root = kind === "proxy" ? new Proxy(parent, {}) : parent;
+  }
+  return root;
+}
+
+it.each(["symbol", "private", "proxy"] as const)(
+  "measures deep generic metadata on the default stack (%s)",
+  (kind) => {
+    expect(measureSandboxData([chain(MAX_DATA_DEPTH, kind)])).toBe(
+      kind === "private" ? MAX_DATA_DEPTH + 18 : MAX_DATA_DEPTH * 2 + 6,
+    );
+  },
+);
+
+it.each(["symbol", "private", "proxy"] as const)(
+  "rejects excessive generic metadata with dataDepth (%s)",
+  (kind) => {
+    expect(() => measureSandboxData([chain(MAX_DATA_DEPTH + 1, kind)])).toThrow(
+      expect.objectContaining({
+        budget: "dataDepth",
+        current: MAX_DATA_DEPTH + 1,
+      }),
+    );
+  },
+);
+
+function wrap(root: SandboxValue, depth = 140): SandboxValue {
+  for (let index = 0; index < depth; index++)
+    root = createIntrinsicObject({ next: root });
+  return root;
+}
+
+it.each([false, true])(
+  "keeps frozen symbol snapshots sensitive to catalogue changes (hide=%s)",
+  (hide) => {
+    const first = Symbol("first"),
+      later = Symbol("later");
+    let reads = 0;
+    const mutator = createSandboxClosure({
+      call: () => undefined,
+      retainedValues: () => {
+        reads++;
+        if (hide) internalSymbols.add(later);
+        else internalSymbols.delete(later);
+        return [];
+      },
+    });
+    const closure = createSandboxClosure({
+      call: () => undefined,
+      properties: (value) => {
+        Object.defineProperty(value, first, { value: mutator });
+        Object.defineProperty(value, later, { value: "x".repeat(1000) });
+        return createIntrinsicObject();
+      },
+    });
+    const root = wrap(closure);
+    if (!hide) internalSymbols.add(later);
+    try {
+      expect(measureSandboxData([root])).toBe(140 * 6 + (hide ? 10 : 1017));
+      expect(measureSandboxData([root])).toBe(140 * 6 + (hide ? 10 : 1017));
+      expect(reads).toBe(2);
+    } finally {
+      internalSymbols.delete(later);
+    }
+  },
+);
+
+it("keeps managed array descriptors captured before deep metadata callbacks", () => {
+  const array: SandboxValue[] = ["a"];
+  markDescriptorObject(array);
+  addPrivateElement(
+    array,
+    { description: "mutate" },
+    {
+      kind: "field",
+      value: createSandboxClosure({
+        call: () => undefined,
+        retainedValues: () => {
+          array[0] = "longer";
+          return [];
+        },
+      }),
+    },
+  );
+  const root = wrap(array);
+  const initial = measureSandboxData([root]);
+  expect(measureSandboxData([root])).toBe(initial + 5);
+});
+
+it.each([false, true])(
+  "keeps resource snapshots captured before deep metadata callbacks (async=%s)",
+  (async) => {
+    const stack = {};
+    const resource = {
+      method: createSandboxClosure({ call: () => undefined }),
+      receiver: undefined,
+      args: ["a"],
+      syncFallback: false,
+    };
+    if (async)
+      asyncDisposableStackStates.set(stack, {
+        disposed: false,
+        resources: [resource],
+      });
+    else
+      disposableStackStates.set(stack, {
+        disposed: false,
+        active: false,
+        resources: [resource],
+      });
+    addPrivateElement(
+      stack,
+      { description: "mutate" },
+      {
+        kind: "field",
+        value: createSandboxClosure({
+          call: () => undefined,
+          retainedValues: () => {
+            resource.args[0] = "longer";
+            return [];
+          },
+        }),
+      },
+    );
+    const root = wrap(stack);
+    const initial = measureSandboxData([root]);
+    expect(measureSandboxData([root])).toBe(initial + 5);
+  },
+);
+
+it("keeps primary limits active during held generic metadata reconciliation", () => {
+  const budget = new Budget({ dataSize: 1000 });
+  const release = budget.deferReconciliation();
+  try {
+    expect(() =>
+      reconcileCompiledValues(budget, [chain(MAX_DATA_DEPTH, "symbol")]),
+    ).toThrow(expect.objectContaining({ budget: "dataSize" }));
+  } finally {
+    release();
+  }
+});
+
+it.each([0, 140])(
+  "snapshots symbols before descendants and strings after prototype callbacks at depth %s",
+  (depth) => {
+    const events: string[] = [];
+    const first = Symbol("first"),
+      later = Symbol("later");
+    const table: Record<string | symbol, SandboxValue> = { text: "a" };
+    table[first] = createSandboxClosure({
+      call: () => undefined,
+      retainedValues: () => {
+        events.push("symbol");
+        table[later] = "longer";
+        table.text = "changed";
+        return [];
+      },
+    });
+    table[later] = "a";
+    const prototype = createSandboxClosure({
+      call: () => undefined,
+      retainedValues: () => {
+        events.push("prototype");
+        table.text = "from prototype";
+        return [];
+      },
+    });
+    setSandboxPrototype(table, prototype);
+    const root = wrap(table, depth);
+    const initial = measureSandboxData([root]);
+    expect(events).toEqual(["symbol", "prototype"]);
+    expect(measureSandboxData([root])).toBe(initial + 5);
+    expect(events).toEqual(["symbol", "prototype", "symbol", "prototype"]);
+  },
+);
+
+it.each([0, 140])(
+  "captures array elements before metadata callbacks at depth %s",
+  (depth) => {
+    const array: SandboxValue[] = ["a"];
+    addPrivateElement(
+      array,
+      { description: "mutate" },
+      {
+        kind: "field",
+        value: createSandboxClosure({
+          call: () => undefined,
+          retainedValues: () => {
+            array[0] = "longer";
+            return [];
+          },
+        }),
+      },
+    );
+    const root = wrap(array, depth);
+    const initial = measureSandboxData([root]);
+    expect(measureSandboxData([root])).toBe(initial + 5);
+  },
+);
+
+it("keeps private iteration live and captures newly added symbols afterward", () => {
+  const table: Record<symbol, SandboxValue> = {};
+  const key = Symbol("after");
+  const events: string[] = [];
+  let added = false;
+  addPrivateElement(
+    table,
+    { description: "first" },
+    {
+      kind: "field",
+      value: createSandboxClosure({
+        call: () => undefined,
+        retainedValues: () => {
+          events.push("first");
+          if (!added) {
+            added = true;
+            addPrivateElement(
+              table,
+              { description: "inserted" },
+              {
+                kind: "field",
+                value: createSandboxClosure({
+                  call: () => undefined,
+                  retainedValues: () => {
+                    events.push("inserted");
+                    return [];
+                  },
+                }),
+              },
+            );
+          }
+          table[key] = "changed";
+          return [];
+        },
+      }),
+    },
+  );
+  const root = wrap(table);
+  const initial = measureSandboxData([root]);
+  expect(events).toEqual(["first", "inserted"]);
+  expect(measureSandboxData([root])).toBe(initial);
+});
+
+it("preserves proxy symbol descriptor traps and closes suspended captures on failure", () => {
+  const failure = new Error("symbol descriptor");
+  const events: string[] = [];
+  const symbol = Symbol("leaf");
+  const table = new Proxy(
+    { [symbol]: "payload" },
+    {
+      ownKeys: (target) => {
+        events.push("keys");
+        return Reflect.ownKeys(target);
+      },
+      getOwnPropertyDescriptor: () => {
+        events.push("descriptor");
+        throw failure;
+      },
+    },
+  );
+  let root: SandboxValue = table;
+  for (const name of ["inner", "outer"]) {
+    const next = root;
+    root = createSandboxClosure({
+      call: () => undefined,
+      retainedValues: function* () {
+        events.push("open-" + name);
+        try {
+          yield next;
+        } finally {
+          events.push("close-" + name);
+        }
+      },
+    });
+  }
+  expect(() => measureSandboxData([wrap(root)])).toThrow(failure);
+  expect(events).toEqual([
+    "open-outer",
+    "open-inner",
+    "keys",
+    "descriptor",
+    "close-inner",
+    "close-outer",
+  ]);
+});
