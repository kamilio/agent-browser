		"check:html-form": "node dist/scripts/check-html-form.js",
		"check:safe-js": "node dist/scripts/check-safejs.js",
		"check:script-process": "node dist/scripts/check-script-process.js",
		"check:script-dom": "node dist/scripts/check-script-dom.js",
		"check:script-actions": "node dist/scripts/check-script-actions.js",
		"check:session-process": "node dist/scripts/check-session-process.js",
