		"check:locator-generation": "node dist/scripts/check-locator-generation.js",
		"check:css-box": "node dist/scripts/check-css-box.js",
		"check:block-width": "node dist/scripts/check-block-width.js",
		"check:formatting-tree": "node dist/scripts/check-formatting-tree.js",
		"check:formatting-resources": "node dist/scripts/check-formatting-resources.js",
		"check:bitmap-renderer": "node dist/scripts/check-bitmap-renderer.js",
		"check:text-layout": "node dist/scripts/check-text-layout.js",
		"check:text-resources": "node dist/scripts/check-text-resources.js",
		"check:document-layout": "node dist/scripts/check-document-layout.js",
		"check:document-resources": "node dist/scripts/check-document-resources.js",
		"check:css-paint": "node dist/scripts/check-css-paint.js",
		"check:background": "node dist/scripts/check-background.js",
		"check:paint-resources": "node dist/scripts/check-paint-resources.js",
		"check:capture-export": "node dist/scripts/check-capture-export.js",
		"check:capture-resources": "node dist/scripts/check-capture-resources.js",
		"check:png-comparison": "node dist/scripts/check-png-comparison.js",
