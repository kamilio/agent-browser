{
	"name": "@automations/browser-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": { "agent-browser": "dist/src/cli.js" },
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"exports": {
		".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
		"./node": {
			"types": "./dist/src/node-transport.d.ts",
			"import": "./dist/src/node-transport.js"
		},
		"./node-safe-js": {
			"types": "./dist/src/node-safejs.d.ts",
			"import": "./dist/src/node-safejs.js"
		},
		"./node-script-process": {
			"types": "./dist/src/node-script-process.d.ts",
			"import": "./dist/src/node-script-process.js"
		},
		"./node-session-process": {
			"types": "./dist/src/node-session-process.d.ts",
			"import": "./dist/src/node-session-process.js"
		},
		"./node-session-host": {
			"types": "./dist/src/node-session-host.d.ts",
			"import": "./dist/src/node-session-host.js"
		}
	},
	"scripts": {
		"check:node-relations": "node dist/scripts/check-node-relations.js",
