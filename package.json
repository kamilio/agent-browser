		"check:snapshot-search": "node dist/scripts/check-snapshot-search.js",
		"probe:nested-callbacks": "node dist/scripts/check-nested-callbacks.js",
		"check:query-resources": "node dist/scripts/check-query-resources.js",
		"test": "node ../../node_modules/vitest/vitest.mjs run src --maxWorkers=1",
		"typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"lint": "biome check src scripts"
	}
}
